<button
  id="consent-settings"
  type="button"
  class="text-muted dark:text-slate-400 hover:text-primary dark:hover:text-blue-400 transition-colors"
>
  Privacy and cookie settings
</button>
<script>
  import { resetAdConsent } from '../lib/ads/consent';

  const consentSettings = document.querySelector<HTMLButtonElement>('#consent-settings');
  consentSettings?.addEventListener('click', () => {
    // Local ad consent: clear the stored choice so the banner
    // reappears and the visitor can pick again.
    resetAdConsent();

    // Google Funding Choices CMP, once AdSense is actually configured.
    const googlefc = (window as typeof window & {
      googlefc?: { callbackQueue?: Array<unknown>; showRevocationMessage?: unknown };
    }).googlefc;
    if (googlefc?.callbackQueue && googlefc.showRevocationMessage) {
      googlefc.callbackQueue.push(googlefc.showRevocationMessage);
    }
  });
</script>
