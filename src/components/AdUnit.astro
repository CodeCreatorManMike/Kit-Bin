---
import { ADSENSE_AD_SLOT, ADSENSE_CMP_CONFIGURED, ADSENSE_CONFIGURED, ADSENSE_PUBLISHER_ID } from '../data/site-config';

interface Props {
  slot?: string;
}

const { slot = ADSENSE_AD_SLOT } = Astro.props;

const isConfigured = ADSENSE_CONFIGURED && ADSENSE_CMP_CONFIGURED && /^\d+$/.test(slot);
---

{isConfigured && (
  <div class="max-w-2xl mx-auto px-4 my-6">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_PUBLISHER_ID}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
    <script>
      ((window as unknown as { adsbygoogle: unknown[] }).adsbygoogle ||= []).push({});
    </script>
  </div>
)}
