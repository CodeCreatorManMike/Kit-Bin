---
import { KOFI_URL } from '../data/site-config';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href={KOFI_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center gap-1.5 rounded-full bg-red-500 hover:bg-red-600 text-white font-semibold shadow-sm transition-colors ${className}`}
>
  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 fill-white">
    <path d="M12 20.5s-7.5-4.6-10-9.3C.4 8.1 1.8 4.5 5.2 3.6c2-.5 4 .3 5.3 2 .1.1.3.1.4 0 1.3-1.7 3.3-2.5 5.3-2 3.4.9 4.8 4.5 3.2 7.6-2.5 4.7-10 9.3-10 9.3-.2.1-.3.1-.4 0z" />
  </svg>
  Donate
</a>
