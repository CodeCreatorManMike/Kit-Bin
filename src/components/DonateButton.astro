---
import { KOFI_URL } from '../data/site-config';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href={KOFI_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={`group inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-500 hover:to-fuchsia-500 active:scale-95 text-white font-semibold shadow-md shadow-rose-500/25 hover:shadow-lg hover:shadow-rose-500/35 hover:-translate-y-0.5 transition-all duration-200 ${className}`}
>
  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 fill-white transition-transform duration-200 group-hover:scale-125">
    <path d="M12 20.5s-7.5-4.6-10-9.3C.4 8.1 1.8 4.5 5.2 3.6c2-.5 4 .3 5.3 2 .1.1.3.1.4 0 1.3-1.7 3.3-2.5 5.3-2 3.4.9 4.8 4.5 3.2 7.6-2.5 4.7-10 9.3-10 9.3-.2.1-.3.1-.4 0z" />
  </svg>
  Donate
</a>
