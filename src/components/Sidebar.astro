---
import { categories } from '../data/tools';
import { categoryColors, categoryIconPaths } from '../data/toolIcons';
import DonateButton from './DonateButton.astro';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const categoryMeta = Object.fromEntries(
  Object.entries(categoryIconPaths)
    .filter(([slug]) => slug !== 'guides')
    .map(([slug, icon]) => [slug, { ...categoryColors[slug], icon }]),
);
---

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 bg-ink/40 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-200 lg:hidden"
></div>

<header
  class="lg:hidden fixed inset-x-0 top-0 z-20 flex items-center justify-between border-b border-border-soft dark:border-slate-800 bg-surface/95 backdrop-blur dark:bg-slate-950 px-4 py-2.5"
>
  <a href="/" class="flex items-center gap-2">
    <span class="inline-block h-8 w-8 shrink-0">
      <img src="/brand/mark.svg" alt="" class="h-8 w-8" />
    </span>
    <span class="font-semibold tracking-tight text-ink dark:text-slate-100">Kit-Bin</span>
  </a>
  <div class="flex items-center gap-2">
    <DonateButton class="text-xs px-3 py-1.5" />
    <button
      id="sidebar-open"
      type="button"
      aria-label="Open menu"
      class="rounded-lg p-2 text-muted dark:text-slate-300 hover:bg-app-bg dark:hover:bg-slate-900 active:scale-95 transition"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<div class="hidden lg:block fixed top-4 right-4 z-50">
  <DonateButton class="text-xs px-3.5 py-2 shadow-md" />
</div>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-72 sm:w-64 shrink-0 border-r border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-950 flex flex-col h-screen -translate-x-full transition-transform duration-200 ease-out lg:translate-x-0 lg:sticky lg:top-0 lg:z-auto"
>
  <div class="flex items-center justify-between px-5 py-5">
    <a href="/" class="flex items-center gap-2">
      <span class="inline-block h-9 w-9 shrink-0">
        <img src="/brand/mark.svg" alt="" class="h-9 w-9" />
      </span>
      <span class="leading-tight">
        <span class="block font-semibold tracking-tight text-ink dark:text-slate-100">Kit-Bin</span>
        <span class="block text-xs text-muted dark:text-slate-400">All-in-one file toolkit</span>
      </span>
    </a>
    <button
      id="sidebar-close"
      type="button"
      aria-label="Close menu"
      class="lg:hidden rounded-lg p-1.5 text-muted dark:text-slate-400 hover:bg-app-bg dark:hover:bg-slate-900 active:scale-95 transition"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 space-y-6 pb-4">
    <div>
      <a
        href="/"
        class={`flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
          isHome
            ? 'bg-primary-tint text-primary dark:bg-blue-950/40 dark:text-blue-400'
            : 'text-ink hover:bg-app-bg dark:text-slate-300 dark:hover:bg-slate-900'
        }`}
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M4 11l8-7 8 7M6 10v10h12V10" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Home
      </a>
    </div>

    <div>
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-muted/80 dark:text-slate-500">Categories</p>
      <div class="mt-2 space-y-0.5">
        {categories.map((c) => {
          const meta = categoryMeta[c.slug];
          const active = currentPath.startsWith(`/${c.slug}/`);
          return (
            <a
              href={`/${c.slug}/`}
              class={`flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                active
                  ? 'bg-primary-tint text-primary dark:bg-blue-950/40 dark:text-blue-400'
                  : 'text-ink hover:bg-app-bg dark:text-slate-300 dark:hover:bg-slate-900'
              }`}
            >
              <span class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-md ${meta.bg} ${meta.text}`}>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d={meta.icon} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              {c.name}
            </a>
          );
        })}
      </div>
    </div>

    <div>
      <a
        href="/guides/"
        class={`flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
          currentPath.startsWith('/guides/')
            ? 'bg-primary-tint text-primary dark:bg-blue-950/40 dark:text-blue-400'
            : 'text-ink hover:bg-app-bg dark:text-slate-300 dark:hover:bg-slate-900'
        }`}
      >
        <span class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-md ${categoryColors.guides.bg} ${categoryColors.guides.text}`}>
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M4 5c2-1 6-1 8 0v14c-2-1-6-1-8 0V5zM20 5c-2-1-6-1-8 0v14c2-1 6-1 8 0V5z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        Guides
      </a>
    </div>

    <div>
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-muted/80 dark:text-slate-500">Favorites</p>
      <div id="sidebar-favorites" class="mt-2 space-y-0.5">
        <p class="px-3 text-xs text-muted dark:text-slate-500" data-empty-state>No favorites yet. Star a tool to pin it here.</p>
      </div>
    </div>
  </nav>

  <div class="px-3 pb-3">
    <div class="rounded-2xl bg-primary-tint dark:bg-slate-900 border border-primary/10 dark:border-slate-800 p-4 text-center">
      <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-surface dark:bg-slate-800 shadow-sm">
        <svg viewBox="0 0 24 24" class="h-5.5 w-5.5 text-primary dark:text-blue-400" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" />
          <path d="M9.3 12l1.9 1.9 3.5-3.8" />
        </svg>
      </span>
      <p class="mt-2 text-sm font-semibold text-ink dark:text-slate-200">Files Stay Private</p>
      <p class="mt-1 text-xs text-muted dark:text-slate-400">Files are processed on your device and are never sent to Kit-Bin.</p>
      <a href="/privacy" class="mt-1 inline-block text-xs font-medium text-primary dark:text-blue-400 hover:underline">Learn more →</a>
    </div>
  </div>

  <div class="border-t border-border-soft dark:border-slate-800 px-3 py-3 flex items-center justify-between">
    <button
      id="theme-toggle"
      type="button"
      class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-muted hover:bg-app-bg dark:text-slate-300 dark:hover:bg-slate-900 transition-colors"
    >
      <svg id="theme-icon-light" viewBox="0 0 24 24" class="h-4 w-4 hidden" fill="none" stroke="currentColor" stroke-width="1.75">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
      </svg>
      <svg id="theme-icon-dark" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M20 14.5A8 8 0 119.5 4a6.5 6.5 0 0010.5 10.5z" stroke-linejoin="round" />
      </svg>
      <span id="theme-label">Dark</span>
    </button>
    <span class="text-xs text-muted/70 dark:text-slate-500">Kit-Bin v1.0.0</span>
  </div>

  <div class="px-3 pb-3 flex justify-center">
    <DonateButton class="text-[11px] px-2.5 py-1" />
  </div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar')!;
  const backdrop = document.getElementById('sidebar-backdrop')!;
  const openBtn = document.getElementById('sidebar-open')!;
  const closeBtn = document.getElementById('sidebar-close')!;

  function openSidebar() {
    sidebar.classList.remove('-translate-x-full');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
  }
  function closeSidebar() {
    sidebar.classList.add('-translate-x-full');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
  }

  openBtn.addEventListener('click', openSidebar);
  closeBtn.addEventListener('click', closeSidebar);
  backdrop.addEventListener('click', closeSidebar);
  sidebar.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeSidebar));
</script>

<script>
  const KEY = 'kitbin:theme';
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const label = document.getElementById('theme-label')!;
  const lightIcon = document.getElementById('theme-icon-light')!;
  const darkIcon = document.getElementById('theme-icon-dark')!;

  function reflect() {
    const isDark = root.classList.contains('dark');
    label.textContent = isDark ? 'Dark' : 'Light';
    lightIcon.classList.toggle('hidden', isDark);
    darkIcon.classList.toggle('hidden', !isDark);
  }

  btn.addEventListener('click', () => {
    const next = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.toggle('dark', next === 'dark');
    localStorage.setItem(KEY, next);
    reflect();
  });

  reflect();
</script>

<script>
  import { tools } from '../data/tools';
  import { getFavorites, FAVORITES_CHANGED_EVENT } from '../lib/favorites';
  import { toolIconHtml } from '../lib/toolIconHtml';

  const container = document.getElementById('sidebar-favorites')!;

  function render() {
    const favSlugs = getFavorites();
    const favTools = favSlugs.map((slug) => tools.find((t) => t.slug === slug)).filter((t): t is NonNullable<typeof t> => !!t);

    container.innerHTML = '';
    if (favTools.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'px-3 text-xs text-muted dark:text-slate-500';
      empty.textContent = 'No favorites yet. Star a tool to pin it here.';
      container.appendChild(empty);
      return;
    }

    for (const t of favTools) {
      const a = document.createElement('a');
      a.href = t.slug;
      a.className =
        'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-ink hover:bg-app-bg dark:text-slate-300 dark:hover:bg-slate-900 transition-colors';
      const span = document.createElement('span');
      span.className = 'truncate';
      span.textContent = t.name;
      a.insertAdjacentHTML('afterbegin', toolIconHtml(t.slug, t.category));
      a.appendChild(span);
      container.appendChild(a);
    }
  }

  window.addEventListener('storage', (e) => {
    if (e.key === 'kitbin:favorites') render();
  });
  window.addEventListener(FAVORITES_CHANGED_EVENT, render);

  render();
</script>
