---
import { categories } from '../data/tools';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const categoryMeta: Record<string, { bg: string; text: string; icon: string }> = {
  pdf: {
    bg: 'bg-red-50 dark:bg-red-950/40',
    text: 'text-red-600 dark:text-red-400',
    icon: 'M7 3h7l5 5v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1zM14 3v5h5',
  },
  image: {
    bg: 'bg-emerald-50 dark:bg-emerald-950/40',
    text: 'text-emerald-600 dark:text-emerald-400',
    icon: 'M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zM8 11a2 2 0 100-4 2 2 0 000 4zM3 16l5-5 4 4 3-3 6 6',
  },
  audio: {
    bg: 'bg-amber-50 dark:bg-amber-950/40',
    text: 'text-amber-600 dark:text-amber-400',
    icon: 'M9 18V5l11-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zM20 16a3 3 0 11-6 0 3 3 0 016 0z',
  },
  video: {
    bg: 'bg-violet-50 dark:bg-violet-950/40',
    text: 'text-violet-600 dark:text-violet-400',
    icon: 'M4 6a1 1 0 011-1h10a1 1 0 011 1v12a1 1 0 01-1 1H5a1 1 0 01-1-1V6zM16 10l5-3v10l-5-3',
  },
  data: {
    bg: 'bg-cyan-50 dark:bg-cyan-950/40',
    text: 'text-cyan-600 dark:text-cyan-400',
    icon: 'M4 5h16v4H4V5zM4 11h7v8H4v-8zM13 11h7v8h-7v-8z',
  },
};
---

<div
  id="sidebar-backdrop"
  class="hidden fixed inset-0 z-30 bg-black/40 lg:hidden"
></div>

<header
  class="lg:hidden fixed inset-x-0 top-0 z-20 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-4 py-3"
>
  <a href="/" class="flex items-center gap-2">
    <span class="inline-block h-8 w-8 overflow-hidden rounded-lg shrink-0">
      <img src="/brand/logo-full.png" alt="" class="h-8 w-auto max-w-none -translate-x-0.5" />
    </span>
    <span class="font-semibold text-slate-900 dark:text-slate-100">Kit-Bin</span>
  </a>
  <button
    id="sidebar-open"
    type="button"
    aria-label="Open menu"
    class="rounded-lg p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
    </svg>
  </button>
</header>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-64 shrink-0 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 flex flex-col h-screen -translate-x-full transition-transform duration-200 ease-in-out lg:translate-x-0 lg:sticky lg:top-0 lg:z-auto"
>
  <div class="flex items-center justify-between px-5 py-5">
    <a href="/" class="flex items-center gap-2">
      <span class="inline-block h-9 w-9 overflow-hidden rounded-lg shrink-0">
        <img src="/brand/logo-full.png" alt="" class="h-9 w-auto max-w-none -translate-x-0.5" />
      </span>
      <span class="leading-tight">
        <span class="block font-semibold text-slate-900 dark:text-slate-100">Kit-Bin</span>
        <span class="block text-xs text-slate-500 dark:text-slate-400">All-in-one file toolkit</span>
      </span>
    </a>
    <button
      id="sidebar-close"
      type="button"
      aria-label="Close menu"
      class="lg:hidden rounded-lg p-1.5 text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 space-y-6 pb-4">
    <div>
      <a
        href="/"
        class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium ${
          isHome
            ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-400'
            : 'text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-900'
        }`}
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 11l8-7 8 7M6 10v10h12V10" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Home
      </a>
    </div>

    <div>
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Categories</p>
      <div class="mt-2 space-y-1">
        {categories.map((c) => {
          const meta = categoryMeta[c.slug];
          const active = currentPath.startsWith(`/${c.slug}/`);
          return (
            <a
              href={`/${c.slug}/`}
              class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium ${
                active
                  ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-400'
                  : 'text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-900'
              }`}
            >
              <span class={`flex h-6 w-6 items-center justify-center rounded-md ${meta.bg} ${meta.text}`}>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
                  <path d={meta.icon} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              {c.name}
            </a>
          );
        })}
      </div>
    </div>

    <div>
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Favorites</p>
      <div id="sidebar-favorites" class="mt-2 space-y-1">
        <p class="px-3 text-xs text-slate-400 dark:text-slate-500" data-empty-state>No favorites yet — star a tool to pin it here.</p>
      </div>
    </div>
  </nav>

  <div class="px-3 pb-3">
    <div class="rounded-xl bg-slate-50 dark:bg-slate-900 p-4 text-center">
      <img src="/illustrations/privacy-shield.png" alt="" class="mx-auto h-14 w-14 object-contain" />
      <p class="mt-2 text-sm font-semibold text-slate-800 dark:text-slate-200">100% Private</p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Your files never leave your device.</p>
      <a href="/privacy" class="mt-1 inline-block text-xs text-blue-600 dark:text-blue-400 hover:underline">Learn more →</a>
    </div>
  </div>

  <div class="border-t border-slate-200 dark:border-slate-800 px-3 py-3 flex items-center justify-between">
    <button
      id="theme-toggle"
      type="button"
      class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-900"
    >
      <svg id="theme-icon-light" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
      </svg>
      <svg id="theme-icon-dark" viewBox="0 0 24 24" class="h-4 w-4 hidden" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 14.5A8 8 0 119.5 4a6.5 6.5 0 0010.5 10.5z" stroke-linejoin="round" />
      </svg>
      <span id="theme-label">Light</span>
    </button>
    <span class="text-xs text-slate-400 dark:text-slate-500">Kit-Bin v1.0.0</span>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar')!;
  const backdrop = document.getElementById('sidebar-backdrop')!;
  const openBtn = document.getElementById('sidebar-open')!;
  const closeBtn = document.getElementById('sidebar-close')!;

  function openSidebar() {
    sidebar.classList.remove('-translate-x-full');
    backdrop.classList.remove('hidden');
  }
  function closeSidebar() {
    sidebar.classList.add('-translate-x-full');
    backdrop.classList.add('hidden');
  }

  openBtn.addEventListener('click', openSidebar);
  closeBtn.addEventListener('click', closeSidebar);
  backdrop.addEventListener('click', closeSidebar);
  sidebar.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeSidebar));
</script>

<script>
  const KEY = 'kitbin:theme';
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const label = document.getElementById('theme-label')!;
  const lightIcon = document.getElementById('theme-icon-light')!;
  const darkIcon = document.getElementById('theme-icon-dark')!;

  function reflect() {
    const isDark = root.classList.contains('dark');
    label.textContent = isDark ? 'Dark' : 'Light';
    lightIcon.classList.toggle('hidden', isDark);
    darkIcon.classList.toggle('hidden', !isDark);
  }

  btn.addEventListener('click', () => {
    const next = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.toggle('dark', next === 'dark');
    localStorage.setItem(KEY, next);
    reflect();
  });

  reflect();
</script>

<script>
  import { tools } from '../data/tools';
  import { getFavorites, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

  const container = document.getElementById('sidebar-favorites')!;

  function render() {
    const favSlugs = getFavorites();
    const favTools = favSlugs.map((slug) => tools.find((t) => t.slug === slug)).filter((t): t is NonNullable<typeof t> => !!t);

    container.innerHTML = '';
    if (favTools.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'px-3 text-xs text-slate-400 dark:text-slate-500';
      empty.textContent = 'No favorites yet — star a tool to pin it here.';
      container.appendChild(empty);
      return;
    }

    for (const t of favTools) {
      const a = document.createElement('a');
      a.href = t.slug;
      a.className =
        'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-900';
      const icon = document.createElement('img');
      icon.src = t.icon;
      icon.alt = '';
      icon.className = 'h-5 w-5 object-contain';
      const span = document.createElement('span');
      span.className = 'truncate';
      span.textContent = t.name;
      a.appendChild(icon);
      a.appendChild(span);
      container.appendChild(a);
    }
  }

  window.addEventListener('storage', (e) => {
    if (e.key === 'kitbin:favorites') render();
  });
  window.addEventListener(FAVORITES_CHANGED_EVENT, render);

  render();
</script>
