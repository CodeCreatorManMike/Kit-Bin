---
interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin + '/' },
    { '@type': 'ListItem', position: 2, name: categoryName, item: url },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
