---
import { KOFI_URL } from '../data/site-config';
import ConsentSettingsLink from './ConsentSettingsLink.astro';

const links = [
  { href: '/guides/', label: 'Guides' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms' },
  { href: KOFI_URL, label: 'Support this site' },
];
---

<footer class="border-t border-border-soft dark:border-slate-800 mt-12">
  <div class="max-w-5xl mx-auto px-6 py-8 text-sm text-muted dark:text-slate-400 space-y-4">
    <p>Kit-Bin, private browser-based file tools. Every tool runs entirely in your browser, and files are never uploaded.</p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      {links.map((l) => (
        <a href={l.href} class="text-muted dark:text-slate-400 hover:text-primary dark:hover:text-blue-400 transition-colors">{l.label}</a>
      ))}
      <ConsentSettingsLink />
    </nav>

    <div class="flex flex-wrap items-center gap-3">
      <a
        href="https://www.producthunt.com/products/kit-bin?embed=true&utm_source=embed&utm_medium=post_embed"
        target="_blank"
        rel="noopener"
        class="glass-panel group flex max-w-md items-center gap-3 rounded-xl p-3 no-underline transition-all duration-150 hover:border-primary/25 hover:shadow-[0_6px_16px_rgba(16,24,47,0.08)]"
      >
        <img
          alt="Kit-Bin"
          src="https://ph-files.imgix.net/c2d82ef9-e0ce-4269-9917-6445b9fd9c7b.png?auto=compress,format&codec=mozjpeg&cs=strip&fit=crop&h=80&w=80"
          width="48"
          height="48"
          loading="lazy"
          class="h-12 w-12 shrink-0 rounded-lg object-cover"
        />
        <span class="min-w-0 flex-1">
          <span class="block truncate font-semibold text-ink dark:text-slate-100">Kit-Bin</span>
          <span class="mt-0.5 line-clamp-2 text-xs leading-snug text-muted dark:text-slate-400">Free file tools that never leave your browser</span>
        </span>
        <span class="btn-glow shrink-0 whitespace-nowrap rounded-lg bg-[#ff6154] px-3 py-2 text-xs font-semibold text-white">
          View on Product Hunt →
        </span>
      </a>

      <a
        href="https://launchbuff.com/products/kit-bin-913vgo"
        target="_blank"
        rel="noopener noreferrer"
        title="Featured on LaunchBuff"
        class="inline-flex shrink-0"
      >
        <img
          src="https://launchbuff.com/badge-featured-light.svg"
          alt="Featured on LaunchBuff"
          width="256"
          height="80"
          loading="lazy"
          class="block h-auto w-64 dark:hidden"
        />
        <img
          src="https://launchbuff.com/badge-featured-dark.svg"
          alt="Featured on LaunchBuff"
          width="256"
          height="80"
          loading="lazy"
          class="hidden h-auto w-64 dark:block"
        />
      </a>
    </div>
  </div>
</footer>
