---
import { KOFI_URL } from '../data/site-config';

const links = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms' },
  { href: KOFI_URL, label: 'Support this site' },
];
---

<footer class="border-t border-slate-200 mt-12">
  <div class="max-w-5xl mx-auto px-4 py-8 text-sm text-slate-500 space-y-4">
    <p>Every tool runs entirely in your browser. Files are never uploaded.</p>
    <nav class="flex flex-wrap gap-4">
      {links.map((l) => (
        <a href={l.href} class="text-slate-500 hover:text-slate-700">{l.label}</a>
      ))}
    </nav>
  </div>
</footer>
