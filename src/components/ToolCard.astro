---
import type { Tool } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
import { categoryColors } from '../data/toolIcons';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const accent = (categoryColors[tool.category] ?? categoryColors.pdf).dot;
---

<a
  href={tool.slug}
  data-tool-card
  data-slug={tool.slug}
  data-name={tool.name.toLowerCase()}
  data-description={tool.description.toLowerCase()}
  data-aliases={(tool.aliases ?? []).join(' ').toLowerCase()}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-border-soft dark:border-slate-800 p-3.5 bg-surface dark:bg-slate-900 shadow-[0_1px_2px_rgba(16,24,47,0.04)] transition-all duration-150 hover:border-primary/25 hover:shadow-[0_6px_16px_rgba(16,24,47,0.08)] hover:-translate-y-0.5 active:translate-y-0 active:shadow-[0_1px_2px_rgba(16,24,47,0.04)] active:scale-[0.98]"
>
  <span class={`absolute inset-x-0 top-0 h-0.5 scale-x-0 ${accent} transition-transform duration-200 origin-left group-hover:scale-x-100`} aria-hidden="true"></span>
  <div class="flex items-start justify-between">
    <div class="transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3">
      <ToolIcon slug={tool.slug} category={tool.category} size="sm" />
    </div>
    <button
      type="button"
      data-favorite-toggle
      aria-label="Toggle favorite"
      class="rounded-md p-1 -m-1 text-slate-300 dark:text-slate-600 hover:text-amber-400 hover:scale-110 active:scale-90 data-[active=true]:text-amber-400 transition-all duration-150"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
        <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.6l-5.9 3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5z" />
      </svg>
    </button>
  </div>
  <p class="mt-2.5 text-sm font-semibold text-ink dark:text-slate-100">{tool.name}</p>
  <p class="mt-0.5 text-xs leading-snug text-muted dark:text-slate-400 line-clamp-2">{tool.description}</p>
  <svg
    viewBox="0 0 24 24"
    class="mt-2 h-3.5 w-3.5 self-end text-primary opacity-0 -translate-x-1 transition-all duration-150 group-hover:opacity-100 group-hover:translate-x-0"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<script>
  import { isFavorite, toggleFavorite, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

  function syncStars() {
    document.querySelectorAll<HTMLButtonElement>('[data-favorite-toggle]').forEach((btn) => {
      const card = btn.closest<HTMLElement>('[data-tool-card]');
      const slug = card?.dataset.slug;
      if (!slug) return;
      btn.dataset.active = String(isFavorite(slug));
    });
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-favorite-toggle]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const card = btn.closest<HTMLElement>('[data-tool-card]');
    const slug = card?.dataset.slug;
    if (!slug) return;
    const active = toggleFavorite(slug);
    btn.dataset.active = String(active);
  });

  window.addEventListener(FAVORITES_CHANGED_EVENT, syncStars);
  syncStars();
</script>
