---
import type { Tool } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
import { categoryColors } from '../data/toolIcons';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const c = categoryColors[tool.category] ?? categoryColors.pdf;
---

<a
  href={tool.slug}
  data-tool-card
  data-slug={tool.slug}
  data-name={tool.name.toLowerCase()}
  data-description={tool.description.toLowerCase()}
  data-aliases={(tool.aliases ?? []).join(' ').toLowerCase()}
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-soft dark:border-slate-800 p-4 bg-surface dark:bg-slate-900 shadow-[0_1px_2px_rgba(16,24,47,0.05)] transition-all duration-200 hover:border-primary/30 hover:shadow-[0_10px_28px_-8px_rgba(16,24,47,0.22)] hover:-translate-y-1 active:translate-y-0 active:scale-[0.985]"
>
  <!-- Category wash: invisible at rest, blooms from the icon corner on hover. -->
  <span
    class={`pointer-events-none absolute -left-10 -top-10 h-28 w-28 rounded-full ${c.gradient} opacity-0 blur-2xl transition-opacity duration-300 group-hover:opacity-20`}
    aria-hidden="true"></span>

  <div class="relative flex items-start justify-between gap-2">
    <div class="transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:scale-105">
      <ToolIcon slug={tool.slug} category={tool.category} size="sm" />
    </div>
    <button
      type="button"
      data-favorite-toggle
      aria-label="Toggle favorite"
      class="-m-1.5 rounded-lg p-1.5 text-slate-300 dark:text-slate-600 hover:text-amber-400 hover:scale-110 active:scale-90 data-[active=true]:text-amber-400 transition-all duration-150"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
        <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.6l-5.9 3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5z" />
      </svg>
    </button>
  </div>

  <p class="relative mt-3 text-[0.9375rem] font-semibold leading-tight text-ink dark:text-slate-100">{tool.name}</p>
  <p class="relative mt-1 text-xs leading-relaxed text-muted dark:text-slate-400">{tool.description}</p>

  <!-- Pinned to the bottom so every card in a row ends on the same line. Hidden
       on touch widths, where hover never fires and it would only reserve dead
       space under every card. -->
  <span
    class={`relative mt-auto hidden sm:flex items-center gap-1 pt-3 text-xs font-semibold ${c.text} opacity-0 translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-y-0`}
  >
    Open
    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.25">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<script>
  import { isFavorite, toggleFavorite, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

  function syncStars() {
    document.querySelectorAll<HTMLButtonElement>('[data-favorite-toggle]').forEach((btn) => {
      const card = btn.closest<HTMLElement>('[data-tool-card]');
      const slug = card?.dataset.slug;
      if (!slug) return;
      btn.dataset.active = String(isFavorite(slug));
    });
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-favorite-toggle]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const card = btn.closest<HTMLElement>('[data-tool-card]');
    const slug = card?.dataset.slug;
    if (!slug) return;
    const active = toggleFavorite(slug);
    btn.dataset.active = String(active);
  });

  window.addEventListener(FAVORITES_CHANGED_EVENT, syncStars);
  syncStars();
</script>
