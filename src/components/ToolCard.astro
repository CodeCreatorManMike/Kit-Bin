---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<a
  href={tool.slug}
  data-tool-card
  data-slug={tool.slug}
  data-name={tool.name.toLowerCase()}
  data-description={tool.description.toLowerCase()}
  class="group relative block rounded-xl border border-slate-200 dark:border-slate-800 p-4 hover:border-slate-400 dark:hover:border-slate-600 bg-white dark:bg-slate-900"
>
  <button
    type="button"
    data-favorite-toggle
    aria-label="Toggle favorite"
    class="absolute right-3 top-3 text-slate-300 dark:text-slate-600 hover:text-amber-400 data-[active=true]:text-amber-400"
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
      <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.6l-5.9 3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5z" />
    </svg>
  </button>
  <span class="inline-flex rounded-lg ring-1 ring-slate-100 dark:ring-slate-700 p-1">
    <img src={tool.icon} alt="" class="h-8 w-8 object-contain rounded-md" />
  </span>
  <p class="mt-2 font-medium text-slate-900 dark:text-slate-100 pr-6">{tool.name}</p>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{tool.description}</p>
</a>

<script>
  import { isFavorite, toggleFavorite, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

  function syncStars() {
    document.querySelectorAll<HTMLButtonElement>('[data-favorite-toggle]').forEach((btn) => {
      const card = btn.closest<HTMLElement>('[data-tool-card]');
      const slug = card?.dataset.slug;
      if (!slug) return;
      btn.dataset.active = String(isFavorite(slug));
    });
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-favorite-toggle]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const card = btn.closest<HTMLElement>('[data-tool-card]');
    const slug = card?.dataset.slug;
    if (!slug) return;
    const active = toggleFavorite(slug);
    btn.dataset.active = String(active);
  });

  window.addEventListener(FAVORITES_CHANGED_EVENT, syncStars);
  syncStars();
</script>
