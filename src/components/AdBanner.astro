---
/** Reusable HilltopAds banner placement. Renders hidden until consent is
 * granted, so a visitor who hasn't consented sees no gap and no request
 * ever fires.
 *
 * `placement` is a stable string used only for the accessible label and the
 * iframe title (there is no per-placement analytics call, since Kit-Bin
 * doesn't run analytics), e.g. "homepage-directory", "pdf-category",
 * "tool-page:pdf-merge".
 *
 * `variant` is kept for call-site compatibility with the old multi-size
 * Adsterra setup, but only one creative size was issued for the current
 * HilltopAds banner zone (300x250), so every variant renders that same box,
 * centered in its container, on both desktop and mobile. */
interface Props {
  placement: string;
  variant?: 'leaderboard' | 'sidebar' | 'auto';
  class?: string;
}

const { placement, variant = 'auto', class: className = '' } = Astro.props;

const maxWidth = 'max-w-[300px]';
const minHeight = 'min-h-[250px]';
---

<div
  class={`ad-slot mx-auto text-center ${maxWidth} ${className}`}
  data-ad-placement={placement}
  data-ad-variant={variant}
  role="complementary"
  aria-label="Advertisement"
  hidden
>
  <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-widest text-muted/70 dark:text-slate-500">
    Advertisement
  </p>
  <div
    data-ad-frame
    class={`mx-auto flex ${minHeight} w-full ${maxWidth} items-center justify-center overflow-hidden rounded-xl border border-border-soft/70 dark:border-slate-800/70 bg-app-bg/40 dark:bg-slate-900/30`}
  >
  </div>
  <p class="mt-1.5 text-[11px] text-muted/70 dark:text-slate-500">Ads help keep Kit-Bin free.</p>
</div>

<script>
  import { attachAdSlot } from '../lib/ads/bannerAd';
  import type { AdVariant } from '../lib/ads/bannerAd';

  const slots = document.querySelectorAll<HTMLElement>('[data-ad-placement]:not([data-ad-bound])');
  slots.forEach((el) => {
    el.dataset.adBound = 'true';
    const variant = (el.dataset.adVariant as AdVariant | undefined) ?? 'auto';
    attachAdSlot(el, el.dataset.adPlacement ?? 'unknown', { lazy: true, variant });
  });
</script>
