  description="The difference between peak volume and perceived loudness (LUFS), why turning the volume up doesn't fix a quiet-sounding recording, and what normalization actually does."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <article class="max-w-2xl mx-auto px-4 pt-10 pb-16 text-slate-700 dark:text-slate-300 space-y-4">
