---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { guides, type Guide } from '../../data/guides';
import { categories } from '../../data/tools';
import { categoryColors } from '../../data/toolIcons';

// Group every published guide by the tool category its subject matter
// belongs to, so the hub reads as topic sections with a path back to the
// matching tool hub, instead of one flat chronological list. 'general'
// guides (trust/safety, not tied to one file type) render first, unlabeled
// by a tool-category link since there's no single hub to point back to.
const categoryOrder = ['general', ...categories.map((c) => c.slug)] as const;
const groups = categoryOrder
  .map((slug) => ({
    slug,
    name: slug === 'general' ? 'General' : categories.find((c) => c.slug === slug)!.name,
    guides: guides.filter((g) => g.category === slug),
  }))
  .filter((group) => group.guides.length > 0);

// Cross-category topical clusters: comparison guides and troubleshooting
// guides each read as their own coherent group regardless of which tool
// category they're filed under, so they get their own linkable section on
// top of (not instead of) the category groups above. A guide can appear in
// both its category group and here — that's intentional, it's the same
// content reachable from two different topical paths.
const comparisonGuides = guides.filter((g) => g.slug.includes('-vs-'));
const troubleshootingGuides = guides.filter((g) => g.slug.includes('/why-'));
---

<Layout
  title="Guides & Explainers | Kit-Bin"
  description="Plain-language explanations of the file formats and mechanics behind Kit-Bin's tools, why files behave the way they do, and what actually happens when you convert them."
>
  <div class="max-w-5xl mx-auto px-6 pt-10 pb-4">
    <div class="flex items-center gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-400 to-violet-400 text-white shadow-lg shadow-black/10">
        <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M4 5c2-1 6-1 8 0v14c-2-1-6-1-8 0V5zM20 5c-2-1-6-1-8 0v14c2-1 6-1 8 0V5z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-slate-100">Guides</h1>
    </div>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Short, specific explanations of the file formats and mechanics behind the tools on this
      site, not generic "how to use a computer" content, but the actual reasons files behave
      the way they do.
    </p>
  </div>

  <div class="max-w-5xl mx-auto px-6 pb-16 space-y-12">
    {[
      { id: 'comparisons', name: 'Comparisons', list: comparisonGuides },
      { id: 'troubleshooting', name: 'Troubleshooting', list: troubleshootingGuides },
    ].map((section) => (
      <div id={section.id}>
        <div class="mb-4 flex items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full bg-app-bg dark:bg-slate-900 text-muted dark:text-slate-400 ring-1 ring-inset ring-border-soft dark:ring-slate-800 px-3 py-1 text-xs font-bold uppercase tracking-wide">
            {section.name}
          </span>
          <span class="h-px flex-1 bg-border-soft dark:bg-slate-800" aria-hidden="true"></span>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {section.list.map((g: Guide) => (
            <a
              href={g.slug}
              class="glass-panel group flex gap-3 rounded-xl p-4 transition-all duration-150 hover:border-primary/25 hover:shadow-[0_6px_16px_rgba(16,24,47,0.08)] hover:-translate-y-0.5"
            >
              <div class="shrink-0 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3">
                <ToolIcon slug={g.slug} category="guides" />
              </div>
              <span>
                <span class="block font-semibold text-ink dark:text-slate-100">{g.cardTitle}</span>
                <span class="mt-1 block text-sm text-muted dark:text-slate-400">{g.description}</span>
                <span class="mt-2 inline-block text-sm font-medium text-primary dark:text-indigo-400 group-hover:underline">
                  Read the guide →
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}

    {groups.map((group) => {
      const cc = group.slug === 'general' ? null : categoryColors[group.slug];
      return (
        <div>
          <div class="mb-4 flex items-center gap-3">
            {cc ? (
              <span
                class={`inline-flex items-center gap-2 rounded-full ${cc.tile} ${cc.text} ring-1 ring-inset ${cc.ring} px-3 py-1 text-xs font-bold uppercase tracking-wide`}
              >
                {group.name}
              </span>
            ) : (
              <span class="inline-flex items-center gap-2 rounded-full bg-app-bg dark:bg-slate-900 text-muted dark:text-slate-400 ring-1 ring-inset ring-border-soft dark:ring-slate-800 px-3 py-1 text-xs font-bold uppercase tracking-wide">
                {group.name}
              </span>
            )}
            <span class="h-px flex-1 bg-border-soft dark:bg-slate-800" aria-hidden="true"></span>
            {group.slug !== 'general' && (
              <a
                href={`/${group.slug}/`}
                class={`shrink-0 text-xs font-semibold ${cc?.text ?? 'text-primary dark:text-blue-400'} hover:underline`}
              >
                Browse {group.name} →
              </a>
            )}
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {group.guides.map((g: Guide) => (
              <a
                href={g.slug}
                class="glass-panel group flex gap-3 rounded-xl p-4 transition-all duration-150 hover:border-primary/25 hover:shadow-[0_6px_16px_rgba(16,24,47,0.08)] hover:-translate-y-0.5"
              >
                <div class="shrink-0 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3">
                  <ToolIcon slug={g.slug} category="guides" />
                </div>
                <span>
                  <span class="block font-semibold text-ink dark:text-slate-100">{g.cardTitle}</span>
                  <span class="mt-1 block text-sm text-muted dark:text-slate-400">{g.description}</span>
                  <span class="mt-2 inline-block text-sm font-medium text-primary dark:text-indigo-400 group-hover:underline">
                    Read the guide →
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</Layout>
