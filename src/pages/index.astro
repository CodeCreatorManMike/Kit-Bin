---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolIcon from '../components/ToolIcon.astro';
import ComplianceIcon from '../components/ComplianceIcon.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { tools, categories } from '../data/tools';
import { guides } from '../data/guides';
import { categoryColors, categoryIconPaths } from '../data/toolIcons';
import { frameworks } from '../data/compliance';
import { siteFaqs } from '../data/faqs';

const popularSlugs = ['/pdf/merge', '/pdf/split', '/pdf/compress', '/image/heic-to-jpg'];
const popularTools = popularSlugs.map((slug) => tools.find((t) => t.slug === slug)!).filter(Boolean);

const categoryBlurbs: Record<string, string> = {
  pdf: 'Merge, split, compress, rotate, watermark, convert, and rearrange PDF files.',
  image: 'Convert HEIC, WebP, PNG, and SVG files, or resize, crop, and compress images.',
  audio: 'Convert, trim, join, and normalize MP3 and WAV audio.',
  video: 'Compress, trim, mute, convert, and extract audio from video files.',
  data: 'Convert and clean CSV, JSON, and Excel-compatible data.',
};

const categoryGradients: Record<string, string> = {
  pdf: 'from-red-500/10 via-red-400/5',
  image: 'from-emerald-500/10 via-emerald-400/5',
  audio: 'from-amber-500/10 via-amber-400/5',
  video: 'from-violet-500/10 via-violet-400/5',
  data: 'from-cyan-500/10 via-cyan-400/5',
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Kit-Bin',
      alternateName: 'Kit-Bin, Private Browser-Based File Tools',
      url: 'https://kit-bin.com/',
      logo: 'https://kit-bin.com/brand/mark.svg',
      description: 'Kit-Bin builds free, private, browser-based file tools for PDF, images, audio, video, and data. No uploads, no accounts.',
    },
    {
      '@type': 'WebSite',
      name: 'Kit-Bin',
      url: 'https://kit-bin.com/',
      description: 'Free private file tools for PDF, images, audio, video, and data, processed entirely in your browser and never uploaded.',
    },
  ],
};
---

<Layout
  title="Free Online File Tools for PDF, Images, Audio, Video and Data | Kit-Bin"
  description="Merge PDFs, convert images, trim audio, compress video, and clean CSV files with free browser-based tools. No software installation, and your files never leave your device."
>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />

  <div class="relative overflow-hidden">
    <div
      class="animate-blob pointer-events-none absolute -top-24 -left-16 h-64 w-64 rounded-full bg-gradient-to-br from-primary/25 via-violet-400/20 to-transparent blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="animate-blob pointer-events-none absolute -top-10 right-0 h-56 w-56 rounded-full bg-gradient-to-bl from-emerald-400/20 via-cyan-400/15 to-transparent blur-3xl"
      style="animation-delay: -7s"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-5xl mx-auto px-6 pt-6 sm:pt-14 pb-4 sm:pb-8 flex flex-row items-center gap-4 sm:gap-8">
      <div class="flex-1 text-left animate-fade-in-up">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink dark:text-slate-100">
          Powerful tools.<br /><span class="bg-gradient-to-r from-primary via-violet-500 to-cyan-500 dark:from-blue-400 dark:via-violet-400 dark:to-cyan-300 bg-clip-text text-transparent">Simplified.</span>
        </h1>
        <p class="mt-2 sm:mt-3 text-sm sm:text-lg text-muted dark:text-slate-400 max-w-xl">
          Free tools to merge, compress, convert, resize and edit PDF, image, audio, video and
          data files directly in your browser.
        </p>
        <p class="mt-2 text-xs sm:text-sm text-muted dark:text-slate-500">
          <a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2"
            >Your files stay on your device and are never uploaded to Kit-Bin.</a
          >
        </p>
      </div>
      <img src="/illustrations/hero.svg" alt="" class="animate-float h-20 w-20 sm:h-40 sm:w-40 object-contain shrink-0" />
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6">
    <div class="relative">
      <svg
        viewBox="0 0 24 24"
        class="absolute left-4 top-1/2 -translate-y-1/2 h-4.5 w-4.5 text-muted"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
      </svg>
      <input
        id="tool-search"
        type="text"
        placeholder="Search tools... (e.g. merge pdf, compress image)"
        class="w-full rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 py-3 pl-11 pr-4 text-sm text-ink dark:text-slate-100 placeholder:text-muted shadow-[0_1px_2px_rgba(16,24,47,0.04)] outline-none transition-shadow focus:border-primary/40 focus:ring-4 focus:ring-primary/10"
      />
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 pt-6 sm:pt-10">
    <div class="grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-5">
      {categories.map((c, i) => {
        const cc = categoryColors[c.slug];
        return (
          <a
            href={`/${c.slug}/`}
            data-reveal
            data-reveal-delay={i * 60}
            class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-soft dark:border-slate-800 p-4 shadow-[0_1px_2px_rgba(16,24,47,0.05)] transition-all duration-200 hover:border-primary/30 hover:shadow-[0_10px_28px_-8px_rgba(16,24,47,0.22)] hover:-translate-y-1 bg-surface dark:bg-slate-900"
          >
            <div
              class={`absolute inset-0 bg-gradient-to-br ${categoryGradients[c.slug]} to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100`}
              aria-hidden="true"
            ></div>
            <span
              class={`relative flex h-10 w-10 items-center justify-center rounded-xl ${cc.tile} ${cc.text} ring-1 ring-inset ${cc.ring} shadow-sm transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:scale-105`}
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={categoryIconPaths[c.slug]} />
              </svg>
            </span>
            <p class="relative mt-3 font-semibold text-ink dark:text-slate-100">{c.name}</p>
            <!-- Clamped on phones so the five category cards don't push the
                 actual tool grid a full screen down. Full text on sm+. -->
            <p class="relative mt-1 line-clamp-2 sm:line-clamp-none text-sm leading-relaxed text-muted dark:text-slate-400">
              {categoryBlurbs[c.slug]}
            </p>
            <span class={`relative mt-auto pt-3 text-xs font-semibold ${cc.text} opacity-0 transition-opacity duration-200 group-hover:opacity-100`}>
              Browse →
            </span>
          </a>
        );
      })}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-8 sm:py-10" id="popular-section">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold tracking-tight text-ink dark:text-slate-100">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-lg bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-sm">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
          <path d="M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5z" />
        </svg>
      </span>
      Popular Tools
    </h2>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {popularTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
      <h2 class="flex items-center gap-2 text-lg font-bold tracking-tight text-ink dark:text-slate-100">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-violet-500 text-white shadow-sm">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
            <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
          </svg>
        </span>
        All Tools
      </h2>
      <div class="inline-flex items-center gap-1 rounded-xl bg-app-bg dark:bg-slate-900 border border-border-soft dark:border-slate-800 p-1 text-sm shadow-inner">
        <button type="button" data-tab="all" class="rounded-lg px-4 py-1.5 font-semibold transition-all duration-200" aria-pressed="true">All</button>
        <button type="button" data-tab="favorites" class="inline-flex items-center gap-1.5 rounded-lg px-4 py-1.5 font-semibold transition-all duration-200" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
            <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.6l-5.9 3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5z" />
          </svg>
          Favorites
        </button>
      </div>
    </div>

    <p id="no-results" class="hidden text-sm text-muted dark:text-slate-400 py-8 text-center">
      No tools match your search.
    </p>

    <div id="tool-groups" class="space-y-10">
      {categories.map((c) => {
        const cc = categoryColors[c.slug];
        const count = tools.filter((t) => t.category === c.slug).length;
        return (
          <div data-category-group={c.slug}>
            <!-- Section rule: coloured chip on the left, hairline running out to
                 the right, so each category reads as its own band of the page. -->
            <div class="mb-4 flex items-center gap-3">
              <span
                class={`inline-flex items-center gap-2 rounded-full ${cc.tile} ${cc.text} ring-1 ring-inset ${cc.ring} px-3 py-1 text-xs font-bold uppercase tracking-wide`}
              >
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                  <path d={categoryIconPaths[c.slug]} />
                </svg>
                {c.name}
              </span>
              <span class={`h-px flex-1 bg-gradient-to-r ${categoryGradients[c.slug]} to-transparent opacity-70`} aria-hidden="true"></span>
              <span class="shrink-0 text-xs font-medium text-muted dark:text-slate-500">{count}</span>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
              {tools.filter((t) => t.category === c.slug).map((t) => <ToolCard tool={t} />)}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Data privacy and compliance -->
  <div class="relative overflow-hidden border-y border-border-soft dark:border-slate-800 bg-app-bg/60 dark:bg-slate-900/30">
    <div
      class="animate-blob pointer-events-none absolute -bottom-24 left-1/4 h-64 w-64 rounded-full bg-gradient-to-tr from-primary/15 via-emerald-400/10 to-transparent blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative max-w-5xl mx-auto px-6 py-14">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight text-ink dark:text-slate-100">
          Data privacy and compliance
        </h2>
        <p class="mt-2 text-muted dark:text-slate-400">
          Your files are processed in your browser and never uploaded, so there is no server copy to
          retain, disclose, or erase. Here is how that maps onto the frameworks people ask about.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {frameworks.map((fw) => (
          <a
            href={`/compliance#${fw.id}`}
            class="group relative overflow-hidden rounded-2xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 p-5 shadow-[0_1px_2px_rgba(16,24,47,0.04)] transition-all duration-200 hover:border-primary/25 hover:shadow-[0_10px_24px_rgba(16,24,47,0.10)] hover:-translate-y-1"
          >
            <span class={`absolute inset-x-0 top-0 h-1 scale-x-0 bg-gradient-to-r ${fw.accent} origin-left transition-transform duration-300 group-hover:scale-x-100`} aria-hidden="true"></span>
            <span class={`inline-grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br ${fw.accent} text-white shadow-lg shadow-black/10 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3`}>
              <ComplianceIcon icon={fw.icon} class="h-5.5 w-5.5" />
            </span>
            <p class="mt-3 font-semibold text-ink dark:text-slate-100">{fw.short}</p>
            <p class="mt-1 text-xs text-muted dark:text-slate-400 leading-relaxed">{fw.summary}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-primary dark:text-blue-400">
              How this applies
              <svg viewBox="0 0 24 24" class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <p class="mt-5 text-xs text-muted dark:text-slate-500 max-w-2xl leading-relaxed">
        These are explanations of how the site is built, not certifications. No official GDPR or CCPA
        compliance logo exists, and there is no such thing as HIPAA certification.{' '}
        <a href="/compliance" class="text-primary dark:text-blue-400 hover:underline">Read the full detail</a>.
      </p>
    </div>
  </div>

  <!-- FAQ -->
  <div class="max-w-3xl mx-auto px-6 py-14">
    <h2 class="text-2xl font-bold tracking-tight text-ink dark:text-slate-100">
      Frequently asked questions
    </h2>
    <p class="mt-2 text-muted dark:text-slate-400">
      The things worth knowing before you trust a file tool with anything that matters.
    </p>
    <div class="mt-6">
      <FaqAccordion faqs={siteFaqs} schema />
    </div>
  </div>

  <!-- Guides -->
  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-ink dark:text-slate-100">Guides</h2>
      <a href="/guides/" class="text-sm font-medium text-primary dark:text-blue-400 hover:underline">View all guides →</a>
    </div>
    <p class="text-sm text-muted dark:text-slate-400 mb-4 max-w-2xl">
      Plain-language explanations of the file formats and mechanics behind these tools, why files
      behave the way they do.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:grid-cols-3">
      {guides.map((g) => (
        <a
          href={g.slug}
          class="group flex gap-3 rounded-xl border border-border-soft dark:border-slate-800 p-4 shadow-[0_1px_2px_rgba(16,24,47,0.04)] transition-all duration-200 hover:border-primary/25 hover:shadow-[0_8px_20px_rgba(16,24,47,0.09)] hover:-translate-y-1 bg-surface dark:bg-slate-900"
        >
          <div class="shrink-0 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3">
            <ToolIcon slug={g.slug} category="guides" size="sm" />
          </div>
          <span>
            <span class="block text-sm font-semibold text-ink dark:text-slate-100">{g.cardTitle}</span>
            <span class="mt-1 block text-xs text-muted dark:text-slate-400">{g.description}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <script>
    import { getFavorites, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

    const searchInput = document.querySelector<HTMLInputElement>('#tool-search')!;
    const popularSection = document.querySelector<HTMLElement>('#popular-section')!;
    const noResults = document.querySelector<HTMLElement>('#no-results')!;
    const groups = document.querySelectorAll<HTMLElement>('[data-category-group]');
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab]');

    let activeTab: 'all' | 'favorites' = 'all';

    function applyTabStyles() {
      tabButtons.forEach((btn) => {
        const isActive = btn.dataset.tab === activeTab;
        btn.setAttribute('aria-pressed', String(isActive));
        // Active pill: solid brand gradient so the selected filter is obvious
        // at a glance rather than a barely-there tonal shift.
        btn.classList.toggle('bg-gradient-to-br', isActive);
        btn.classList.toggle('from-primary', isActive);
        btn.classList.toggle('to-violet-500', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('shadow-md', isActive);
        btn.classList.toggle('text-muted', !isActive);
        btn.classList.toggle('dark:text-slate-400', !isActive);
        btn.classList.toggle('hover:text-ink', !isActive);
        btn.classList.toggle('dark:hover:text-slate-200', !isActive);
      });
    }

    function refresh() {
      const query = searchInput.value.trim().toLowerCase();
      const favorites = getFavorites();
      popularSection.classList.toggle('hidden', query.length > 0 || activeTab === 'favorites');

      let anyVisible = false;
      groups.forEach((group) => {
        const cards = group.querySelectorAll<HTMLElement>('[data-tool-card]');
        let groupHasVisible = false;
        cards.forEach((card) => {
          const matchesQuery =
            query.length === 0 ||
            (card.dataset.name ?? '').includes(query) ||
            (card.dataset.description ?? '').includes(query) ||
            (card.dataset.aliases ?? '').includes(query);
          const matchesTab = activeTab === 'all' || favorites.includes(card.dataset.slug ?? '');
          const visible = matchesQuery && matchesTab;
          card.classList.toggle('hidden', !visible);
          if (visible) groupHasVisible = true;
        });
        group.classList.toggle('hidden', !groupHasVisible);
        if (groupHasVisible) anyVisible = true;
      });
      noResults.classList.toggle('hidden', anyVisible);
    }

    searchInput.addEventListener('input', refresh);
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTab = btn.dataset.tab as 'all' | 'favorites';
        applyTabStyles();
        refresh();
      });
    });
    window.addEventListener(FAVORITES_CHANGED_EVENT, refresh);

    applyTabStyles();
    refresh();
  </script>
</Layout>
