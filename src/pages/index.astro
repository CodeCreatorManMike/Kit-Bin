---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories } from '../data/tools';

const popularSlugs = ['/pdf/merge', '/pdf/split', '/pdf/compress', '/image/heic-to-jpg'];
const popularTools = popularSlugs.map((slug) => tools.find((t) => t.slug === slug)!).filter(Boolean);
---

<Layout
  title="Kit-Bin — Free Browser-Based File Tools"
  description="Convert, compress, and edit files entirely in your browser. No uploads, no accounts."
>
  <div class="max-w-5xl mx-auto px-6 pt-14 pb-8 flex flex-col sm:flex-row items-center gap-8">
    <div class="flex-1 text-center sm:text-left">
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-slate-100">
        Powerful tools.<br /><span class="text-blue-600 dark:text-blue-400">Simplified.</span>
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
        Everything you need to work with your files in one beautiful, easy to use toolkit.
      </p>
    </div>
    <img src="/illustrations/hero.svg" alt="" class="h-40 w-40 object-contain shrink-0" />
  </div>

  <div class="max-w-5xl mx-auto px-6">
    <div class="relative">
      <svg
        viewBox="0 0 24 24"
        class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
      </svg>
      <input
        id="tool-search"
        type="text"
        placeholder="Search tools... (e.g. merge pdf, compress image)"
        class="w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-3 pl-12 pr-4 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-10" id="popular-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Popular Tools</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {popularTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">All Tools</h2>
      <div class="flex gap-1 rounded-lg border border-slate-200 dark:border-slate-800 p-1 text-sm">
        <button type="button" data-tab="all" class="rounded-md px-3 py-1 font-medium" aria-pressed="true">All</button>
        <button type="button" data-tab="favorites" class="rounded-md px-3 py-1 font-medium" aria-pressed="false">Favorites</button>
      </div>
    </div>

    <p id="no-results" class="hidden text-sm text-slate-500 dark:text-slate-400 py-8 text-center">
      No tools match your search.
    </p>

    <div id="tool-groups" class="space-y-8">
      {categories.map((c) => (
        <div data-category-group={c.slug}>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 mb-3">{c.name}</h3>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {tools.filter((t) => t.category === c.slug).map((t) => <ToolCard tool={t} />)}
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    import { getFavorites, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

    const searchInput = document.querySelector<HTMLInputElement>('#tool-search')!;
    const popularSection = document.querySelector<HTMLElement>('#popular-section')!;
    const noResults = document.querySelector<HTMLElement>('#no-results')!;
    const groups = document.querySelectorAll<HTMLElement>('[data-category-group]');
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab]');

    let activeTab: 'all' | 'favorites' = 'all';

    function applyTabStyles() {
      tabButtons.forEach((btn) => {
        const isActive = btn.dataset.tab === activeTab;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.classList.toggle('bg-blue-600', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('text-slate-600', !isActive);
        btn.classList.toggle('dark:text-slate-300', !isActive);
      });
    }

    function refresh() {
      const query = searchInput.value.trim().toLowerCase();
      const favorites = getFavorites();
      popularSection.classList.toggle('hidden', query.length > 0 || activeTab === 'favorites');

      let anyVisible = false;
      groups.forEach((group) => {
        const cards = group.querySelectorAll<HTMLElement>('[data-tool-card]');
        let groupHasVisible = false;
        cards.forEach((card) => {
          const matchesQuery =
            query.length === 0 ||
            (card.dataset.name ?? '').includes(query) ||
            (card.dataset.description ?? '').includes(query);
          const matchesTab = activeTab === 'all' || favorites.includes(card.dataset.slug ?? '');
          const visible = matchesQuery && matchesTab;
          card.classList.toggle('hidden', !visible);
          if (visible) groupHasVisible = true;
        });
        group.classList.toggle('hidden', !groupHasVisible);
        if (groupHasVisible) anyVisible = true;
      });
      noResults.classList.toggle('hidden', anyVisible);
    }

    searchInput.addEventListener('input', refresh);
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTab = btn.dataset.tab as 'all' | 'favorites';
        applyTabStyles();
        refresh();
      });
    });
    window.addEventListener(FAVORITES_CHANGED_EVENT, refresh);

    applyTabStyles();
    refresh();
  </script>
</Layout>
