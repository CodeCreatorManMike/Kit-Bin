---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { tools, categories } from '../data/tools';
import { guides } from '../data/guides';
import { categoryColors } from '../data/toolIcons';

const popularSlugs = ['/pdf/merge', '/pdf/split', '/pdf/compress', '/image/heic-to-jpg'];
const popularTools = popularSlugs.map((slug) => tools.find((t) => t.slug === slug)!).filter(Boolean);

const categoryBlurbs: Record<string, string> = {
  pdf: 'Merge, split, compress, rotate, watermark, convert, and rearrange PDF files.',
  image: 'Convert HEIC, WebP, PNG, and SVG files, or resize, crop, and compress images.',
  audio: 'Convert, trim, join, and normalize MP3 and WAV audio.',
  video: 'Compress, trim, mute, convert, and extract audio from video files.',
  data: 'Convert and clean CSV, JSON, and Excel-compatible data.',
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Kit-Bin',
      url: 'https://kit-bin.com/',
      logo: 'https://kit-bin.com/brand/mark.svg',
    },
    {
      '@type': 'WebSite',
      name: 'Kit-Bin',
      url: 'https://kit-bin.com/',
      description: 'Free online file tools for PDF, images, audio, video, and data — running entirely in your browser.',
    },
  ],
};
---

<Layout
  title="Free Online File Tools for PDF, Images, Audio, Video and Data | Kit-Bin"
  description="Merge PDFs, convert images, trim audio, compress video, and clean CSV files with free browser-based tools. No software installation, and your files never leave your device."
>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />

  <div class="max-w-5xl mx-auto px-6 pt-6 sm:pt-14 pb-4 sm:pb-8 flex flex-row items-center gap-4 sm:gap-8">
    <div class="flex-1 text-left">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink dark:text-slate-100">
        Powerful tools.<br /><span class="text-primary dark:text-blue-400">Simplified.</span>
      </h1>
      <p class="mt-2 sm:mt-4 text-sm sm:text-lg text-muted dark:text-slate-400 max-w-md">
        Everything you need to work with your files in one beautiful, easy to use toolkit.
      </p>
      <p class="mt-2 text-xs sm:text-sm text-muted dark:text-slate-500">
        <a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2"
          >Your files are processed on your device and never uploaded to Kit-Bin.</a
        >
      </p>
    </div>
    <img src="/illustrations/hero.svg" alt="" class="h-20 w-20 sm:h-40 sm:w-40 object-contain shrink-0" />
  </div>

  <div class="max-w-5xl mx-auto px-6">
    <div class="relative">
      <svg
        viewBox="0 0 24 24"
        class="absolute left-4 top-1/2 -translate-y-1/2 h-4.5 w-4.5 text-muted"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
      </svg>
      <input
        id="tool-search"
        type="text"
        placeholder="Search tools... (e.g. merge pdf, compress image)"
        class="w-full rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 py-3 pl-11 pr-4 text-sm text-ink dark:text-slate-100 placeholder:text-muted shadow-[0_1px_2px_rgba(16,24,47,0.04)] outline-none transition-shadow focus:border-primary/40 focus:ring-4 focus:ring-primary/10"
      />
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 pt-6 sm:pt-10">
    <div class="grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-5">
      {categories.map((c) => (
        <a
          href={`/${c.slug}/`}
          class="block rounded-xl border border-border-soft dark:border-slate-800 p-4 shadow-[0_1px_2px_rgba(16,24,47,0.04)] transition-all duration-150 hover:border-primary/25 hover:shadow-[0_6px_16px_rgba(16,24,47,0.08)] hover:-translate-y-0.5 bg-surface dark:bg-slate-900"
        >
          <p class="font-semibold text-ink dark:text-slate-100">{c.name}</p>
          <p class="mt-1 text-sm text-muted dark:text-slate-400">{categoryBlurbs[c.slug]}</p>
        </a>
      ))}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-8 sm:py-10" id="popular-section">
    <h2 class="text-lg font-semibold text-ink dark:text-slate-100 mb-4">Popular Tools</h2>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {popularTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-ink dark:text-slate-100">All Tools</h2>
      <div class="inline-flex items-center gap-0.5 rounded-lg bg-app-bg dark:bg-slate-900 border border-border-soft dark:border-slate-800 p-1 text-sm">
        <button type="button" data-tab="all" class="rounded-md px-3.5 py-1.5 font-medium transition-all duration-150" aria-pressed="true">All</button>
        <button type="button" data-tab="favorites" class="rounded-md px-3.5 py-1.5 font-medium transition-all duration-150" aria-pressed="false">Favorites</button>
      </div>
    </div>

    <p id="no-results" class="hidden text-sm text-muted dark:text-slate-400 py-8 text-center">
      No tools match your search.
    </p>

    <div id="tool-groups" class="space-y-8">
      {categories.map((c) => (
        <div data-category-group={c.slug}>
          <h3 class={`flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide mb-3 ${categoryColors[c.slug].text}`}>
            <span class={`h-1.5 w-1.5 rounded-full ${categoryColors[c.slug].dot}`}></span>
            {c.name}
          </h3>
          <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
            {tools.filter((t) => t.category === c.slug).map((t) => <ToolCard tool={t} />)}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-ink dark:text-slate-100">Guides</h2>
      <a href="/guides/" class="text-sm font-medium text-primary dark:text-blue-400 hover:underline">View all guides →</a>
    </div>
    <p class="text-sm text-muted dark:text-slate-400 mb-4 max-w-2xl">
      Plain-language explanations of the file formats and mechanics behind these tools — why files
      behave the way they do.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:grid-cols-3">
      {guides.map((g) => (
        <a
          href={g.slug}
          class="group flex gap-3 rounded-xl border border-border-soft dark:border-slate-800 p-4 shadow-[0_1px_2px_rgba(16,24,47,0.04)] transition-all duration-150 hover:border-primary/25 hover:shadow-[0_6px_16px_rgba(16,24,47,0.08)] hover:-translate-y-0.5 bg-surface dark:bg-slate-900"
        >
          <ToolIcon slug={g.slug} category="guides" size="sm" />
          <span>
            <span class="block text-sm font-semibold text-ink dark:text-slate-100">{g.cardTitle}</span>
            <span class="mt-1 block text-xs text-muted dark:text-slate-400">{g.description}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <script>
    import { getFavorites, FAVORITES_CHANGED_EVENT } from '../lib/favorites';

    const searchInput = document.querySelector<HTMLInputElement>('#tool-search')!;
    const popularSection = document.querySelector<HTMLElement>('#popular-section')!;
    const noResults = document.querySelector<HTMLElement>('#no-results')!;
    const groups = document.querySelectorAll<HTMLElement>('[data-category-group]');
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab]');

    let activeTab: 'all' | 'favorites' = 'all';

    function applyTabStyles() {
      tabButtons.forEach((btn) => {
        const isActive = btn.dataset.tab === activeTab;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.classList.toggle('bg-surface', isActive);
        btn.classList.toggle('dark:bg-slate-800', isActive);
        btn.classList.toggle('text-ink', isActive);
        btn.classList.toggle('shadow-sm', isActive);
        btn.classList.toggle('dark:text-slate-100', isActive);
        btn.classList.toggle('text-muted', !isActive);
        btn.classList.toggle('dark:text-slate-400', !isActive);
      });
    }

    function refresh() {
      const query = searchInput.value.trim().toLowerCase();
      const favorites = getFavorites();
      popularSection.classList.toggle('hidden', query.length > 0 || activeTab === 'favorites');

      let anyVisible = false;
      groups.forEach((group) => {
        const cards = group.querySelectorAll<HTMLElement>('[data-tool-card]');
        let groupHasVisible = false;
        cards.forEach((card) => {
          const matchesQuery =
            query.length === 0 ||
            (card.dataset.name ?? '').includes(query) ||
            (card.dataset.description ?? '').includes(query);
          const matchesTab = activeTab === 'all' || favorites.includes(card.dataset.slug ?? '');
          const visible = matchesQuery && matchesTab;
          card.classList.toggle('hidden', !visible);
          if (visible) groupHasVisible = true;
        });
        group.classList.toggle('hidden', !groupHasVisible);
        if (groupHasVisible) anyVisible = true;
      });
      noResults.classList.toggle('hidden', anyVisible);
    }

    searchInput.addEventListener('input', refresh);
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTab = btn.dataset.tab as 'all' | 'favorites';
        applyTabStyles();
        refresh();
      });
    });
    window.addEventListener(FAVORITES_CHANGED_EVENT, refresh);

    applyTabStyles();
    refresh();
  </script>
</Layout>
