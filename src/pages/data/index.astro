---
import Layout from '../../layouts/Layout.astro';
import CategorySchema from '../../components/CategorySchema.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';

const dataTools = tools.filter((t) => t.category === 'data');
---

<Layout title="Free Data Tools | Kit-Bin" description="Convert between CSV, JSON, and Excel, and clean up messy CSV data, entirely in your browser.">
  <CategorySchema categoryName="Data Tools" />
  <div class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Free Data Tools</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl">
      Convert CSV data to JSON or Excel, flatten JSON back into rows, or clean up a messy CSV file
      before importing it somewhere else. Every tool below runs entirely in your browser — your
      data file is never uploaded anywhere.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {dataTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
