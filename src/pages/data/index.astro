---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';

const dataTools = tools.filter((t) => t.category === 'data');
---

<Layout title="Free Data Tools | Kit-Bin" description="Convert and clean CSV/JSON data entirely in your browser.">
  <div class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Free Data Tools</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">All data tools run entirely in your browser. Files are never uploaded.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {dataTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
