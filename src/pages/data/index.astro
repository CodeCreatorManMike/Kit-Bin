---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import CategorySchema from '../../components/CategorySchema.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { categoryColors, categoryIconPaths } from '../../data/toolIcons';

const dataTools = tools.filter((t) => t.category === 'data');
const meta = categoryColors.data;
---

<Layout title="Free Private Data Tools, CSV, JSON and Excel | Kit-Bin" description="Convert between CSV, JSON, and Excel, and clean up messy CSV data without uploading it. Every tool runs entirely in your browser.">
  <CategorySchema categoryName="Data Tools" />
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div class="flex items-center gap-3">
      <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${meta.gradient} text-white shadow-lg shadow-black/10`}>
        <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d={categoryIconPaths.data} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-slate-100">Free Private Data Tools</h1>
    </div>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Convert CSV data to JSON or Excel, flatten JSON back into rows, or clean up a messy CSV file
      before importing it somewhere else. Every tool below runs entirely in your browser. Your
      data file is never uploaded anywhere.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {dataTools.slice(0, 4).map((t) => <ToolCard tool={t} />)}
      <div class="col-span-full py-6 sm:py-8">
        <AdsterraBanner placement="data-category" />
      </div>
      {dataTools.slice(4).map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
