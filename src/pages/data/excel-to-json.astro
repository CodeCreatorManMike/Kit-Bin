---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'What shape is the JSON I get back?',
    a: 'An array of objects. The first row of the sheet is treated as the header row, and its cell values become the keys on every object. Each following row becomes one object in the array. A sheet with 4 columns and 100 data rows gives you an array of 100 objects with 4 keys each.',
  },
  {
    q: 'Do formulas come through as formulas?',
    a: 'No, you get the computed value. A cell containing =B2*C2 that displays 7.50 becomes 7.5 in the JSON. JSON has no way to express a formula, and the formula text is not included. If a formula was never calculated by the spreadsheet app, that cell can come out blank.',
  },
  {
    q: 'Are numbers kept as numbers?',
    a: 'Yes. Unlike a CSV, where every value is text, a numeric cell in Excel becomes a real JSON number and a boolean cell becomes true or false. Text cells stay strings.',
  },
  {
    q: 'What happens to empty cells?',
    a: 'An empty cell becomes an empty string rather than being left out, so every object in the array has the same set of keys. That keeps the output predictable for code that iterates the array.',
  },
  {
    q: 'Can I convert more than one sheet at a time?',
    a: 'No. This tool converts one sheet per run, because a single JSON array maps to a single table. Pick the sheet you want from the dropdown, then convert again with a different sheet selected if you need more.',
  },
  {
    q: 'What about formatting, charts, and merged cells?',
    a: 'None of it is carried over. Cell colours, fonts, borders, charts, pivot tables, images, and comments have no JSON equivalent and are dropped. Merged cells are flattened, with the value in the top-left cell of the range and the rest empty. Dates are written as the spreadsheet displayed them, so check them if the exact format matters.',
  },
  {
    q: 'Does this work with the older .xls format, not just .xlsx?',
    a: 'Yes. The tool reads .xlsx, the older .xls binary format, and macro-enabled .xlsm files the same way. Macros in an .xlsm file are not run and are not carried over, only the cell values are read.',
  },
  {
    q: 'Is it really free, and is there a file size limit?',
    a: "Free, with no sign-up and no cap on how many files you convert. There's no hard file size limit either, since the workbook is parsed in your browser tab rather than uploaded, but a very large workbook is limited by your device's memory rather than any rule this tool enforces.",
  },
];
---

<Layout
  title="Convert Excel to JSON Online, Free & No Upload Required | Kit-Bin"
  description="Convert an .xlsx, .xls, or .xlsm sheet into a JSON array of objects using the header row as keys. Runs entirely in your browser, no upload."
>
  <ToolSchema
    name="Convert Excel to JSON"
    description="Convert an .xlsx, .xls, or .xlsm sheet into a JSON array of objects using the header row as keys. Runs entirely in your browser, no upload."
    faqs={faqs}
  />

  <ToolHeader title="Convert an Excel File to JSON" />

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 hover:shadow-[0_10px_30px_rgba(16,24,47,0.08)] data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60 data-[dragging=true]:scale-[1.01] dark:data-[dragging=true]:bg-blue-950/30"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.06] via-transparent to-violet-500/[0.06] opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-data-[dragging=true]:opacity-100"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span
            class="absolute inset-0 rounded-full bg-primary/20 opacity-0 group-data-[dragging=true]:opacity-100 group-data-[dragging=true]:animate-pulse-ring"
            aria-hidden="true"></span>
          <span
            class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25 transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-3 group-data-[dragging=true]:scale-110"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4" />
              <path d="M8 8l4-4 4 4" />
              <path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" />
            </svg>
          </span>
        </span>

        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop an Excel file here or click to browse</p>
        <p class="mt-1 text-sm text-muted dark:text-slate-400">.xlsx, .xls, or .xlsm</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <p id="file-info" class="mt-2 text-sm font-medium text-primary dark:text-blue-400"></p>
        <input id="file-input" type="file" accept=".xlsx,.xls,.xlsm" class="hidden" />
      </div>
    </div>

    <div id="sheet-panel" class="hidden mt-4 rounded-2xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 p-6">
      <label for="sheet-select" class="block text-sm font-medium">Which sheet do you want?</label>
      <select
        id="sheet-select"
        class="mt-2 w-full rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-3 py-2 transition-colors focus:border-primary/50"
      ></select>
      <p id="sheet-hint" class="mt-2 text-sm text-muted dark:text-slate-400"></p>
      <button
        id="convert-button"
        class="mt-4 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
      >
        Convert to JSON
      </button>
    </div>

    <div id="status" class="hidden mt-4" role="status" aria-live="polite">
      <div class="rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-4 py-3">
        <p data-status-text class="text-center text-sm font-medium text-ink dark:text-slate-200"></p>
        <div data-status-bar class="mt-2.5 h-1 overflow-hidden rounded-full bg-app-bg dark:bg-slate-800">
          <div class="h-full w-full animate-shimmer rounded-full" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div
      id="result"
      class="hidden mt-4 overflow-hidden rounded-2xl border border-emerald-300/70 dark:border-emerald-500/25 bg-gradient-to-br from-emerald-50 to-surface dark:from-emerald-950/25 dark:to-slate-900 p-6 text-center"
    >
      <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path class="animate-draw-check" d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <p class="mt-2.5 font-semibold text-ink dark:text-slate-100">Done</p>
      <p data-result-note class="mt-0.5 text-sm text-muted dark:text-slate-400"></p>

      <a
        id="download-link"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v12" />
          <path d="M8 12l4 4 4-4" />
          <path d="M4 20h16" />
        </svg>
        Download result
      </a>

      <button id="reset-button" class="mt-4 block w-full text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 transition-colors hover:text-ink dark:hover:text-slate-200">
        Process another file
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      This tool turns one sheet of an Excel workbook into a JSON array of objects, using the first
      row as the keys. Drop your file above, pick a sheet from the dropdown, then click convert.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">What the output looks like</h2>
      <p class="text-muted dark:text-slate-400">
        A sheet with the header row Name, Qty, Price and one data row Widget, 3, 2.5 becomes:
      </p>
      <pre class="mt-2 overflow-x-auto rounded-lg border border-border-soft dark:border-slate-700 p-4 text-sm"><code>[
  &#123;
    "Name": "Widget",
    "Qty": 3,
    "Price": 2.5
  &#125;
]</code></pre>
      <p class="mt-2 text-muted dark:text-slate-400">
        Numeric cells become real numbers, booleans become true or false, and empty cells become
        empty strings so every object has the same keys.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">What does not survive the conversion</h2>
      <ul class="list-disc list-inside mt-2 space-y-1 text-muted dark:text-slate-400">
        <li><strong>Formulas</strong> are exported as their computed values. The formula text is not kept.</li>
        <li><strong>Formatting</strong> (fonts, colours, borders, conditional formatting) is dropped.</li>
        <li><strong>Merged cells</strong> are flattened. The value lands in the top-left cell of the range and the rest is empty.</li>
        <li><strong>Charts, images, pivot tables, and comments</strong> have no JSON equivalent and are not exported.</li>
        <li><strong>Sheet structure</strong> is not preserved. One run converts one sheet, not the whole workbook.</li>
        <li><strong>Dates</strong> are written as the spreadsheet displayed them, so a cell showing 03/04/2025 stays that ambiguous text. Reformat to YYYY-MM-DD in Excel first if that matters.</li>
      </ul>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Need flat rows instead of objects? Use{' '}
      <a href="/data/excel-to-csv/" class="text-primary dark:text-blue-400 hover:underline">Excel to CSV</a>. Going
      the other way, start with{' '}
      <a href="/json/to-csv/" class="text-primary dark:text-blue-400 hover:underline">JSON to CSV</a>{' '}
      then{' '}
      <a href="/csv/to-excel/" class="text-primary dark:text-blue-400 hover:underline">CSV to Excel</a>.
    </p>
    <p class="text-sm">
      Want to tidy or check the result? Try the{' '}
      <a href="/data/json-formatter/" class="text-primary dark:text-blue-400 hover:underline">JSON formatter and validator</a>, or
      read{' '}
      <a href="/guides/csv-vs-json/" class="text-primary dark:text-blue-400 hover:underline">CSV vs JSON: Which One Do You Need?</a>
    </p>
    <p class="text-sm">
      Not sure CSV or JSON is the right export at all? Read{' '}
      <a href="/guides/excel-to-csv-vs-excel-to-json/" class="text-primary dark:text-blue-400 hover:underline">Excel to CSV vs Excel to JSON: which export should you use?</a>
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:data/excel-to-json" />
  </div>

  <script>
    import { excelToJson, listSheets, isExcelFile } from '../../lib/data/excel';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const sheetPanel = document.querySelector<HTMLElement>('#sheet-panel')!;
    const sheetSelect = document.querySelector<HTMLSelectElement>('#sheet-select')!;
    const sheetHint = document.querySelector<HTMLElement>('#sheet-hint')!;
    const convertButton = document.querySelector<HTMLButtonElement>('#convert-button')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;
    const resultNote = result.querySelector<HTMLElement>('[data-result-note]')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    let currentFile: File | null = null;

    const statusText = status.querySelector<HTMLElement>('[data-status-text]')!;
    const statusBar = status.querySelector<HTMLElement>('[data-status-bar]')!;

    function setStatus(msg: string | null, isError = false) {
      statusText.textContent = msg ?? '';
      status.classList.toggle('hidden', !msg);
      statusBar.classList.toggle('hidden', isError);
      statusText.classList.toggle('text-red-600', isError);
      statusText.classList.toggle('dark:text-red-400', isError);
    }

    async function handleFile(file: File) {
      if (!isExcelFile(file.name)) {
        setStatus('This tool needs an Excel file (.xlsx, .xls, or .xlsm).', true);
        return;
      }
      currentFile = file;
      fileInfo.textContent = file.name;
      setStatus('Reading workbook…');

      try {
        const sheets = await listSheets(file);
        if (sheets.length === 0) {
          setStatus('This workbook has no sheets.', true);
          return;
        }
        setStatus(null);

        sheetSelect.innerHTML = '';
        for (const name of sheets) {
          const option = document.createElement('option');
          option.value = name;
          option.textContent = name;
          sheetSelect.appendChild(option);
        }
        sheetHint.textContent =
          sheets.length > 1
            ? `${sheets.length} sheets found. One JSON array maps to one sheet, so convert again to export another.`
            : 'This workbook has one sheet.';

        dropzone.classList.add('hidden');
        sheetPanel.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        setStatus(
          `Could not read that workbook: ${err instanceof Error ? err.message : 'unknown error'}. Check the file opens in Excel first.`,
          true,
        );
      }
    }

    convertButton.addEventListener('click', async () => {
      if (!currentFile) return;
      setStatus('Converting…');
      try {
        const { blob, filename } = await excelToJson(currentFile, sheetSelect.value);
        setStatus(null);
        downloadLink.href = URL.createObjectURL(blob);
        downloadLink.download = filename;
        resultNote.textContent = filename;
        sheetPanel.classList.add('hidden');
        result.classList.remove('hidden');
        result.classList.remove('animate-pop-in');
        void result.offsetWidth;
        result.classList.add('animate-pop-in');
      } catch (err) {
        console.error(err);
        setStatus(
          `Something went wrong: ${err instanceof Error ? err.message : 'unknown error'}. Try a different file.`,
          true,
        );
      }
    });

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.dataset.dragging = 'false';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    resetButton.addEventListener('click', () => {
      currentFile = null;
      result.classList.add('hidden');
      sheetPanel.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });
  </script>
</Layout>
