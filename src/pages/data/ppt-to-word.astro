---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is my presentation uploaded to a server?',
    a: 'No. Every slide is rendered and packaged into a .docx file entirely in your browser. Nothing is uploaded to Kit-Bin or anywhere else.',
  },
  {
    q: 'Will it actually look the same as the presentation?',
    a: "Yes — each slide is redrawn from its real text, positions, colors, and pictures, then placed as a picture on its own page. It isn't a generic Word outline reconstructed from extracted text; it's a rendering of that specific slide's own layout and styling.",
  },
  {
    q: "What's the catch?",
    a: "Each page is a picture, not editable text — you can't click into it in Word and edit a sentence the way you could in a document written from scratch. This is the same tradeoff PDF to PowerPoint makes, and the same one commercial converters (CloudConvert, FreeConvert) make for this exact conversion: exact appearance in exchange for not being editable. There's no lossless middle ground, because Word has no equivalent to PowerPoint's freely-positioned, overlapping shapes.",
  },
  {
    q: 'What does not render correctly?',
    a: "Embedded fonts are approximated with a standard sans-serif rather than the exact original typeface (browsers can't load arbitrary fonts embedded in a .pptx), gradients/theme-based colors fall back to a plain default rather than being resolved exactly, and vector image formats some presentations embed (WMF/EMF) can't be decoded by a browser and are skipped. Plain text color, size, bold/italic/underline, solid-color shape fills, bullet structure, and raster pictures (PNG/JPG/GIF/BMP) all render correctly.",
  },
  {
    q: 'Does this work on .ppt (the older format)?',
    a: "No, only .pptx. The old .ppt format is a completely different, proprietary binary structure (not a ZIP of XML like .pptx), which this tool doesn't parse. Re-save the file as .pptx from PowerPoint or Google Slides first.",
  },
  {
    q: 'Will slide order be correct if slides were reordered or moved between sections?',
    a: "Yes. This reads the presentation's actual slide order (the same data PowerPoint itself uses), not just the numeric order of the slide files inside the .pptx package, which can differ once slides have been reordered or duplicated.",
  },
  {
    q: 'What file do I get?',
    a: 'A standard .docx file that opens in Microsoft Word, Google Docs, LibreOffice Writer, and Apple Pages.',
  },
];
---

<Layout
  title="PowerPoint to Word Converter, Keep the Exact Look | Kit-Bin"
  description="Convert a PowerPoint presentation into a Word (.docx) document that looks exactly like the slides, one per page. Private, free, and no account required."
>
  <ToolSchema
    name="PowerPoint to Word"
    description="Convert a PowerPoint presentation into a Word (.docx) document that looks exactly like the slides, one per page. Private, free, and no account required."
    faqs={faqs}
  />

  <ToolHeader title="Convert PowerPoint to Word, Keeping the Exact Look" />
  <ToolWidget accept=".pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation" multiple dropLabel="Drop .pptx files here or click to browse" />
  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Turn a PowerPoint presentation into a .docx file without uploading it anywhere, one slide
      per page, looking like the original slide rather than a generic reformatted outline. Each
      slide's real text positions, sizes, colors, and pictures are redrawn and placed as a picture
      on its own page — there's no formatting to lose in translation, because the page simply
      shows the slide.
    </p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg">The tradeoff, up front</h2>
      <p class="mt-2 text-muted dark:text-slate-400">
        Exact visual fidelity means each page is a picture, not editable text — you get a document
        that looks right immediately, at the cost of not being able to click in and edit a
        sentence. If you need the words editable more than you need the exact look preserved,
        convert to <a href="/pdf/to-word/" class="text-primary dark:text-blue-400 hover:underline">PDF to Word</a> after
        exporting the deck to PDF instead, which reconstructs real text but not the exact layout.
      </p>
    </div>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3"><FaqAccordion faqs={faqs} /></div>
    </div>
    <p class="text-sm">
      Need a PDF turned into slides instead? <a href="/pdf/to-powerpoint/" class="text-primary dark:text-blue-400 hover:underline">PDF to PowerPoint</a>{' '}
      keeps the exact look of each page as a picture on its own slide, the same approach in reverse.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdBanner placement="tool-page:data/ppt-to-word" />
  </div>

  <script>
    import { pptxToWord } from '../../lib/data/pptxToWord';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: '.pptx',
      multiple: true,
      batchZipName: 'kit-bin-ppt-to-word.zip',
      validate: (files) =>
        files.some((f) => !f.name.toLowerCase().endsWith('.pptx'))
          ? 'This tool only accepts .pptx files (the old .ppt format is not supported).'
          : null,
      runEach: async (file, reportProgress) => {
        const result = await pptxToWord(file, reportProgress);
        return {
          blob: result.blob,
          filename: result.filename,
          note: `Converted ${result.slideCount} slide${result.slideCount === 1 ? '' : 's'} to a Word document.`,
        };
      },
    });
  </script>
</Layout>
