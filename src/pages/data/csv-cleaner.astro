---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Clean CSV Data Online — Free & No Upload Required | Kit-Bin"
  description="Trim whitespace, drop empty rows/columns, and remove duplicates from a CSV. Runs entirely in your browser."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Clean CSV Data — Free</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="text/csv,.csv" dropLabel="Drop a CSV file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-4">
    <p>This tool trims whitespace, drops fully-empty rows and columns, and removes exact duplicate rows from a CSV.</p>
    <p>Drop your CSV above. The cleaned file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">What exactly counts as a duplicate?</p>
      <p class="text-slate-600 dark:text-slate-400">Rows where every column value matches exactly, after trimming whitespace.</p>
    </div>
  </div>

  <script>
    import { csvClean } from '../../lib/data/csv';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'text/csv,.csv',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.csv') ? 'This tool needs a CSV file.' : null),
      run: async (files) => {
        const { blob, rowsBefore, rowsAfter } = await csvClean(files[0]);
        const note = `${rowsBefore} rows → ${rowsAfter} rows`;
        return { blob, filename: files[0].name.replace(/\.csv$/i, '-cleaned.csv'), note };
      },
    });
  </script>
</Layout>
