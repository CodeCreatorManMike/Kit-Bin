---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does my CSV need a header row?',
    a: "Yes, the first row's values become the JSON object keys, and every following row becomes one object using those keys.",
  },
  {
    q: 'Does it handle commas inside quoted fields?',
    a: 'Yes, the parser follows standard CSV quoting rules, so a comma inside a quoted value is not treated as a column separator.',
  },
  {
    q: 'What happens to blank rows or blank cells?',
    a: 'Fully blank rows are skipped entirely. A blank cell in an otherwise filled row becomes an empty string in the resulting JSON, not a missing key.',
  },
  {
    q: 'Are numbers and booleans converted to their JSON types?',
    a: "No, every value comes out of a CSV as text, and this tool keeps them as strings (e.g. \"42\" rather than 42) rather than guessing types. If your downstream tool needs real numbers, you'll need to convert them there.",
  },
];
---

<Layout
  title="Convert CSV to JSON Online, Free & No Upload Required | Kit-Bin"
  description="Convert a CSV file to JSON in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert CSV to JSON"
    description="Convert a CSV file to JSON in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Convert a CSV File to JSON</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="text/csv,.csv" dropLabel="Drop a CSV file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>This tool converts a CSV file into a JSON array of objects, using the header row as keys. Drop your CSV above. The JSON file downloads automatically once ready.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-muted dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="text-sm">Dealing with messy CSV data first? <a href="/data/csv-cleaner" class="text-primary dark:text-blue-400 hover:underline">Try CSV Cleaner</a>, or read <a href="/guides/why-csv-imports-fail" class="text-primary dark:text-blue-400 hover:underline">why CSV imports fail</a>.</p>
  </div>

  <script>
    import { csvToJson } from '../../lib/data/csv';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'text/csv,.csv',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.csv') ? 'This tool needs a CSV file.' : null),
      run: async (files) => {
        const blob = await csvToJson(files[0]);
        return { blob, filename: files[0].name.replace(/\.csv$/i, '.json') };
      },
    });
  </script>
</Layout>
