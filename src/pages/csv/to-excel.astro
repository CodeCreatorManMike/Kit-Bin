---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does formatting carry over?',
    a: 'No, CSV is plain text with no formatting information, so there is nothing to carry over. You get raw data in a single sheet with default Excel formatting.',
  },
  {
    q: 'Will numbers be stored as real numbers or as text?',
    a: 'The conversion lets Excel infer cell types from the data, so values that look numeric are typically stored as numbers rather than text, but formatting like leading zeros or specific decimal display is not preserved.',
  },
  {
    q: 'Does this create multiple sheets or one?',
    a: 'One sheet, since a CSV file only has one table of data to begin with.',
  },
];
---

<Layout
  title="Convert CSV to Excel Online, Free & No Upload Required | Kit-Bin"
  description="Convert a CSV file to an Excel .xlsx file. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert CSV to Excel"
    description="Convert a CSV file to an Excel .xlsx file. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Convert a CSV File to Excel (.xlsx)</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="text/csv,.csv" dropLabel="Drop a CSV file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>This tool converts a CSV file into an Excel-compatible .xlsx file. Drop your CSV above. The .xlsx file downloads automatically once ready.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-muted dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    import { csvToExcel } from '../../lib/data/csv';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'text/csv,.csv',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.csv') ? 'This tool needs a CSV file.' : null),
      run: async (files) => {
        const blob = await csvToExcel(files[0]);
        return { blob, filename: files[0].name.replace(/\.csv$/i, '.xlsx') };
      },
    });
  </script>
</Layout>
