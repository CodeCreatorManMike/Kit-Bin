---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'What JSON structure does this expect?',
    a: 'An array of flat objects works best, with each object becoming one CSV row and each key becoming a column. A single object (not wrapped in an array) is also supported and becomes one row.',
  },
  {
    q: 'What happens to nested objects or arrays inside a field?',
    a: "Nested structures don't flatten into separate columns — they're written into the cell as their JSON text representation, which usually isn't what you want in a spreadsheet. This tool works best on already-flat data.",
  },
  {
    q: 'Do all objects need the same keys?',
    a: 'No — if objects have different keys, the output includes a column for every key seen across all objects, leaving cells blank for objects missing that key.',
  },
];
---

<Layout
  title="Convert JSON to CSV Online — Free & No Upload Required | Kit-Bin"
  description="Convert a JSON file to CSV in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert JSON to CSV"
    description="Convert a JSON file to CSV in seconds. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Convert a JSON File to CSV</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="application/json,.json" dropLabel="Drop a JSON file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-6">
    <p>This tool converts a JSON array of objects into a CSV file. Drop your JSON above — the CSV file downloads automatically once ready.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-slate-600 dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="text-sm">Not sure which format fits your use case? <a href="/guides/csv-vs-json" class="text-blue-600 dark:text-blue-400 hover:underline">Read CSV vs JSON</a>.</p>
  </div>

  <script>
    import { jsonToCsv } from '../../lib/data/csv';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/json,.json',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.json') ? 'This tool needs a JSON file.' : null),
      run: async (files) => {
        const blob = await jsonToCsv(files[0]);
        return { blob, filename: files[0].name.replace(/\.json$/i, '.csv') };
      },
    });
  </script>
</Layout>
