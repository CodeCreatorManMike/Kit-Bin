---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
---

<Layout
  title="Normalize Audio Volume Online — Free & No Upload Required | ToolKit"
  description="Normalize an audio file's volume to a consistent peak level. Runs entirely in your browser — your file is never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold">Normalize Audio Volume — Free</h1>
    <p class="mt-2 text-slate-600">🔒 Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="audio/*" dropLabel="Drop an audio file here or click to browse" />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 space-y-4">
    <p>This tool boosts or reduces an audio file's volume so its loudest point sits just below clipping.</p>
    <p>Drop your audio file above. The normalized file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">What format is the output?</p>
      <p class="text-slate-600">WAV, regardless of the input format.</p>
    </div>
  </div>

  <script>
    import { normalizeVolume } from '../../lib/audio/normalize';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'audio/*',
      validate: (files) => (!files[0]?.type.startsWith('audio/') ? 'This tool needs an audio file.' : null),
      run: async (files) => {
        const blob = await normalizeVolume(files[0]);
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '-normalized.wav') };
      },
    });
  </script>
</Layout>
