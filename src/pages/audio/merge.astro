---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'What format is the output?',
    a: 'WAV, regardless of the input formats.',
  },
  {
    q: 'Can I merge files with different sample rates?',
    a: 'It works best when all files share the same sample rate. Mixed rates may play back slightly off.',
  },
  {
    q: 'Does this join files one after another, or mix them together?',
    a: "Joins them sequentially. The second file starts playing right after the first ends. This isn't a mixing tool; it won't overlay two tracks to play at the same time.",
  },
  {
    q: 'Can I reorder the files before merging?',
    a: "The order you select or drop the files in is the order they'll play in the output. Select them in the order you want.",
  },
];
---

<Layout
  title="Merge Audio Files Online, Free & No Upload Required | Kit-Bin"
  description="Combine multiple audio files into one. Runs entirely in your browser. Your files are never uploaded to a server."
>
  <ToolSchema
    name="Merge Audio Files"
    description="Combine multiple audio files into one. Runs entirely in your browser. Your files are never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Combine Multiple Audio Files into One Track" />

  <ToolWidget accept="audio/*" multiple dropLabel="Drop 2+ audio files here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>Drop 2 or more audio files above, in the order you want them to play. The merged file downloads automatically once ready. The files play back to back, not mixed together.</p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdBanner placement="tool-page:audio/merge" />
  </div>

  <script>
    import { mergeAudio } from '../../lib/audio/merge';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'audio/*',
      multiple: true,
      validate: (files) => {
        if (files.length < 2) return 'Select at least 2 audio files to merge.';
        if (files.some((f) => !f.type.startsWith('audio/'))) return 'This tool needs audio files.';
        return null;
      },
      run: async (files) => {
        const blob = await mergeAudio(files);
        return { blob, filename: 'merged.wav' };
      },
    });
  </script>
</Layout>
