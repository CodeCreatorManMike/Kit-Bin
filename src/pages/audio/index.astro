---
import Layout from '../../layouts/Layout.astro';
import CategorySchema from '../../components/CategorySchema.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';

const audioTools = tools.filter((t) => t.category === 'audio');
---

<Layout title="Free Audio Tools | Kit-Bin" description="Convert, trim, join, and normalize MP3 and WAV audio entirely in your browser.">
  <CategorySchema categoryName="Audio Tools" />
  <div class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Free Audio Tools</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl">
      Convert between MP3 and WAV, cut a clip down to a specific range with a visual waveform,
      join multiple recordings into one file, or even out a track's volume. Every tool below runs
      entirely in your browser — your audio file is never uploaded anywhere.
    </p>
    <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl">
      Wondering why a video or recording sounds quiet even after normalizing it? Read
      <a href="/guides/why-audio-sounds-quiet" class="text-blue-600 dark:text-blue-400 hover:underline">why some audio sounds quiet no matter how high you turn it up</a>.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {audioTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
