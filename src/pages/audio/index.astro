---
import Layout from '../../layouts/Layout.astro';
import CategorySchema from '../../components/CategorySchema.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { categoryColors, categoryIconPaths } from '../../data/toolIcons';

const audioTools = tools.filter((t) => t.category === 'audio');
const meta = categoryColors.audio;
---

<Layout title="Free Private Audio Tools | Kit-Bin" description="Convert, trim, join, and normalize MP3 and WAV audio without uploading it. Every tool runs entirely in your browser.">
  <CategorySchema categoryName="Audio Tools" />
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div class="flex items-center gap-3">
      <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${meta.gradient} text-white shadow-lg shadow-black/10`}>
        <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d={categoryIconPaths.audio} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-slate-100">Free Private Audio Tools</h1>
    </div>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Convert between MP3 and WAV, cut a clip down to a specific range with a visual waveform,
      join multiple recordings into one file, or even out a track's volume. Every tool below runs
      entirely in your browser. Your audio file is never uploaded anywhere.
    </p>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Wondering why a video or recording sounds quiet even after normalizing it? Read
      <a href="/guides/why-audio-sounds-quiet" class="text-primary dark:text-blue-400 hover:underline">why some audio sounds quiet no matter how high you turn it up</a>.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {audioTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
