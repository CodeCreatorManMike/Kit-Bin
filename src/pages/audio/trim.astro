---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Trim Audio Online, Free & No Upload Required | Kit-Bin"
  description="Trim an audio file to a start and end time. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Trim Audio"
    description="Trim an audio file to a start and end time. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={[
    {
      "q": "What format is the output?",
      "a": "WAV, regardless of the input format."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Trim Audio, Free</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      class="cursor-pointer border-2 border-dashed border-border-soft dark:border-slate-700 rounded-xl p-12 text-center hover:border-primary/40 dark:hover:border-slate-500 transition-colors"
    >
      <p class="text-lg font-medium">Drop an audio file here or click to browse</p>
      <p id="file-info" class="mt-2 text-sm text-muted dark:text-slate-400"></p>
      <input id="file-input" type="file" accept="audio/*" class="hidden" />
    </div>

    <div id="trim-panel" class="hidden mt-4">
      <p class="text-sm text-muted dark:text-slate-400 mb-2">Drag the edges of the highlighted region to pick a start and end point.</p>
      <div id="waveform" class="rounded-xl border border-border-soft dark:border-slate-700 p-3"></div>
      <p id="range-readout" class="mt-2 text-center text-sm text-muted dark:text-slate-400"></p>
      <button id="trim-button" class="mt-3 rounded-lg bg-primary dark:bg-blue-500 px-6 py-3 text-white font-medium hover:bg-primary-hover dark:hover:bg-blue-600">
        Trim
      </button>
    </div>

    <p id="status" class="hidden mt-4 text-center text-sm text-muted dark:text-slate-400"></p>

    <div id="result" class="hidden mt-4 rounded-xl border border-border-soft dark:border-slate-700 p-6 text-center">
      <a
        id="download-link"
        class="inline-block rounded-lg bg-primary dark:bg-blue-500 px-6 py-3 text-white font-medium hover:bg-primary-hover dark:hover:bg-blue-600"
        >Download result</a
      >
      <p data-result-note class="mt-2 text-sm text-muted dark:text-slate-400"></p>
      <button id="reset-button" class="mt-4 text-sm text-muted dark:text-slate-400 underline hover:text-ink dark:hover:text-slate-200">
        Process another file
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-4">
    <p>This tool cuts an audio file down to the time range you specify, using a visual waveform to pick the range.</p>
    <p>Drop your audio file above, drag the region's edges to set start/end, then click trim.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">What format is the output?</p>
      <p class="text-muted dark:text-slate-400">WAV, regardless of the input format.</p>
    </div>
  </div>

  <script>
    import WaveSurfer from 'wavesurfer.js';
    import RegionsPlugin from 'wavesurfer.js/dist/plugins/regions.esm.js';
    import { trimAudio } from '../../lib/audio/trim';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const trimPanel = document.querySelector<HTMLElement>('#trim-panel')!;
    const waveformHost = document.querySelector<HTMLElement>('#waveform')!;
    const rangeReadout = document.querySelector<HTMLElement>('#range-readout')!;
    const trimButton = document.querySelector<HTMLButtonElement>('#trim-button')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    let currentFile: File | null = null;
    let wavesurfer: WaveSurfer | null = null;
    let regions: RegionsPlugin | null = null;
    let currentRegion: ReturnType<RegionsPlugin['addRegion']> | null = null;

    function setStatus(msg: string | null) {
      status.textContent = msg ?? '';
      status.classList.toggle('hidden', !msg);
    }

    function formatTime(seconds: number): string {
      return seconds.toFixed(1) + 's';
    }

    function updateReadout() {
      if (!currentRegion) return;
      rangeReadout.textContent = `${formatTime(currentRegion.start)} to ${formatTime(currentRegion.end)}`;
    }

    function handleFile(file: File) {
      if (!file.type.startsWith('audio/')) {
        setStatus('This tool needs an audio file.');
        return;
      }
      currentFile = file;
      fileInfo.textContent = file.name;

      wavesurfer?.destroy();
      waveformHost.innerHTML = '';

      regions = RegionsPlugin.create();
      wavesurfer = WaveSurfer.create({
        container: waveformHost,
        waveColor: '#94a3b8',
        progressColor: '#2563eb',
        height: 96,
        url: URL.createObjectURL(file),
        plugins: [regions],
      });

      wavesurfer.on('decode', () => {
        const duration = wavesurfer!.getDuration();
        currentRegion = regions!.addRegion({
          start: 0,
          end: duration,
          color: 'rgba(37, 99, 235, 0.15)',
          drag: true,
          resize: true,
        });
        updateReadout();
        trimPanel.classList.remove('hidden');
        dropzone.classList.add('hidden');
      });

      regions.on('region-updated', () => updateReadout());
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-primary');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-primary'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-primary');
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    trimButton.addEventListener('click', async () => {
      if (!currentFile || !currentRegion) return;
      setStatus('Processing…');
      try {
        const blob = await trimAudio(currentFile, currentRegion.start, currentRegion.end);
        setStatus(null);
        const url = URL.createObjectURL(blob);
        downloadLink.href = url;
        downloadLink.download = currentFile.name.replace(/\.[^.]+$/, '-trimmed.wav');
        result.classList.remove('hidden');
        trimPanel.classList.add('hidden');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'Something went wrong.');
      }
    });

    resetButton.addEventListener('click', () => {
      currentFile = null;
      currentRegion = null;
      wavesurfer?.destroy();
      wavesurfer = null;
      waveformHost.innerHTML = '';
      result.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });
  </script>
</Layout>
