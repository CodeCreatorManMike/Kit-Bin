---
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Will this affect quality?',
    a: "Yes, MP3 is lossy, so there's some quality loss. That's the tradeoff for a much smaller file, and at normal listening volumes it's usually not noticeable for speech or typical music.",
  },
  {
    q: 'Does mono vs. stereo matter?',
    a: "This tool preserves whatever channel layout your WAV file already has. It doesn't force mono or stereo. A mono source will produce a smaller MP3 than an equivalent stereo one.",
  },
  {
    q: 'Is there a bitrate setting?',
    a: "Not currently, the tool uses a single default quality setting rather than exposing bitrate as a choice.",
  },
];
---

<Layout
  title="WAV to MP3 Converter, Make Audio Files Smaller | Kit-Bin"
  description="Convert a WAV file to MP3 in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert WAV to MP3"
    description="Convert a WAV file to MP3 in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Make a WAV File Smaller as MP3" />

  <ToolWidget accept="audio/wav,.wav" dropLabel="Drop a WAV file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Uncompressed WAV files are large. Converting to MP3 trades some audio detail for a file
      that's typically a fraction of the size, which matters for email attachments, storage, or
      uploading somewhere with a size limit.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </div>

  <script>
    import { convertAudio } from '../../lib/audio/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'audio/wav,.wav',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.wav') ? 'This tool needs a WAV file.' : null),
      run: async (files) => {
        const blob = await convertAudio(files[0], 'mp3');
        return { blob, filename: files[0].name.replace(/\.wav$/i, '.mp3') };
      },
    });
  </script>
</Layout>
