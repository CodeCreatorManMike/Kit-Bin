---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Convert WAV to MP3 Online — Free & No Upload Required | Kit-Bin"
  description="Convert a WAV file to MP3 in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert WAV to MP3"
    description="Convert a WAV file to MP3 in seconds. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={[
    {
      "q": "Will this affect quality?",
      "a": "MP3 is lossy, so there's some quality loss — that's the tradeoff for a much smaller file."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Convert WAV to MP3 — Free</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="audio/wav,.wav" dropLabel="Drop a WAV file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-4">
    <p>This tool converts a WAV audio file into a compressed MP3 file.</p>
    <p>Drop your WAV above. The MP3 file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Will this affect quality?</p>
      <p class="text-muted dark:text-slate-400">MP3 is lossy, so there's some quality loss — that's the tradeoff for a much smaller file.</p>
    </div>
  </div>

  <script>
    import { convertAudio } from '../../lib/audio/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'audio/wav,.wav',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.wav') ? 'This tool needs a WAV file.' : null),
      run: async (files) => {
        const blob = await convertAudio(files[0], 'mp3');
        return { blob, filename: files[0].name.replace(/\.wav$/i, '.mp3') };
      },
    });
  </script>
</Layout>
