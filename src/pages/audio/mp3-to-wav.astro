---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Convert MP3 to WAV Online — Free & No Upload Required | ToolKit"
  description="Convert an MP3 file to WAV in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold">Convert MP3 to WAV — Free</h1>
    <p class="mt-2 text-slate-600">Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="audio/mpeg,.mp3" dropLabel="Drop an MP3 file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 space-y-4">
    <p>This tool converts an MP3 audio file into an uncompressed WAV file.</p>
    <p>Drop your MP3 above. The WAV file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Is my file uploaded anywhere?</p>
      <p class="text-slate-600">No. Conversion happens entirely in your browser — your audio never leaves your device.</p>
    </div>
    <div>
      <p class="font-medium">Why is the WAV file bigger than the MP3?</p>
      <p class="text-slate-600">WAV is uncompressed audio, so it's expected to be significantly larger than MP3.</p>
    </div>
  </div>

  <script>
    import { convertAudio } from '../../lib/audio/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'audio/mpeg,.mp3',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.mp3') ? 'This tool needs an MP3 file.' : null),
      run: async (files) => {
        const blob = await convertAudio(files[0], 'wav');
        return { blob, filename: files[0].name.replace(/\.mp3$/i, '.wav') };
      },
    });
  </script>
</Layout>
