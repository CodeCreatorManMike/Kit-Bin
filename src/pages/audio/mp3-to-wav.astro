---
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is my file uploaded anywhere?',
    a: 'No. Conversion happens entirely in your browser. Your audio never leaves your device.',
  },
  {
    q: 'Why is the WAV file bigger than the MP3?',
    a: "WAV is uncompressed audio, so it's expected to be significantly larger than MP3, often 5-10x, depending on the original MP3 bitrate.",
  },
  {
    q: 'Does converting to WAV restore audio quality lost in the MP3?',
    a: "No. MP3 is a lossy format. Detail removed during the original MP3 encoding is gone and can't be recovered. Converting to WAV just stores the MP3's existing audio data uncompressed; it doesn't add anything back.",
  },
  {
    q: 'Why convert to WAV at all, then?',
    a: "Some audio editors and older software expect uncompressed PCM audio rather than a compressed format, or handle WAV more reliably for further processing.",
  },
];
---

<Layout
  title="MP3 to WAV Converter, Create an Uncompressed Audio File | Kit-Bin"
  description="Convert an MP3 file to WAV in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert MP3 to WAV"
    description="Convert an MP3 file to WAV in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Convert MP3 to an Uncompressed WAV File" />

  <ToolWidget accept="audio/mpeg,.mp3" dropLabel="Drop an MP3 file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Converting MP3 to WAV makes the audio easier to use in editors that expect uncompressed
      PCM. It does not restore detail that was removed when the MP3 was originally encoded. It
      just stores the same audio data without further compression.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Need to trim or combine the result? Try{' '}
      <a href="/audio/trim" class="text-primary dark:text-blue-400 hover:underline">Trim Audio</a>{' '}
      or <a href="/audio/merge" class="text-primary dark:text-blue-400 hover:underline">Merge Audio</a>.
    </p>
  </div>

  <script>
    import { convertAudio } from '../../lib/audio/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'audio/mpeg,.mp3',
      validate: (files) => (!files[0]?.name.toLowerCase().endsWith('.mp3') ? 'This tool needs an MP3 file.' : null),
      run: async (files) => {
        const blob = await convertAudio(files[0], 'wav');
        return { blob, filename: files[0].name.replace(/\.mp3$/i, '.wav') };
      },
    });
  </script>
</Layout>
