---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is there a limit on how many photos I can use?', a: "Up to 40, or fewer if a longer per-image duration would push the total past 3 minutes — whichever limit comes first. If your photos get cut off, either use fewer of them or a shorter duration per image." },
  { q: 'Do my photos need to be the same shape?', a: "No. Every photo is fit inside a fixed 16:9 frame without cropping or stretching — a portrait photo gets black bars on the sides rather than having its edges cut off or being squashed to fit." },
  { q: 'What happens if my music is shorter or longer than the slideshow?', a: "Shorter: it loops from the start until the slideshow ends. Longer: it's trimmed to match the video's length exactly, so it never plays past the last photo." },
  { q: 'Is anything uploaded?', a: 'No. Your photos and audio are read locally and the video is assembled entirely in this browser tab.' },
];
---

<Layout
  title="Photo Slideshow Maker With Music — Free, No Upload | Kit-Bin"
  description="Turn a set of photos into a video slideshow with background music, entirely in your browser. Nothing is uploaded."
>
  <ToolSchema name="Photo Slideshow Video" description="Turn photos into a video slideshow with optional background music, entirely in your browser, with no uploads." faqs={faqs} />
  <ToolHeader title="Turn Photos into a Slideshow Video" subtitle="Add photos, optionally add music, and download an MP4. Everything runs locally." />

  <div class="max-w-2xl mx-auto px-4 space-y-4">
    <div class="rounded-2xl border border-border-soft bg-surface p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between">
        <label class="text-sm font-semibold">Photos <span id="image-count" class="font-normal text-muted dark:text-slate-400"></span></label>
        <label for="image-input" class="cursor-pointer rounded-lg border border-border-soft px-3 py-1.5 text-xs font-medium dark:border-slate-700">Add photos</label>
      </div>
      <input id="image-input" type="file" accept="image/*" multiple class="hidden" />
      <div id="image-dropzone" class="mt-3 rounded-xl border border-dashed border-border-soft p-4 text-center text-sm text-muted transition-colors dark:border-slate-700 dark:text-slate-400">
        Drop photos here, or use "Add photos" above. Order shown is the order they'll play in.
      </div>
      <div id="image-grid" class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4"></div>
    </div>

    <div class="rounded-2xl border border-border-soft bg-surface p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-end gap-4">
        <div>
          <label for="duration" class="text-sm font-medium">Seconds per photo</label>
          <input id="duration" type="number" min="1" max="10" value="3" class="mt-2 block w-24 rounded-lg border border-border-soft bg-transparent p-2 text-sm dark:border-slate-700" />
        </div>
        <div class="flex-1 min-w-[200px]">
          <label class="text-sm font-medium">Background music <span class="font-normal text-muted dark:text-slate-400">(optional)</span></label>
          <div class="mt-2 flex items-center gap-2">
            <label for="audio-input" class="cursor-pointer rounded-lg border border-border-soft px-3 py-2 text-xs font-medium dark:border-slate-700">Choose audio</label>
            <input id="audio-input" type="file" accept="audio/*" class="hidden" />
            <span id="audio-name" class="text-xs text-muted dark:text-slate-400"></span>
            <button id="audio-clear" type="button" class="hidden text-xs text-muted underline decoration-dotted dark:text-slate-400">remove</button>
          </div>
        </div>
      </div>

      <button id="create-button" disabled class="mt-5 w-full rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:translate-y-0">
        Create Slideshow
      </button>
      <p id="message" role="status" class="mt-3 hidden rounded-xl px-4 py-3 text-sm"></p>

      <div id="output-wrap" class="mt-4 hidden text-center">
        <video id="output-video" controls class="mx-auto max-h-72 rounded-xl border border-border-soft dark:border-slate-700"></video>
        <a id="download-link" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5" download="kit-bin-slideshow.mp4">Download MP4</a>
      </div>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>Add a set of photos, set how long each one stays on screen, optionally pick a background track, then create the video. Everything — reading the photos, decoding the audio, encoding the MP4 — happens in this browser tab.</p>
    <div>
      <h2 class="tool-h2 text-lg font-semibold">Why there are limits on length and photo count</h2>
      <p class="mt-2 text-muted dark:text-slate-400">Encoding a video from images is real work for a browser tab to do without a server behind it. The caps (up to 40 photos, up to 3 minutes total) keep processing time and memory usage predictable on an ordinary laptop or phone rather than open-ended.</p>
    </div>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">
      Wondering why portrait photos get black bars instead of filling the frame? Read{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/photo-slideshow-video-specs">resolution, timing, and letterboxing in a slideshow video</a>.
    </p>
    <p class="text-sm">
      Related tools:{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/video/reverse">Reverse Video</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/video/boomerang">Boomerang Video</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/image/resize">Resize Image</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/image/crop">Crop Image</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:video/slideshow" />
  </div>

  <script>
    import { createSlideshow, MIN_SECONDS_PER_IMAGE, MAX_SECONDS_PER_IMAGE, MAX_IMAGES } from '../../lib/video/slideshow';

    const imageInput = document.querySelector<HTMLInputElement>('#image-input')!;
    const imageDropzone = document.querySelector<HTMLElement>('#image-dropzone')!;
    const imageGrid = document.querySelector<HTMLElement>('#image-grid')!;
    const imageCount = document.querySelector<HTMLElement>('#image-count')!;
    const durationInput = document.querySelector<HTMLInputElement>('#duration')!;
    const audioInput = document.querySelector<HTMLInputElement>('#audio-input')!;
    const audioName = document.querySelector<HTMLElement>('#audio-name')!;
    const audioClear = document.querySelector<HTMLButtonElement>('#audio-clear')!;
    const createButton = document.querySelector<HTMLButtonElement>('#create-button')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const outputWrap = document.querySelector<HTMLElement>('#output-wrap')!;
    const outputVideo = document.querySelector<HTMLVideoElement>('#output-video')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;

    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    let images: File[] = [];
    let audio: File | undefined;
    let objectUrls: string[] = [];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function revokeThumbnails() {
      objectUrls.forEach((url) => URL.revokeObjectURL(url));
      objectUrls = [];
    }

    function renderImages() {
      revokeThumbnails();
      imageGrid.replaceChildren();
      imageCount.textContent = images.length ? `(${images.length})` : '';
      images.forEach((file, index) => {
        const url = URL.createObjectURL(file);
        objectUrls.push(url);
        const wrap = document.createElement('div');
        wrap.className = 'group relative aspect-square overflow-hidden rounded-lg border border-border-soft dark:border-slate-700';
        wrap.innerHTML = `
          <img src="${url}" class="h-full w-full object-cover" alt="Photo ${index + 1}" />
          <button type="button" class="absolute right-1 top-1 hidden h-5 w-5 items-center justify-center rounded-full bg-black/60 text-xs text-white group-hover:flex" aria-label="Remove photo ${index + 1}">×</button>
        `;
        wrap.querySelector('button')!.addEventListener('click', () => {
          images.splice(index, 1);
          renderImages();
        });
        imageGrid.append(wrap);
      });
      createButton.disabled = images.length === 0;
    }

    function addImages(fileList: FileList | File[]) {
      const incoming = Array.from(fileList).filter((f) => f.type.startsWith('image/'));
      images = [...images, ...incoming].slice(0, MAX_IMAGES);
      renderImages();
    }

    imageInput.addEventListener('change', () => { if (imageInput.files) addImages(imageInput.files); imageInput.value = ''; });
    imageDropzone.addEventListener('dragover', (e) => { e.preventDefault(); imageDropzone.classList.add('border-primary'); });
    imageDropzone.addEventListener('dragleave', () => imageDropzone.classList.remove('border-primary'));
    imageDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      imageDropzone.classList.remove('border-primary');
      if (e.dataTransfer?.files) addImages(e.dataTransfer.files);
    });

    audioInput.addEventListener('change', () => {
      const file = audioInput.files?.[0];
      audioInput.value = '';
      if (!file) return;
      audio = file;
      audioName.textContent = file.name;
      audioClear.classList.remove('hidden');
    });
    audioClear.addEventListener('click', () => {
      audio = undefined;
      audioName.textContent = '';
      audioClear.classList.add('hidden');
    });

    createButton.addEventListener('click', async () => {
      if (images.length === 0) return;
      const seconds = Math.min(MAX_SECONDS_PER_IMAGE, Math.max(MIN_SECONDS_PER_IMAGE, Number(durationInput.value) || 3));
      durationInput.value = String(seconds);

      createButton.disabled = true;
      outputWrap.classList.add('hidden');
      showMessage('Starting…', true);

      try {
        const { blob, truncatedImages } = await createSlideshow(
          { images, secondsPerImage: seconds, audio },
          (text) => showMessage(text, true),
        );
        const url = URL.createObjectURL(blob);
        outputVideo.src = url;
        downloadLink.href = url;
        outputWrap.classList.remove('hidden');
        showMessage(
          truncatedImages
            ? `Done. Only the first ${images.length > MAX_IMAGES ? MAX_IMAGES : Math.floor(180 / seconds)} photos fit within the 3-minute cap at this duration.`
            : 'Slideshow created.',
          true,
        );
      } catch (error) {
        showMessage(`Could not create the slideshow: ${error instanceof Error ? error.message : 'unknown error'}`, false);
      } finally {
        createButton.disabled = images.length === 0;
      }
    });
  </script>
</Layout>
