---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Mute Video Online — Free & No Upload Required | Kit-Bin"
  description="Remove the audio track from a video in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Mute Video"
    description="Remove the audio track from a video in your browser. Your file is never uploaded to a server."
    faqs={[
    {
      "q": "Does this re-encode the video?",
      "a": "No — the video track is remuxed as-is, so this is fast even for large files."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Mute Video — Free</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="video/*" dropLabel="Drop a video file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-4">
    <p>This tool removes the audio track from a video, keeping the video itself unchanged.</p>
    <p>Drop your video above. The muted file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Does this re-encode the video?</p>
      <p class="text-muted dark:text-slate-400">No — the video track is remuxed as-is, so this is fast even for large files.</p>
    </div>
  </div>

  <script>
    import { muteVideo } from '../../lib/video/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'video/*',
      validate: (files) => (!files[0]?.type.startsWith('video/') ? 'This tool needs a video file.' : null),
      run: async (files) => {
        const blob = await muteVideo(files[0]);
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '-muted.mp4') };
      },
    });
  </script>
</Layout>
