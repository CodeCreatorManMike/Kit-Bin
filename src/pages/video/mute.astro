---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does this delete the audio, or replace it with silence?',
    a: "It removes the audio track entirely — the output file has no audio track at all, rather than a silent one. Some players show a shorter total duration display as a result, since there's nothing to read a track length from.",
  },
  {
    q: 'Does muting affect video quality?',
    a: "No — only the audio track is discarded. The video stream itself isn't touched.",
  },
  {
    q: 'What format is the output?',
    a: 'MP4, regardless of the input container.',
  },
];
---

<Layout
  title="Mute Video Online — Free & No Upload Required | Kit-Bin"
  description="Remove the audio track from a video in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Mute Video"
    description="Remove the audio track from a video in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Remove Audio from a Video</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="video/*" dropLabel="Drop a video file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-6">
    <p>This tool removes the audio track from a video, keeping the video itself unchanged. Drop your video above — the muted file downloads automatically once ready.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-slate-600 dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="text-sm">Need the opposite — just the audio? Try <a href="/video/extract-audio" class="text-blue-600 dark:text-blue-400 hover:underline">Extract Audio from Video</a>.</p>
  </div>

  <script>
    import { muteVideo } from '../../lib/video/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'video/*',
      validate: (files) => (!files[0]?.type.startsWith('video/') ? 'This tool needs a video file.' : null),
      run: async (files) => {
        const blob = await muteVideo(files[0]);
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '-muted.mp4') };
      },
    });
  </script>
</Layout>
