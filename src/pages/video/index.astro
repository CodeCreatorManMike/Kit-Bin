---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import CategorySchema from '../../components/CategorySchema.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { categoryColors, categoryIconPaths } from '../../data/toolIcons';

const videoTools = tools.filter((t) => t.category === 'video');
const meta = categoryColors.video;
---

<Layout title="Free Private Video Tools, Process Files Locally | Kit-Bin" description="Compress, trim, mute, convert, and extract audio from a video file without uploading it. Every tool runs entirely in your browser.">
  <CategorySchema categoryName="Video Tools" />
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div class="flex items-center gap-3">
      <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${meta.gradient} text-white shadow-lg shadow-black/10`}>
        <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d={categoryIconPaths.video} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-slate-100">Free Private Video Tools</h1>
    </div>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Compress a video for upload, trim a clip to a specific range, remove or extract its audio
      track, convert between MP4 and WebM, or turn a short clip into a GIF. Every tool below runs
      entirely in your browser. Your video is never uploaded anywhere. Large files may be slower
      on mobile devices due to memory limits.
    </p>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Not sure whether to pick MP4 or WebM? Read{' '}
      <a href="/guides/mp4-vs-webm" class="text-primary dark:text-blue-400 hover:underline">MP4 vs WebM: which one should you actually use?</a>
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {videoTools.map((t) => <ToolCard tool={t} />)}
    </div>

    <div class="pt-10 pb-2 sm:pt-10 sm:pb-2">
      <AdsterraBanner placement="video-category" />
    </div>
  </div>
</Layout>
