---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';

const videoTools = tools.filter((t) => t.category === 'video');
---

<Layout title="Free Video Tools | Kit-Bin" description="Convert, compress, and edit video files entirely in your browser.">
  <div class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Free Video Tools</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">All video tools run entirely in your browser. Files are never uploaded. Large files may be slow on mobile.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {videoTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
