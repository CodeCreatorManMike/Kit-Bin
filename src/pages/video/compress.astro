---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Will this affect quality?',
    a: "Yes, that's the tradeoff for a smaller file. The video and audio are both re-encoded at a lower quality setting. Try it on a copy first if quality matters.",
  },
  {
    q: 'Can I choose the target size, resolution, or bitrate?',
    a: "Not currently. This tool uses one fixed quality setting for video and audio rather than exposing target size, resolution, or bitrate as options. If you need a specific output size, you may need to try compressing more than once, or use dedicated video-editing software with manual bitrate control.",
  },
  {
    q: 'Why does compressing always change something, even a little?',
    a: "Video compression is lossy by nature. Reducing file size means throwing away some picture or audio detail the codec judges least noticeable. Resolution, frame rate, bitrate, and codec efficiency all trade off against file size; there's no way to shrink a file meaningfully without changing some of that data.",
  },
  {
    q: 'Does the output stay in the same container format?',
    a: 'The compressed file is always saved as MP4, regardless of the input container.',
  },
];
---

<Layout
  title="Compress Video Online, Free & No Upload Required | Kit-Bin"
  description="Shrink a video's file size in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Compress Video"
    description="Shrink a video's file size in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Compress a Video File" />

  <ToolWidget accept="video/*" dropLabel="Drop a video file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>This tool re-encodes a video's audio and video streams at a lower fixed quality to shrink its file size. Drop your video above. This re-encodes the full file, so larger videos take longer, especially on mobile.</p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
    <p class="text-sm">
      Want to understand what's actually being traded away? Read{' '}
      <a href="/guides/how-video-compression-works/" class="text-primary dark:text-blue-400 hover:underline">how video compression works</a>.
    </p>
    <p class="text-sm">Video too big to email? See why <a href="/guides/file-size-limits-email-and-upload/" class="text-primary dark:text-blue-400 hover:underline">"under the limit" isn't as simple as it looks</a>.</p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdBanner placement="tool-page:video/compress" />
  </div>

  <script>
    import { compressVideo } from '../../lib/video/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const els = getToolElements();
    wireTool(els, {
      accept: 'video/*',
      validate: (files) => (!files[0]?.type.startsWith('video/') ? 'This tool needs a video file.' : null),
      run: async (files) => {
        const blob = await compressVideo(files[0]);
        const note = `${formatBytes(files[0].size)} → ${formatBytes(blob.size)}`;
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '-compressed.mp4'), note };
      },
    });
  </script>
</Layout>
