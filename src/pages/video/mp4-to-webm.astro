---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Convert MP4 to WebM Online — Free & No Upload Required | Kit-Bin"
  description="Convert an MP4 video to WebM in your browser. Your file is never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Convert MP4 to WebM — Free</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="video/mp4,.mp4" dropLabel="Drop an MP4 file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-4">
    <p>This tool converts an MP4 video to the WebM format.</p>
    <p>Drop your MP4 above. The WebM file downloads automatically once ready — larger files take longer, especially on mobile.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Does this work on mobile?</p>
      <p class="text-slate-600 dark:text-slate-400">Yes, but large videos may be slow or use significant memory on phones — try a smaller file first if it stalls.</p>
    </div>
  </div>

  <script>
    import { convertContainer } from '../../lib/video/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'video/mp4,.mp4',
      validate: (files) => (!files[0]?.type.includes('mp4') ? 'This tool needs an MP4 file.' : null),
      run: async (files) => {
        const blob = await convertContainer(files[0], 'webm');
        return { blob, filename: files[0].name.replace(/\.mp4$/i, '.webm') };
      },
    });
  </script>
</Layout>
