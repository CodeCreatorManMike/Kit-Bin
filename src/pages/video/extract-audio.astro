---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Extract Audio from Video Online, Free & No Upload Required | Kit-Bin"
  description="Pull the audio track out of a video in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Extract Audio from Video"
    description="Pull the audio track out of a video in your browser. Your file is never uploaded to a server."
    faqs={[
    {
      "q": "What format is the output?",
      "a": "WebM audio, regardless of the input video format."
    },
    {
      "q": "Is this the same as converting the video to audio?",
      "a": "Not quite. This demuxes the existing audio track directly rather than decoding and re-encoding it, which is why it's fast. If you need a specific audio format like MP3, use the WebM output with an audio converter afterward."
    },
    {
      "q": "What can I use the extracted audio for?",
      "a": "Pulling the audio from an interview or podcast recording, saving a song from a music video file you already own, or getting a voice memo out of a screen recording."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Extract Audio from a Video File</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="video/*" dropLabel="Drop a video file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>This tool pulls the existing audio track out of a video file, discarding the video entirely.</p>
    <p>Drop your video above. The audio file downloads automatically once ready. This is one of the fastest tools on the site, since it copies the audio stream directly rather than decoding and re-encoding it.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        <div>
          <p class="font-medium">What format is the output?</p>
          <p class="text-muted dark:text-slate-400">WebM audio, regardless of the input video format.</p>
        </div>
        <div>
          <p class="font-medium">Is this the same as converting the video to audio?</p>
          <p class="text-muted dark:text-slate-400">Not quite. This demuxes the existing audio track directly rather than decoding and re-encoding it, which is why it's fast. If you need a specific audio format like MP3, use the WebM output with an audio converter afterward.</p>
        </div>
        <div>
          <p class="font-medium">What can I use the extracted audio for?</p>
          <p class="text-muted dark:text-slate-400">Pulling the audio from an interview or podcast recording, saving a song from a music video file you already own, or getting a voice memo out of a screen recording.</p>
        </div>
      </div>
    </div>
    <p class="text-sm">
      Need the video without the sound instead? Try
      <a href="/video/mute" class="text-primary dark:text-blue-400 hover:underline">Mute Video</a>.
    </p>
  </div>

  <script>
    import { extractAudio } from '../../lib/video/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'video/*',
      validate: (files) => (!files[0]?.type.startsWith('video/') ? 'This tool needs a video file.' : null),
      run: async (files) => {
        const blob = await extractAudio(files[0]);
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '.webm') };
      },
    });
  </script>
</Layout>
