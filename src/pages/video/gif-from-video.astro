---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Why is there a length/size cap?',
    a: "GIF is an inherently inefficient format for video. It stores every frame as a separate indexed-color image, so an uncapped conversion can produce a huge file for just a few seconds of footage. Output here is capped at 8 seconds, 480px wide, and 10fps to keep the result usable.",
  },
  {
    q: 'Will the colors look accurate?',
    a: 'GIF is limited to a 256-color palette per frame, so gradients, photos, and subtle color detail can show visible banding or dithering compared to the source video.',
  },
  {
    q: 'Does the GIF include audio?',
    a: "No. GIF has no audio support at all. This tool only converts the video's picture, not its sound.",
  },
  {
    q: 'Can I convert a longer clip by trimming it first?',
    a: 'Yes, use <a href="/video/trim" class="text-primary dark:text-blue-400 hover:underline">Trim Video</a> to cut down to the section you want before converting, since the cap applies to whatever you drop in.',
  },
];
---

<Layout
  title="Convert Video to GIF Online, Free & No Upload Required | Kit-Bin"
  description="Turn a video clip into a GIF in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert Video to GIF"
    description="Turn a video clip into a GIF in your browser. Your file is never uploaded to a server."
    faqs={faqs.map((f) => ({ q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Convert a Video Clip to GIF</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="video/*" dropLabel="Drop a video file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>This tool converts the first few seconds of a video into an animated GIF. Drop your video above. To keep the file size reasonable, output is capped at 8 seconds, 480px wide, 10fps.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-muted dark:text-slate-400" set:html={f.a} />
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    import { gifFromVideo } from '../../lib/video/gifFromVideo';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'video/*',
      validate: (files) => (!files[0]?.type.startsWith('video/') ? 'This tool needs a video file.' : null),
      run: async (files) => {
        const blob = await gifFromVideo(files[0]);
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '.gif') };
      },
    });
  </script>
</Layout>
