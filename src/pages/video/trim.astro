---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'What format is the output?',
    a: 'MP4, regardless of the input format.',
  },
  {
    q: 'Does trimming lose quality?',
    a: "The video and audio inside your chosen range are re-encoded during the trim, so there can be a small amount of quality change. This isn't a raw byte-copy cut. It's generally not noticeable at normal viewing sizes.",
  },
  {
    q: "Can I trim more than one section out of a video?",
    a: 'Not in one pass, this tool trims to a single continuous start and end time. To keep multiple separate sections, trim and download each section individually.',
  },
  {
    q: 'How precise is the start/end time?',
    a: 'Times are entered in seconds and can include decimals for finer control, but exact frame-accurate cuts are not guaranteed on every file.',
  },
];
---

<Layout
  title="Trim Video Online, Free & No Upload Required | Kit-Bin"
  description="Trim a video to a start and end time in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Trim Video"
    description="Trim a video to a start and end time in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Trim a Video to a Start and End Time" />

  <div class="max-w-2xl mx-auto px-4 mb-4 flex items-center justify-center gap-3 text-sm">
    <label for="start-time">Start (s):</label>
    <input id="start-time" type="number" value="0" min="0" class="w-20 rounded border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-2 py-1" />
    <label for="end-time">End (s):</label>
    <input id="end-time" type="number" value="10" min="0" class="w-20 rounded border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-2 py-1" />
  </div>

  <ToolWidget accept="video/*" dropLabel="Drop a video file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>This tool cuts a video down to the start and end time you specify. Set your times in seconds, then drop your video above.</p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:video/trim" />
  </div>

  <script>
    import { trimVideo } from '../../lib/video/convert';
    import { getToolElements, wireTool } from '../../lib/ui';

    const startInput = document.querySelector<HTMLInputElement>('#start-time')!;
    const endInput = document.querySelector<HTMLInputElement>('#end-time')!;
    const els = getToolElements();
    wireTool(els, {
      accept: 'video/*',
      validate: (files) => (!files[0]?.type.startsWith('video/') ? 'This tool needs a video file.' : null),
      run: async (files) => {
        const startRaw = parseFloat(startInput.value);
        const endRaw = parseFloat(endInput.value);
        const start = Number.isFinite(startRaw) && startRaw >= 0 ? startRaw : 0;
        const end = Number.isFinite(endRaw) && endRaw >= 0 ? endRaw : start + 10;
        if (end <= start) {
          throw new Error('End time must be after start time.');
        }
        const blob = await trimVideo(files[0], start, end);
        return { blob, filename: files[0].name.replace(/\.[^.]+$/, '-trimmed.mp4') };
      },
    });
  </script>
</Layout>
