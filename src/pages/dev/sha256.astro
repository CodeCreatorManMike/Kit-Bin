---
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is my file uploaded to create the hash?', a: 'No. The browser reads the selected file and calculates its SHA-256 digest locally. The file contents are not sent to Kit-Bin.' },
  { q: 'What is a SHA-256 checksum used for?', a: 'A checksum is a fixed fingerprint for a file. Compare it with the value published by a software vendor to check that a downloaded file has not changed.' },
  { q: 'Does a matching hash prove a file is safe?', a: 'No. It only proves that the bytes match the file used to create the expected hash. Get the expected value from a source you trust.' },
  { q: 'Can I hash a large file?', a: 'Usually, yes, but the full file must fit in browser memory for Web Crypto to process it. Very large files can be slow or exceed a mobile browser’s memory limit.' },
];
---

<Layout title="SHA-256 File Hash Generator, Private and Free | Kit-Bin" description="Create a SHA-256 checksum for any file in your browser. Verify downloads and compare hashes without uploading the file.">
  <ToolSchema name="SHA-256 File Hash Generator" description="Create a SHA-256 checksum locally in your browser without uploading the file." faqs={faqs} />
  <ToolHeader title="SHA-256 File Hash Generator" subtitle="Create a local SHA-256 checksum. Your file never leaves this browser." />

  <div class="max-w-3xl mx-auto px-4">
    <div id="drop-target" class="rounded-2xl border border-dashed border-border-soft bg-surface p-6 text-center shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900">
      <input id="file" type="file" class="hidden" />
      <label for="file" class="inline-flex cursor-pointer items-center rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5">Choose a file</label>
      <p class="mt-3 text-sm text-muted dark:text-slate-400">Or drop any file here. It is read locally to calculate its checksum.</p>
      <p id="file-name" class="mt-4 hidden text-sm font-medium text-ink dark:text-slate-100"></p>
      <p id="message" role="status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm"></p>
      <div id="output-wrap" class="mt-4 hidden text-left"><label for="output" class="text-sm font-medium">SHA-256 checksum</label><div class="mt-2 flex gap-2"><input id="output" readonly class="min-w-0 flex-1 rounded-lg border border-border-soft bg-transparent p-3 font-mono text-xs dark:border-slate-700" /><button id="copy" class="rounded-lg border border-border-soft px-4 text-sm font-medium dark:border-slate-700">Copy</button></div></div>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-3xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>A SHA-256 hash is a 64-character fingerprint calculated from every byte in a file. Use it to compare a download with the checksum published by its creator, or to record an exact version of a file before sharing it.</p>
    <div><h2 class="tool-h2 text-lg font-semibold">How to verify a downloaded file</h2><ol class="mt-2 list-decimal space-y-1 pl-5 text-muted dark:text-slate-400"><li>Find the SHA-256 value from the vendor’s official download page or signed release notes.</li><li>Select the downloaded file here.</li><li>Compare the two 64-character values exactly.</li><li>If they differ, do not assume the download is the expected file.</li></ol></div>
    <div><h2 class="tool-h2 text-lg font-semibold">What this does not prove</h2><p class="mt-2 text-muted dark:text-slate-400">A hash can check equality. It cannot prove that a file is safe, identify who created it, or replace a trusted signature. The expected hash must come from a source you already trust.</p></div>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">Need to compare structured configuration instead? Use <a class="text-primary hover:underline dark:text-blue-400" href="/dev/json-diff">JSON Diff</a>.</p>
  </div>

  <script>
    const fileInput = document.querySelector<HTMLInputElement>('#file')!;
    const dropTarget = document.querySelector<HTMLElement>('#drop-target')!;
    const fileName = document.querySelector<HTMLElement>('#file-name')!;
    const outputWrap = document.querySelector<HTMLElement>('#output-wrap')!;
    const output = document.querySelector<HTMLInputElement>('#output')!;
    const copyButton = document.querySelector<HTMLButtonElement>('#copy')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function toHex(buffer: ArrayBuffer): string {
      return [...new Uint8Array(buffer)].map((byte) => byte.toString(16).padStart(2, '0')).join('');
    }

    async function hashFile(file: File) {
      outputWrap.classList.add('hidden');
      if (!crypto.subtle) { showMessage('This browser does not expose the Web Crypto API needed for SHA-256.', false); return; }
      fileName.textContent = `${file.name} (${file.size.toLocaleString()} bytes)`;
      fileName.classList.remove('hidden');
      showMessage('Reading file and calculating SHA-256…', true);
      try {
        const bytes = await file.arrayBuffer();
        output.value = toHex(await crypto.subtle.digest('SHA-256', bytes));
        outputWrap.classList.remove('hidden');
        showMessage('SHA-256 checksum created locally.', true);
      } catch (error) {
        showMessage(`Could not calculate the hash: ${error instanceof Error ? error.message : 'Unknown error'}`, false);
      }
    }

    fileInput.addEventListener('change', () => { const file = fileInput.files?.[0]; if (file) hashFile(file); fileInput.value = ''; });
    dropTarget.addEventListener('dragover', (event) => { event.preventDefault(); dropTarget.classList.add('border-primary'); });
    dropTarget.addEventListener('dragleave', () => dropTarget.classList.remove('border-primary'));
    dropTarget.addEventListener('drop', (event) => { event.preventDefault(); dropTarget.classList.remove('border-primary'); const file = event.dataTransfer?.files?.[0]; if (file) hashFile(file); });
    copyButton.addEventListener('click', async () => { if (!output.value) return; try { await navigator.clipboard.writeText(output.value); showMessage('Checksum copied to clipboard.', true); } catch { output.select(); showMessage('Clipboard access was blocked. The checksum is selected, press Ctrl+C or Cmd+C.', false); } });
  </script>
</Layout>
