---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is the password sent anywhere?', a: 'No. It never leaves this browser tab — there is nothing to send it to. Nothing about it is logged, stored, or transmitted.' },
  { q: 'How is the randomness generated?', a: "With the Web Crypto API's crypto.getRandomValues(), a cryptographically secure random number generator built into the browser — not Math.random(), which is not designed to be unpredictable enough for secrets." },
  { q: 'What do the bits of entropy mean?', a: "It's a measure of how many possible passwords could have been generated with these settings — every extra bit doubles that number. Above roughly 60 bits, a random password is not the weak point in your security; reusing it or storing it insecurely is." },
  { q: 'Should I use the same generated password everywhere?', a: 'No. Generate a new one for each account and use a password manager to store them — a strong password that gets reused everywhere is only as safe as the single weakest place it gets typed into.' },
];

---

<Layout title="Random Password Generator — Strong & Secure | Kit-Bin" description="Generate a strong, cryptographically random password in your browser using the Web Crypto API. Nothing is sent to a server.">
  <ToolSchema name="Random Password Generator" description="Generate a cryptographically random password entirely in your browser, with no uploads." faqs={faqs} />
  <ToolHeader title="Random Password Generator" subtitle="Generate a strong random password locally, using the browser's secure random number generator." />

  <div class="max-w-2xl mx-auto px-4">
    <div class="rounded-2xl border border-border-soft bg-surface p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-2">
        <input id="output" readonly class="min-w-0 flex-1 rounded-lg border border-border-soft bg-transparent p-3 font-mono text-base dark:border-slate-700" />
        <button id="copy" class="shrink-0 rounded-lg border border-border-soft px-4 py-3 text-sm font-medium dark:border-slate-700">Copy</button>
        <button id="regenerate" class="shrink-0 rounded-lg bg-gradient-to-r from-primary to-violet-500 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25">New</button>
      </div>
      <p id="entropy" class="mt-2 text-xs text-muted dark:text-slate-400"></p>

      <div class="mt-5">
        <label for="length" class="flex items-center justify-between text-sm font-medium"><span>Length</span><span id="length-value">16</span></label>
        <input id="length" type="range" min="6" max="64" value="16" class="mt-2 w-full" />
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
        <label class="flex items-center gap-2"><input id="opt-upper" type="checkbox" checked class="rounded border-border-soft dark:border-slate-700" /> Uppercase (A-Z)</label>
        <label class="flex items-center gap-2"><input id="opt-lower" type="checkbox" checked class="rounded border-border-soft dark:border-slate-700" /> Lowercase (a-z)</label>
        <label class="flex items-center gap-2"><input id="opt-numbers" type="checkbox" checked class="rounded border-border-soft dark:border-slate-700" /> Numbers (0-9)</label>
        <label class="flex items-center gap-2"><input id="opt-symbols" type="checkbox" checked class="rounded border-border-soft dark:border-slate-700" /> Symbols (!@#…)</label>
        <label class="col-span-2 flex items-center gap-2"><input id="opt-ambiguous" type="checkbox" class="rounded border-border-soft dark:border-slate-700" /> Exclude ambiguous characters (l, 1, I, O, 0)</label>
      </div>

      <p id="message" role="status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm"></p>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>
      Adjust the length and character sets, and a new password generates automatically using your
      browser's cryptographically secure random number generator — the same kind used to generate
      encryption keys, not the predictable randomness behind <code>Math.random()</code> or most
      everyday code. Every character is drawn with rejection sampling to avoid the slight bias a
      naive modulo-based approach introduces, so the result is genuinely uniformly random across
      your chosen character set, not just random-looking.
    </p>
    <p>
      The entropy readout under the password tells you how many possible passwords could have been
      generated with your current settings — length and character-set size both matter, and each
      extra bit doubles that number. Above roughly 60 bits, a randomly generated password stops
      being the weak point in your security; reusing it across accounts or storing it insecurely
      matters far more than squeezing out a few more bits.
    </p>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">
      Want the actual math behind "strong"? Read{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/password-entropy-explained/">password entropy explained</a>.
      Curious exactly how the randomness is generated? See{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/password-generator-randomness/">how this generator gets its randomness</a>{' '}
      or, for the password you actually have to type yourself,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/passphrase-vs-random-password/">passphrase vs random password</a>.
    </p>
    <p class="text-sm">
      Already have a password and want to check its entropy instead of generating a new one? Use{' '}
      <a href="/dev/password-entropy-checker/" class="text-primary dark:text-blue-400 hover:underline">Password Entropy Checker</a>.
    </p>
    <p class="text-sm">
      Related tools:{' '}
      <a href="/dev/uuid-generator/" class="text-primary dark:text-blue-400 hover:underline">UUID Generator</a>,{' '}
      <a href="/dev/sha256/" class="text-primary dark:text-blue-400 hover:underline">SHA-256 Hash</a>,{' '}
      <a href="/dev/base64/" class="text-primary dark:text-blue-400 hover:underline">Base64 Encode/Decode</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:dev/password-generator" />
  </div>

  <script>
    const SYMBOL_CHARS = "!@#$%^&*()-_=+[]{};:,.<>?";

    const lengthInput = document.querySelector<HTMLInputElement>('#length')!;
    const lengthValue = document.querySelector<HTMLElement>('#length-value')!;
    const upper = document.querySelector<HTMLInputElement>('#opt-upper')!;
    const lower = document.querySelector<HTMLInputElement>('#opt-lower')!;
    const numbers = document.querySelector<HTMLInputElement>('#opt-numbers')!;
    const symbols = document.querySelector<HTMLInputElement>('#opt-symbols')!;
    const ambiguous = document.querySelector<HTMLInputElement>('#opt-ambiguous')!;
    const output = document.querySelector<HTMLInputElement>('#output')!;
    const entropyLabel = document.querySelector<HTMLElement>('#entropy')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const copyButton = document.querySelector<HTMLButtonElement>('#copy')!;
    const regenerateButton = document.querySelector<HTMLButtonElement>('#regenerate')!;

    const AMBIGUOUS = new Set(['l', '1', 'I', 'O', '0']);
    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function buildCharset(): string {
      let charset = '';
      if (upper.checked) charset += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if (lower.checked) charset += 'abcdefghijklmnopqrstuvwxyz';
      if (numbers.checked) charset += '0123456789';
      if (symbols.checked) charset += SYMBOL_CHARS;
      if (ambiguous.checked) charset = [...charset].filter((c) => !AMBIGUOUS.has(c)).join('');
      // De-duplicate in case ambiguous-character removal or overlapping sets
      // left repeats — each unique character should count once toward entropy.
      return [...new Set(charset)].join('');
    }

    function randomPassword(length: number, charset: string): string {
      // Plain modulo biases toward low character indices whenever
      // charset.length doesn't evenly divide 2^32 — reject draws that would
      // introduce that bias rather than accept it as "close enough" for a
      // tool whose entire job is generating unpredictable output.
      const limit = Math.floor(0x100000000 / charset.length) * charset.length;
      const draw = new Uint32Array(1);
      let result = '';
      while (result.length < length) {
        crypto.getRandomValues(draw);
        if (draw[0] >= limit) continue;
        result += charset[draw[0] % charset.length];
      }
      return result;
    }

    function generate(): void {
      const length = Number(lengthInput.value);
      const charset = buildCharset();
      if (!charset) {
        output.value = '';
        entropyLabel.textContent = '';
        showMessage('Select at least one character set.', false);
        return;
      }
      output.value = randomPassword(length, charset);
      const bits = Math.round(length * Math.log2(charset.length));
      entropyLabel.textContent = `${length} characters, ${charset.length}-character set, ~${bits} bits of entropy`;
      message.classList.add('hidden');
    }

    lengthInput.addEventListener('input', () => { lengthValue.textContent = lengthInput.value; generate(); });
    [upper, lower, numbers, symbols, ambiguous].forEach((el) => el.addEventListener('change', generate));
    regenerateButton.addEventListener('click', generate);
    copyButton.addEventListener('click', async () => {
      if (!output.value) return;
      try { await navigator.clipboard.writeText(output.value); showMessage('Password copied to clipboard.', true); }
      catch { output.select(); showMessage('Clipboard access was blocked. The password is selected, press Ctrl+C or Cmd+C.', false); }
    });

    generate();
  </script>
</Layout>
