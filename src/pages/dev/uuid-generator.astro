---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is a UUID sent anywhere when I generate it?', a: 'No. Every UUID here is generated in this browser tab using the Web Crypto API. Nothing is transmitted.' },
  { q: 'What is a UUID v4?', a: "A 128-bit identifier that's random rather than derived from a timestamp or hardware address (unlike v1) — the version used almost everywhere a unique ID is needed and privacy or unpredictability matters." },
  { q: 'How likely is a collision?', a: "For practical purposes, not going to happen: there are about 5.3 x 10^36 possible v4 UUIDs. You'd need to generate roughly a billion per second for about 100 years before a 50% chance of any two matching." },
  { q: 'Can I generate more than one at a time?', a: 'Yes, up to 1,000 at once — set the count and generate, then copy them all or download as a text file.' },
];
---

<Layout title="UUID Generator (v4), Free and Private | Kit-Bin" description="Generate random UUIDs (v4) in your browser, one at a time or in bulk. Nothing is sent to a server.">
  <ToolSchema name="UUID Generator" description="Generate random UUID v4 identifiers entirely in your browser, with no uploads." faqs={faqs} />
  <ToolHeader title="UUID Generator" subtitle="Generate random UUIDs (v4), one or in bulk, entirely in your browser." />

  <div class="max-w-2xl mx-auto px-4">
    <div class="rounded-2xl border border-border-soft bg-surface p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <label for="count" class="text-sm font-medium">How many</label>
          <input id="count" type="number" min="1" max="1000" value="1" class="mt-2 block w-24 rounded-lg border border-border-soft bg-transparent p-2 text-sm dark:border-slate-700" />
        </div>
        <label class="flex items-center gap-2 pb-2.5 text-sm"><input id="uppercase" type="checkbox" class="rounded border-border-soft dark:border-slate-700" /> Uppercase</label>
        <label class="flex items-center gap-2 pb-2.5 text-sm"><input id="hyphens" type="checkbox" checked class="rounded border-border-soft dark:border-slate-700" /> Hyphens</label>
        <button id="generate" class="ml-auto rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5">Generate</button>
      </div>

      <textarea id="output" readonly rows="10" spellcheck="false" class="mt-4 block w-full resize-y rounded-xl border border-border-soft bg-transparent p-3 font-mono text-sm dark:border-slate-700"></textarea>

      <div class="mt-3 flex flex-wrap gap-2">
        <button id="copy" class="rounded-lg border border-border-soft px-4 py-2 text-sm font-medium dark:border-slate-700">Copy all</button>
        <button id="download" class="rounded-lg border border-border-soft px-4 py-2 text-sm font-medium dark:border-slate-700">Download .txt</button>
      </div>
      <p id="message" role="status" class="mt-3 hidden rounded-xl px-4 py-3 text-sm"></p>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>Set how many UUIDs you need — one, or up to a thousand at once — and generate them locally using the browser's cryptographically secure random number generator.</p>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">Need a random password instead of an identifier? Use the <a class="text-primary hover:underline dark:text-blue-400" href="/dev/password-generator">Password Generator</a>.</p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:dev/uuid-generator" />
  </div>

  <script>
    const countInput = document.querySelector<HTMLInputElement>('#count')!;
    const uppercaseCheck = document.querySelector<HTMLInputElement>('#uppercase')!;
    const hyphensCheck = document.querySelector<HTMLInputElement>('#hyphens')!;
    const generateButton = document.querySelector<HTMLButtonElement>('#generate')!;
    const output = document.querySelector<HTMLTextAreaElement>('#output')!;
    const copyButton = document.querySelector<HTMLButtonElement>('#copy')!;
    const downloadButton = document.querySelector<HTMLButtonElement>('#download')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function formatUuid(uuid: string): string {
      let value = uuid;
      if (uppercaseCheck.checked) value = value.toUpperCase();
      if (!hyphensCheck.checked) value = value.replace(/-/g, '');
      return value;
    }

    function generate() {
      const count = Math.min(1000, Math.max(1, Math.round(Number(countInput.value) || 1)));
      countInput.value = String(count);
      const list = Array.from({ length: count }, () => formatUuid(crypto.randomUUID()));
      output.value = list.join('\n');
      message.classList.add('hidden');
    }

    generateButton.addEventListener('click', generate);
    countInput.addEventListener('change', generate);
    [uppercaseCheck, hyphensCheck].forEach((el) => el.addEventListener('change', generate));

    copyButton.addEventListener('click', async () => {
      if (!output.value) return;
      try { await navigator.clipboard.writeText(output.value); showMessage('Copied to clipboard.', true); }
      catch { output.select(); showMessage('Clipboard access was blocked. The text is selected, press Ctrl+C or Cmd+C.', false); }
    });
    downloadButton.addEventListener('click', () => {
      if (!output.value) return;
      const blob = new Blob([output.value + '\n'], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'kit-bin-uuids.txt';
      a.click();
      URL.revokeObjectURL(url);
    });

    generate();
  </script>
</Layout>
