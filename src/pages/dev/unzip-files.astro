---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does this support password-protected or encrypted ZIP files?',
    a: 'No. This tool only reads standard, unencrypted ZIP archives. If your ZIP is password-protected, it will fail to extract — there is no support for entering a password or decrypting the archive here.',
  },
  {
    q: 'How are nested folders inside the ZIP shown?',
    a: "As their full path, flattened into one list, rather than an expandable folder tree — a file that was in \"photos/2024/beach.jpg\" inside the archive is listed and downloaded under that same path, just not nested visually.",
  },
  {
    q: 'What happens if the ZIP file is corrupt?',
    a: "You'll get a clear error saying the file could not be read, rather than a silent failure or a partial, misleading file list. Try re-downloading or re-creating the ZIP and dropping it in again.",
  },
  {
    q: 'Is there a size limit?',
    a: "No fixed limit is enforced. Extraction happens in your browser's memory, so a very large archive (many gigabytes, or an unusually large number of files) may be slow or run out of memory, especially on a phone.",
  },
  {
    q: 'Are my files uploaded anywhere?',
    a: 'No. The ZIP is read and unpacked entirely in this browser tab. Nothing is sent to a server.',
  },
];
---

<Layout
  title="Extract Files From a ZIP Online, Free & No Upload Required | Kit-Bin"
  description="Unzip a ZIP archive and download the files inside, entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Extract Files From a ZIP Online"
    description="Unzip a ZIP archive and download the files inside, entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />
  <ToolHeader title="Extract Files From a ZIP Online" />

  <div class="max-w-2xl mx-auto px-4 space-y-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60"
    >
      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4" />
              <path d="M8 4h8" />
              <path d="M4 20V9a2 2 0 012-2h12a2 2 0 012 2v11" />
              <path d="M4 20h16" />
              <path d="M9 13l3 3 3-3" />
            </svg>
          </span>
        </span>
        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop a ZIP file here, or click to browse</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <p id="file-info" class="mt-2 text-sm font-medium text-primary dark:text-blue-400"></p>
        <input id="file-input" type="file" accept=".zip,application/zip,application/x-zip-compressed" class="hidden" />
      </div>
    </div>

    <p id="message" role="status" class="hidden rounded-xl px-4 py-3 text-sm max-w-2xl"></p>

    <div id="result-wrap" class="hidden rounded-2xl border border-border-soft bg-surface p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-sm font-semibold">Files in this archive <span id="result-count" class="font-normal text-muted dark:text-slate-400"></span></p>
      <ul id="result-list" class="mt-3 divide-y divide-border-soft dark:divide-slate-800"></ul>
      <button id="reset-button" class="mt-4 block w-full text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 hover:text-ink dark:hover:text-slate-200">
        Extract another ZIP
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>
      This tool unpacks a ZIP archive and lets you download each file inside it individually.
      Drop your .zip file above, and every file it contains shows up in a list with its path and
      size, each with its own download button.
    </p>
    <div>
      <h2 class="tool-h2 text-lg font-semibold">How it works</h2>
      <p class="mt-2 text-muted dark:text-slate-400">
        The archive is read and decompressed directly in this browser tab, then held in memory so
        you can download whichever files you actually need. There's no need to re-zip anything
        afterward, since the files are already separated out — just download the ones you want.
        Standard, unencrypted ZIP files are supported; password-protected archives are not.
      </p>
    </div>
    <div>
      <h2 class="tool-h2 text-lg font-semibold">FAQ</h2>
      <div class="mt-3"><FaqAccordion faqs={faqs} /></div>
    </div>
    <p class="text-sm">
      Related tools:{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/dev/zip-files/">Create a ZIP File</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/pdf/split/">Split PDF</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/data/csv-merge/">Merge CSV Files</a>.
    </p>
    <p class="text-sm">
      Curious what's actually happening when a file gets unzipped, and why so many "online unzip"
      sites quietly upload your archive first? Read{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/how-to-unzip-a-file-online/">how unzipping a file online actually works</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:dev/unzip-files" />
  </div>

  <script>
    import { extractZip } from '../../lib/dev/zipExtract';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const resultWrap = document.querySelector<HTMLElement>('#result-wrap')!;
    const resultList = document.querySelector<HTMLElement>('#result-list')!;
    const resultCount = document.querySelector<HTMLElement>('#result-count')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    let objectUrls: string[] = [];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    function revokeUrls() {
      objectUrls.forEach((url) => URL.revokeObjectURL(url));
      objectUrls = [];
    }

    function reset() {
      revokeUrls();
      resultWrap.classList.add('hidden');
      resultList.replaceChildren();
      message.classList.add('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      dropzone.classList.remove('hidden');
    }

    async function handleFile(file: File) {
      const isZip = file.name.toLowerCase().endsWith('.zip')
        || file.type === 'application/zip'
        || file.type === 'application/x-zip-compressed';
      if (!isZip) {
        showMessage('This tool needs a .zip file.', false);
        return;
      }

      fileInfo.textContent = `${file.name} (${formatBytes(file.size)})`;
      showMessage('Reading archive…', true);
      resultWrap.classList.add('hidden');

      try {
        const bytes = new Uint8Array(await file.arrayBuffer());
        const extracted = extractZip(bytes);

        if (extracted.length === 0) {
          showMessage('This ZIP file has no extractable files in it.', false);
          return;
        }

        revokeUrls();
        resultList.replaceChildren();
        resultCount.textContent = `(${extracted.length})`;

        extracted.forEach(({ path, blob }) => {
          const url = URL.createObjectURL(blob);
          objectUrls.push(url);
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between gap-3 py-2 text-sm';
          li.innerHTML = `
            <span class="truncate text-ink dark:text-slate-200" title="${path}">${path}</span>
            <span class="shrink-0 flex items-center gap-3">
              <span class="text-xs text-muted dark:text-slate-400">${formatBytes(blob.size)}</span>
              <a href="${url}" download="${path.split('/').pop()}" class="rounded-lg border border-border-soft px-3 py-1 text-xs font-medium text-primary hover:underline dark:border-slate-700 dark:text-blue-400">Download</a>
            </span>
          `;
          resultList.append(li);
        });

        resultWrap.classList.remove('hidden');
        message.classList.add('hidden');
        dropzone.classList.add('hidden');
      } catch (error) {
        showMessage(
          `Could not read this ZIP file: ${error instanceof Error ? error.message : 'it may be corrupt or password-protected'}.`,
          false,
        );
      }
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => { dropzone.dataset.dragging = 'false'; });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });
    resetButton.addEventListener('click', reset);
  </script>
</Layout>
