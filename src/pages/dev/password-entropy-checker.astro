---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is my password sent anywhere while I type it?', a: 'No. Everything is calculated in this browser tab as you type. Nothing about the password you enter here is logged, stored, or transmitted anywhere, including to Kit-Bin.' },
  { q: 'How is the entropy calculated?', a: 'Entropy in bits = length × log2(character-set size). The character-set size is based on which categories actually appear in what you typed (lowercase, uppercase, digits, symbols), not the maximum possible, so "password" and "PaSsWoRd" score differently even though they are the same length.' },
  { q: 'Why does the crack-time estimate look so different from what another site shows me?', a: "Crack-time estimates are only ever a rough order of magnitude, they depend entirely on an assumed guessing speed, which varies hugely by attack type (online vs. an offline hash dump) and hardware. This tool assumes a fast offline attack, roughly 10 billion guesses per second, and shows time to a 50% chance of a match, not a guarantee either way." },
  { q: 'Does a high entropy score mean this password is safe to use?', a: "Not by itself. This score only measures resistance to blind brute-force guessing. It says nothing about whether the exact password already appears in a leaked-password database, in which case entropy is irrelevant, it just gets tried directly. See the entropy guide below for why that matters." },
  { q: "Why doesn't this tool tell me if my password is 'good enough'?", a: "It reports the number, not a pass/fail judgment, because 'good enough' depends entirely on what the password protects. A rough guide: under 40 bits is weak, around 60 is a reasonable floor for a low-value account, 80 and up is the range to aim for on anything that matters, including your password manager." },
];
---

<Layout title="Password Entropy Checker — Real Bit-Entropy, Not a Strength Bar | Kit-Bin" description="Type a password and see its actual entropy in bits and a rough crack-time estimate, calculated locally. Nothing you type is sent anywhere.">
  <ToolSchema name="Password Entropy Checker" description="Check a password's real bit-entropy and rough crack-time entirely in your browser, with no uploads." faqs={faqs} />
  <ToolHeader title="Password Entropy Checker" subtitle="See the actual math behind how hard a password is to guess, calculated locally as you type." />

  <div class="max-w-2xl mx-auto px-4">
    <div class="rounded-2xl border border-border-soft bg-surface p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <label for="pw-input" class="text-sm font-medium">Password to check</label>
      <div class="mt-2 flex items-center gap-2">
        <input
          id="pw-input"
          type="password"
          autocomplete="off"
          spellcheck="false"
          placeholder="Type a password to check its entropy"
          class="min-w-0 flex-1 rounded-lg border border-border-soft bg-transparent p-3 font-mono text-base dark:border-slate-700"
        />
        <button id="toggle-visibility" type="button" class="shrink-0 rounded-lg border border-border-soft px-4 py-3 text-sm font-medium dark:border-slate-700">Show</button>
      </div>

      <div id="result" class="mt-5 hidden">
        <div class="flex items-baseline justify-between">
          <p id="bits-label" class="text-3xl font-bold text-ink dark:text-slate-100"></p>
          <p id="bucket-label" class="text-sm font-semibold"></p>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-app-bg dark:bg-slate-800">
          <div id="bits-bar" class="h-full rounded-full bg-gradient-to-r from-red-500 via-amber-500 to-emerald-500 transition-all duration-200" style="width: 0%"></div>
        </div>
        <p id="detail-label" class="mt-3 text-sm text-muted dark:text-slate-400"></p>
        <p id="crack-time-label" class="mt-1 text-sm text-muted dark:text-slate-400"></p>
      </div>
      <p id="empty-state" class="mt-5 text-sm text-muted dark:text-slate-500">Nothing typed yet — the entropy and crack-time estimate appear here as you type.</p>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>
      This tool runs the same formula the entropy guide below walks through, entropy in bits equals
      length times log2 of the character-set size, against whatever you actually type, live, in
      this browser tab. Nothing is uploaded, and nothing is stored once you navigate away.
    </p>
    <div>
      <h2 class="tool-h2 text-lg font-semibold">What the crack-time estimate assumes</h2>
      <p class="mt-2 text-muted dark:text-slate-400">
        The estimate assumes a fast offline attack against a hash dump, roughly 10 billion guesses
        per second on current consumer hardware, and reports the time to a 50% chance of a match
        across the full keyspace. An online login form that rate-limits attempts is far slower to
        attack than this, and a password already sitting in a leaked-credentials list is
        effectively instant to guess regardless of what this number says, see the FAQ below.
      </p>
    </div>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">
      Want the full derivation of this formula, with worked examples? Read{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/password-entropy-explained/">password entropy explained</a>.
      Need a password with a specific bit count instead of checking one you already have? Use{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/dev/password-generator/">Password Generator</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:dev/password-entropy-checker" />
  </div>

  <script>
    const input = document.querySelector<HTMLInputElement>('#pw-input')!;
    const toggleButton = document.querySelector<HTMLButtonElement>('#toggle-visibility')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const emptyState = document.querySelector<HTMLElement>('#empty-state')!;
    const bitsLabel = document.querySelector<HTMLElement>('#bits-label')!;
    const bucketLabel = document.querySelector<HTMLElement>('#bucket-label')!;
    const bitsBar = document.querySelector<HTMLElement>('#bits-bar')!;
    const detailLabel = document.querySelector<HTMLElement>('#detail-label')!;
    const crackTimeLabel = document.querySelector<HTMLElement>('#crack-time-label')!;

    const GUESSES_PER_SECOND = 1e10;

    function charsetSize(password: string): { size: number; parts: string[] } {
      let size = 0;
      const parts: string[] = [];
      if (/[a-z]/.test(password)) { size += 26; parts.push('lowercase'); }
      if (/[A-Z]/.test(password)) { size += 26; parts.push('uppercase'); }
      if (/[0-9]/.test(password)) { size += 10; parts.push('digits'); }
      if (/[^a-zA-Z0-9]/.test(password)) { size += 32; parts.push('symbols'); }
      return { size, parts };
    }

    function formatSeconds(seconds: number): string {
      if (!Number.isFinite(seconds)) return 'effectively never';
      const units: [string, number][] = [
        ['centuries', 60 * 60 * 24 * 365.25 * 100],
        ['years', 60 * 60 * 24 * 365.25],
        ['days', 60 * 60 * 24],
        ['hours', 60 * 60],
        ['minutes', 60],
        ['seconds', 1],
      ];
      for (const [label, size] of units) {
        if (seconds >= size) {
          const value = seconds / size;
          const formatted = value >= 1000 ? value.toExponential(1) : value.toFixed(value >= 10 ? 0 : 1);
          return `${formatted} ${label}`;
        }
      }
      return 'under a second';
    }

    function bucketFor(bits: number): { label: string; color: string } {
      if (bits < 40) return { label: 'Weak', color: 'text-red-500 dark:text-red-400' };
      if (bits < 60) return { label: 'Fair', color: 'text-amber-500 dark:text-amber-400' };
      if (bits < 80) return { label: 'Reasonable', color: 'text-amber-600 dark:text-amber-300' };
      if (bits < 100) return { label: 'Strong', color: 'text-emerald-600 dark:text-emerald-400' };
      return { label: 'Very strong', color: 'text-emerald-600 dark:text-emerald-400' };
    }

    function update(): void {
      const value = input.value;
      if (!value) {
        result.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }
      result.classList.remove('hidden');
      emptyState.classList.add('hidden');

      const { size, parts } = charsetSize(value);
      const bits = size > 0 ? value.length * Math.log2(size) : 0;
      const rounded = Math.round(bits);
      const bucket = bucketFor(bits);

      bitsLabel.textContent = `~${rounded} bits`;
      bucketLabel.textContent = bucket.label;
      bucketLabel.className = `text-sm font-semibold ${bucket.color}`;
      bitsBar.style.width = `${Math.min(100, (bits / 120) * 100)}%`;
      detailLabel.textContent = `${value.length} characters, using ${parts.join(' + ') || 'no recognized characters'} (~${size}-character set).`;

      // Average-case time to a 50% chance of a match is half the full keyspace.
      const seconds = Math.pow(2, bits) / 2 / GUESSES_PER_SECOND;
      crackTimeLabel.textContent = `Rough offline crack-time estimate: ${formatSeconds(seconds)}.`;
    }

    toggleButton.addEventListener('click', () => {
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      toggleButton.textContent = showing ? 'Show' : 'Hide';
    });

    input.addEventListener('input', update);
    update();
  </script>
</Layout>
