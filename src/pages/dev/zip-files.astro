---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is there a limit on how many files or how large a ZIP I can create?',
    a: "No fixed count, and no artificial file-size limit. This is just packaging bytes together, so the real ceiling is your browser tab's available memory, not a number Kit-Bin picks. A few dozen ordinary files or a couple of large ones both work fine; hundreds of very large files at once may slow down or run out of memory on a phone.",
  },
  {
    q: 'Does this actually compress the files, or just pack them together?',
    a: "It compresses. Unlike some of Kit-Bin's other tools that skip compression because their output is already a compressed format (PNG, JPG, PDF), this is a general-purpose \"zip whatever I drop in\" tool, and the files people drop here (documents, spreadsheets, code, text) are often genuinely compressible. So it runs standard deflate compression by default rather than just storing the raw bytes.",
  },
  {
    q: 'Are my files uploaded anywhere?',
    a: 'No. Every file is read and zipped directly in this browser tab. Nothing is sent to a server.',
  },
  {
    q: 'Can I zip a mix of file types together?',
    a: 'Yes. Any file type is accepted and they all go into the same archive — photos, PDFs, spreadsheets, whatever you drop in.',
  },
  {
    q: 'What happens if two files have the same name?',
    a: 'Kit-Bin keeps both. The second file is renamed with a "(2)" suffix so nothing gets silently overwritten inside the archive.',
  },
];
---

<Layout
  title="Create a ZIP File Online, Free & No Upload Required | Kit-Bin"
  description="Combine multiple files into one ZIP archive, compressed, entirely in your browser. Your files are never uploaded to a server."
>
  <ToolSchema
    name="Create a ZIP File Online"
    description="Combine multiple files into one ZIP archive, compressed, entirely in your browser. Your files are never uploaded to a server."
    faqs={faqs}
  />
  <ToolHeader title="Create a ZIP File Online" />

  <div class="max-w-2xl mx-auto px-4 space-y-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60"
    >
      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4" />
              <path d="M8 8l4-4 4 4" />
              <path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" />
            </svg>
          </span>
        </span>
        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop any files here, or click to browse</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <input id="file-input" type="file" accept="*/*" multiple class="hidden" />
      </div>
    </div>

    <div id="file-list-wrap" class="hidden rounded-2xl border border-border-soft bg-surface p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold">Files to zip <span id="file-count" class="font-normal text-muted dark:text-slate-400"></span></p>
        <label for="file-input-more" class="cursor-pointer rounded-lg border border-border-soft px-3 py-1.5 text-xs font-medium dark:border-slate-700">Add more</label>
        <input id="file-input-more" type="file" accept="*/*" multiple class="hidden" />
      </div>
      <ul id="file-list" class="mt-3 divide-y divide-border-soft dark:divide-slate-800"></ul>
    </div>

    <div id="options-wrap" class="hidden rounded-2xl border border-border-soft bg-surface p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <label for="zip-name" class="text-sm font-medium">Output file name</label>
      <input
        id="zip-name"
        type="text"
        value="kit-bin-files.zip"
        class="mt-2 block w-full rounded-lg border border-border-soft bg-transparent p-2 text-sm dark:border-slate-700"
      />

      <button id="create-button" disabled class="mt-5 w-full rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:translate-y-0">
        Create ZIP
      </button>
      <p id="message" role="status" class="mt-3 hidden rounded-xl px-4 py-3 text-sm"></p>

      <div id="output-wrap" class="hidden mt-4 text-center">
        <a id="download-link" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5">
          Download ZIP
        </a>
      </div>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>
      This tool packs any files you drop in into a single compressed ZIP archive, all in this
      browser tab. Drop or select as many files as you like, remove any you don't want, set a
      name for the output file, then click Create ZIP.
    </p>
    <div>
      <h2 class="tool-h2 text-lg font-semibold">How it works</h2>
      <p class="mt-2 text-muted dark:text-slate-400">
        Each file is read directly from disk and compressed with standard deflate compression,
        the same algorithm most ZIP tools use. Files that are already compressed (photos, PDFs,
        video) won't shrink much further, but text, code, and uncompressed documents typically
        come out noticeably smaller. Nothing is uploaded at any point — reading, compressing, and
        packaging all happen locally, and the resulting ZIP is handed straight back to you as a
        download.
      </p>
    </div>
    <div>
      <h2 class="tool-h2 text-lg font-semibold">FAQ</h2>
      <div class="mt-3"><FaqAccordion faqs={faqs} /></div>
    </div>
    <p class="text-sm">
      Related tools:{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/dev/unzip-files">Extract Files From a ZIP</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/pdf/merge">Merge PDF</a>,{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/data/csv-merge">Merge CSV Files</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:dev/zip-files" />
  </div>

  <script>
    import { createZip } from '../../lib/dev/zipCreate';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInputMore = document.querySelector<HTMLInputElement>('#file-input-more')!;
    const fileListWrap = document.querySelector<HTMLElement>('#file-list-wrap')!;
    const fileList = document.querySelector<HTMLElement>('#file-list')!;
    const fileCount = document.querySelector<HTMLElement>('#file-count')!;
    const optionsWrap = document.querySelector<HTMLElement>('#options-wrap')!;
    const zipNameInput = document.querySelector<HTMLInputElement>('#zip-name')!;
    const createButton = document.querySelector<HTMLButtonElement>('#create-button')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const outputWrap = document.querySelector<HTMLElement>('#output-wrap')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;

    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    let files: File[] = [];
    let activeUrl: string | null = null;

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    function renderList() {
      fileList.replaceChildren();
      fileCount.textContent = files.length ? `(${files.length})` : '';
      fileListWrap.classList.toggle('hidden', files.length === 0);
      optionsWrap.classList.toggle('hidden', files.length === 0);
      createButton.disabled = files.length === 0;

      files.forEach((file, index) => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 py-2 text-sm';
        li.innerHTML = `
          <span class="truncate text-ink dark:text-slate-200">${file.name}</span>
          <span class="shrink-0 flex items-center gap-3">
            <span class="text-xs text-muted dark:text-slate-400">${formatBytes(file.size)}</span>
            <button type="button" aria-label="Remove ${file.name}" class="text-muted hover:text-red-500 dark:text-slate-400">×</button>
          </span>
        `;
        li.querySelector('button')!.addEventListener('click', () => {
          files.splice(index, 1);
          renderList();
        });
        fileList.append(li);
      });
    }

    function addFiles(fileListInput: FileList | File[]) {
      files = [...files, ...Array.from(fileListInput)];
      outputWrap.classList.add('hidden');
      message.classList.add('hidden');
      renderList();
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => { dropzone.dataset.dragging = 'false'; });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files) addFiles(fileInput.files);
      fileInput.value = '';
    });
    fileInputMore.addEventListener('change', () => {
      if (fileInputMore.files) addFiles(fileInputMore.files);
      fileInputMore.value = '';
    });

    createButton.addEventListener('click', async () => {
      if (files.length === 0) return;
      const zipName = zipNameInput.value.trim() || 'kit-bin-files.zip';

      createButton.disabled = true;
      outputWrap.classList.add('hidden');
      showMessage('Starting…', true);

      try {
        const blob = await createZip(files, (text) => showMessage(text, true));
        if (activeUrl) URL.revokeObjectURL(activeUrl);
        activeUrl = URL.createObjectURL(blob);
        downloadLink.href = activeUrl;
        downloadLink.download = zipName;
        outputWrap.classList.remove('hidden');
        showMessage(`Done. ${formatBytes(blob.size)}.`, true);
      } catch (error) {
        showMessage(`Could not create the ZIP: ${error instanceof Error ? error.message : 'unknown error'}`, false);
      } finally {
        createButton.disabled = files.length === 0;
      }
    });
  </script>
</Layout>
