---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is the image uploaded to read the QR code?', a: 'No. The image is decoded in this browser tab — Kit-Bin never receives the file or whatever the code decodes to.' },
  { q: "Why didn't it find a QR code in my image?", a: "The code needs to be reasonably sharp, in-frame, and not too small relative to the photo. A blurry photo, an extreme angle, or a QR code that takes up only a tiny corner of a large image is the most common reason a real code doesn't get found." },
  { q: 'Does this work with a screenshot?', a: "Yes — a screenshot generally decodes better than a photo, since there's no blur, glare, or angle distortion to work around." },
  { q: "What if it decodes to a link?", a: "The decoded text is shown as plain text, and if it starts with http:// or https:// it's also shown as a clickable link. It never opens automatically." },
];
---

<Layout title="QR Code Scanner, Read a QR Code from an Image | Kit-Bin" description="Decode a QR code from an image file in your browser. Nothing you upload is sent to a server.">
  <ToolSchema name="QR Code Scanner" description="Decode a QR code from an image entirely in your browser, with no uploads." faqs={faqs} />
  <ToolHeader title="QR Code Scanner" subtitle="Read a QR code from an image file. Decoded locally, nothing is sent anywhere." />

  <div class="max-w-2xl mx-auto px-4">
    <div id="drop-target" class="rounded-2xl border border-dashed border-border-soft bg-surface p-6 text-center shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900">
      <input id="file" type="file" accept="image/*" class="hidden" />
      <label for="file" class="inline-flex cursor-pointer items-center rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5">Choose an image</label>
      <p class="mt-3 text-sm text-muted dark:text-slate-400">Or drop an image containing a QR code here.</p>
      <img id="preview" class="mx-auto mt-4 hidden max-h-48 rounded-xl border border-border-soft dark:border-slate-700" alt="" />
      <p id="message" role="status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm"></p>
      <div id="output-wrap" class="mt-4 hidden text-left">
        <label for="output" class="text-sm font-medium">Decoded text</label>
        <div class="mt-2 flex gap-2">
          <textarea id="output" readonly rows="3" class="min-w-0 flex-1 resize-y rounded-lg border border-border-soft bg-transparent p-3 font-mono text-xs dark:border-slate-700"></textarea>
          <button id="copy" class="h-fit rounded-lg border border-border-soft px-4 py-2 text-sm font-medium dark:border-slate-700">Copy</button>
        </div>
        <a id="output-link" href="#" target="_blank" rel="noopener noreferrer nofollow" class="mt-2 hidden text-sm text-primary hover:underline dark:text-blue-400">Open link ↗</a>
      </div>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>Drop an image containing a QR code — a screenshot, a photo of a poster, a saved code — and this tool reads it back into text or a link, entirely in your browser.</p>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">Need to make a QR code instead? Use the <a class="text-primary hover:underline dark:text-blue-400" href="/dev/qr-code-generator">QR Code Generator</a>.</p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:dev/qr-code-scanner" />
  </div>

  <script>
    import jsQR from 'jsqr';

    const fileInput = document.querySelector<HTMLInputElement>('#file')!;
    const dropTarget = document.querySelector<HTMLElement>('#drop-target')!;
    const preview = document.querySelector<HTMLImageElement>('#preview')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const outputWrap = document.querySelector<HTMLElement>('#output-wrap')!;
    const output = document.querySelector<HTMLTextAreaElement>('#output')!;
    const outputLink = document.querySelector<HTMLAnchorElement>('#output-link')!;
    const copyButton = document.querySelector<HTMLButtonElement>('#copy')!;
    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    async function scanFile(file: File) {
      outputWrap.classList.add('hidden');
      outputLink.classList.add('hidden');
      if (!file.type.startsWith('image/')) { showMessage('That file is not an image.', false); return; }

      const url = URL.createObjectURL(file);
      preview.src = url;
      preview.classList.remove('hidden');
      showMessage('Reading the image…', true);

      try {
        const bitmap = await createImageBitmap(file);
        const canvas = document.createElement('canvas');
        canvas.width = bitmap.width;
        canvas.height = bitmap.height;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(bitmap, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        bitmap.close();

        const result = jsQR(imageData.data, imageData.width, imageData.height);
        if (!result) {
          showMessage("No QR code found in this image. Try a clearer or closer photo.", false);
          return;
        }
        output.value = result.data;
        outputWrap.classList.remove('hidden');
        if (/^https?:\/\//i.test(result.data)) {
          outputLink.href = result.data;
          outputLink.textContent = `Open ${result.data.length > 60 ? result.data.slice(0, 60) + '…' : result.data} ↗`;
          outputLink.classList.remove('hidden');
        }
        showMessage('QR code decoded.', true);
      } catch (error) {
        showMessage(`Could not read this image: ${error instanceof Error ? error.message : 'unknown error'}`, false);
      }
    }

    fileInput.addEventListener('change', () => { const file = fileInput.files?.[0]; if (file) scanFile(file); fileInput.value = ''; });
    dropTarget.addEventListener('dragover', (event) => { event.preventDefault(); dropTarget.classList.add('border-primary'); });
    dropTarget.addEventListener('dragleave', () => dropTarget.classList.remove('border-primary'));
    dropTarget.addEventListener('drop', (event) => { event.preventDefault(); dropTarget.classList.remove('border-primary'); const file = event.dataTransfer?.files?.[0]; if (file) scanFile(file); });
    copyButton.addEventListener('click', async () => {
      if (!output.value) return;
      try { await navigator.clipboard.writeText(output.value); showMessage('Copied to clipboard.', true); }
      catch { output.select(); showMessage('Clipboard access was blocked. The text is selected, press Ctrl+C or Cmd+C.', false); }
    });
  </script>
</Layout>
