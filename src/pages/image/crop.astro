---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Crop Image Online, Free & No Upload Required | Kit-Bin"
  description="Crop an image to a custom selection. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Crop Image"
    description="Crop an image to a custom selection. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={[
    {
      "q": "Can I resize the crop selection?",
      "a": "Yes, drag the handles on any edge or corner of the selection box."
    },
    {
      "q": "What's the difference between cropping and resizing?",
      "a": "Cropping removes the pixels outside your selection. The remaining image keeps its original resolution. Resizing changes the overall dimensions of the whole image without removing anything. Use crop to cut out part of a photo; use resize to make the whole image smaller or larger."
    },
    {
      "q": "Does cropping affect image quality?",
      "a": "No, the kept portion of the image is exported as-is, at its original pixel density."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Crop an Image in Your Browser</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      class="cursor-pointer border-2 border-dashed border-border-soft dark:border-slate-700 rounded-xl p-12 text-center hover:border-primary/40 dark:hover:border-slate-500 transition-colors"
    >
      <p class="text-lg font-medium">Drop an image here or click to browse</p>
      <p id="file-info" class="mt-2 text-sm text-muted dark:text-slate-400"></p>
      <input id="file-input" type="file" accept="image/*" class="hidden" />
    </div>

    <div id="crop-panel" class="hidden mt-4">
      <div id="crop-host" class="max-h-[60vh] overflow-hidden rounded-xl border border-border-soft dark:border-slate-700"></div>
      <button id="crop-button" class="mt-3 rounded-lg bg-primary dark:bg-blue-500 px-6 py-3 text-white font-medium hover:bg-primary-hover dark:hover:bg-blue-600">
        Crop
      </button>
    </div>

    <p id="status" class="hidden mt-4 text-center text-sm text-muted dark:text-slate-400"></p>

    <div id="result" class="hidden mt-4 rounded-xl border border-border-soft dark:border-slate-700 p-6 text-center">
      <a
        id="download-link"
        class="inline-block rounded-lg bg-primary dark:bg-blue-500 px-6 py-3 text-white font-medium hover:bg-primary-hover dark:hover:bg-blue-600"
        >Download result</a
      >
      <p data-result-note class="mt-2 text-sm text-muted dark:text-slate-400"></p>
      <button id="reset-button" class="mt-4 text-sm text-muted dark:text-slate-400 underline hover:text-ink dark:hover:text-slate-200">
        Process another file
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>Drop your image above, drag the selection box to the area you want to keep, then click crop.</p>
    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        <div>
          <p class="font-medium">Can I resize the crop selection?</p>
          <p class="text-muted dark:text-slate-400">Yes, drag the handles on any edge or corner of the selection box.</p>
        </div>
        <div>
          <p class="font-medium">What's the difference between cropping and resizing?</p>
          <p class="text-muted dark:text-slate-400">Cropping removes the pixels outside your selection. The remaining image keeps its original resolution. Resizing changes the overall dimensions of the whole image without removing anything. Use crop to cut out part of a photo; use resize to make the whole image smaller or larger.</p>
        </div>
        <div>
          <p class="font-medium">Does cropping affect image quality?</p>
          <p class="text-muted dark:text-slate-400">No, the kept portion of the image is exported as-is, at its original pixel density.</p>
        </div>
      </div>
    </div>
    <p class="text-sm">
      Need to change the whole image's dimensions instead? Try
      <a href="/image/resize" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a>.
    </p>
  </div>

  <script>
    import Cropper from 'cropperjs';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const cropPanel = document.querySelector<HTMLElement>('#crop-panel')!;
    const cropHost = document.querySelector<HTMLElement>('#crop-host')!;
    const cropButton = document.querySelector<HTMLButtonElement>('#crop-button')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    let cropper: Cropper | null = null;
    let currentFile: File | null = null;

    function setStatus(msg: string | null) {
      status.textContent = msg ?? '';
      status.classList.toggle('hidden', !msg);
    }

    function handleFile(file: File) {
      if (!file.type.startsWith('image/')) {
        setStatus('This tool needs an image file.');
        return;
      }
      currentFile = file;
      fileInfo.textContent = file.name;

      cropHost.innerHTML = '';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.style.display = 'block';
      img.style.maxWidth = '100%';
      cropHost.appendChild(img);

      img.onload = () => {
        cropper = new Cropper(img, {});
        cropPanel.classList.remove('hidden');
        dropzone.classList.add('hidden');
      };
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-primary');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-primary'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-primary');
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    cropButton.addEventListener('click', async () => {
      if (!cropper || !currentFile) return;
      setStatus('Cropping…');
      try {
        const selection = cropper.getCropperSelection();
        const canvas = await selection!.$toCanvas();
        const type = currentFile.type || 'image/png';
        const blob: Blob = await new Promise((resolve, reject) =>
          canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Crop failed'))), type),
        );
        setStatus(null);
        const url = URL.createObjectURL(blob);
        downloadLink.href = url;
        downloadLink.download = currentFile.name;
        result.classList.remove('hidden');
        cropPanel.classList.add('hidden');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'Something went wrong.');
      }
    });

    resetButton.addEventListener('click', () => {
      currentFile = null;
      cropper = null;
      cropHost.innerHTML = '';
      result.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });
  </script>
</Layout>
