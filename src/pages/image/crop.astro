---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Can I resize the crop selection?',
    a: 'Yes, drag the handles on any edge or corner of the selection box.',
  },
  {
    q: "What's the difference between cropping and resizing?",
    a: 'Cropping removes the pixels outside your selection. The remaining image keeps its original resolution. Resizing changes the overall dimensions of the whole image without removing anything. Use crop to cut out part of a photo; use resize to make the whole image smaller or larger.',
  },
  {
    q: 'Does cropping affect image quality?',
    a: 'No, the kept portion of the image is exported as-is, at its original pixel density.',
  },
];
---

<Layout
  title="Crop Image Online, Free & No Upload Required | Kit-Bin"
  description="Crop an image to a custom selection. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Crop Image"
    description="Crop an image to a custom selection. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Crop an Image in Your Browser" />

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 hover:shadow-[0_10px_30px_rgba(16,24,47,0.08)] data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60 data-[dragging=true]:scale-[1.01] dark:data-[dragging=true]:bg-blue-950/30"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.06] via-transparent to-violet-500/[0.06] opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-data-[dragging=true]:opacity-100"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span
            class="absolute inset-0 rounded-full bg-primary/20 opacity-0 group-data-[dragging=true]:opacity-100 group-data-[dragging=true]:animate-pulse-ring"
            aria-hidden="true"></span>
          <span
            class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25 transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-3 group-data-[dragging=true]:scale-110"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4" />
              <path d="M8 8l4-4 4 4" />
              <path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" />
            </svg>
          </span>
        </span>

        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop an image here or click to browse</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <p id="file-info" class="mt-2 text-sm font-medium text-primary dark:text-blue-400"></p>
        <input id="file-input" type="file" accept="image/*" class="hidden" />
      </div>
    </div>

    <div id="crop-panel" class="hidden mt-4 rounded-2xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 p-5">
      <div id="crop-host" class="max-h-[60vh] overflow-hidden rounded-xl border border-border-soft dark:border-slate-700"></div>
      <button id="crop-button" class="mt-4 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]">
        Crop
      </button>
    </div>

    <div id="status" class="hidden mt-4" role="status" aria-live="polite">
      <div class="rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-4 py-3">
        <p data-status-text class="text-center text-sm font-medium text-ink dark:text-slate-200"></p>
        <div data-status-bar class="mt-2.5 h-1 overflow-hidden rounded-full bg-app-bg dark:bg-slate-800">
          <div class="h-full w-full animate-shimmer rounded-full" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div
      id="result"
      class="hidden mt-4 overflow-hidden rounded-2xl border border-emerald-300/70 dark:border-emerald-500/25 bg-gradient-to-br from-emerald-50 to-surface dark:from-emerald-950/25 dark:to-slate-900 p-6 text-center"
    >
      <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path class="animate-draw-check" d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <p class="mt-2.5 font-semibold text-ink dark:text-slate-100">Done</p>
      <p data-result-note class="mt-0.5 text-sm text-muted dark:text-slate-400"></p>

      <a
        id="download-link"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v12" />
          <path d="M8 12l4 4 4-4" />
          <path d="M4 20h16" />
        </svg>
        Download result
      </a>

      <button id="reset-button" class="mt-4 block w-full text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 transition-colors hover:text-ink dark:hover:text-slate-200">
        Process another file
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>Drop your image above, drag the selection box to the area you want to keep, then click crop.</p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
    <p class="text-sm">
      Need to change the whole image's dimensions instead? Try{' '}
      <a href="/image/resize/" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a>.
    </p>
    <p class="text-sm">
      Cropping for a specific print size? See{' '}
      <a href="/guides/dpi-ppi-print-size-explained/" class="text-primary dark:text-blue-400 hover:underline">how DPI/PPI determines the pixels you need</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdBanner placement="tool-page:image/crop" />
  </div>

  <script>
    import Cropper from 'cropperjs';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const cropPanel = document.querySelector<HTMLElement>('#crop-panel')!;
    const cropHost = document.querySelector<HTMLElement>('#crop-host')!;
    const cropButton = document.querySelector<HTMLButtonElement>('#crop-button')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    let cropper: Cropper | null = null;
    let currentFile: File | null = null;
    let previewObjectUrl: string | null = null;
    let activeObjectUrl: string | null = null;

    const statusText = status.querySelector<HTMLElement>('[data-status-text]')!;
    const statusBar = status.querySelector<HTMLElement>('[data-status-bar]')!;

    function setStatus(msg: string | null, isError = false) {
      statusText.textContent = msg ?? '';
      status.classList.toggle('hidden', !msg);
      statusBar.classList.toggle('hidden', isError);
      statusText.classList.toggle('text-red-600', isError);
      statusText.classList.toggle('dark:text-red-400', isError);
    }

    function handleFile(file: File) {
      if (!file.type.startsWith('image/')) {
        setStatus('This tool needs an image file.', true);
        return;
      }
      currentFile = file;
      fileInfo.textContent = file.name;

      if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
      cropHost.innerHTML = '';
      const img = document.createElement('img');
      previewObjectUrl = URL.createObjectURL(file);
      img.src = previewObjectUrl;
      img.style.display = 'block';
      img.style.maxWidth = '100%';
      cropHost.appendChild(img);

      img.onload = () => {
        cropper = new Cropper(img, {});
        cropPanel.classList.remove('hidden');
        dropzone.classList.add('hidden');

        // Cropper.js v2 has no sensible built-in default here — left alone,
        // the initial selection box renders as a small, awkwardly-shaped
        // sliver that's genuinely hard to find and grab, especially on a
        // touchscreen. requestAnimationFrame waits for the custom elements
        // to actually lay out before reading real pixel dimensions from
        // them; reading synchronously here can return a zero-size rect.
        requestAnimationFrame(() => {
          const canvas = cropper?.getCropperCanvas();
          const selection = cropper?.getCropperSelection();
          if (!canvas || !selection) return;
          const rect = canvas.getBoundingClientRect();
          if (rect.width === 0 || rect.height === 0) return;
          const coverage = 0.8;
          const w = rect.width * coverage;
          const h = rect.height * coverage;
          selection.$change((rect.width - w) / 2, (rect.height - h) / 2, w, h);
        });
      };
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.dataset.dragging = 'false';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    cropButton.addEventListener('click', async () => {
      if (!cropper || !currentFile) return;
      setStatus('Cropping…');
      try {
        const selection = cropper.getCropperSelection();
        const canvas = await selection!.$toCanvas();
        const type = currentFile.type || 'image/png';
        const blob: Blob = await new Promise((resolve, reject) =>
          canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Crop failed'))), type),
        );
        setStatus(null);
        if (activeObjectUrl) URL.revokeObjectURL(activeObjectUrl);
        const url = URL.createObjectURL(blob);
        activeObjectUrl = url;
        downloadLink.href = url;
        downloadLink.download = currentFile.name;
        result.classList.remove('hidden');
        result.classList.remove('animate-pop-in');
        void result.offsetWidth;
        result.classList.add('animate-pop-in');
        cropPanel.classList.add('hidden');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
      }
    });

    resetButton.addEventListener('click', () => {
      currentFile = null;
      cropper = null;
      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
        previewObjectUrl = null;
      }
      if (activeObjectUrl) {
        URL.revokeObjectURL(activeObjectUrl);
        activeObjectUrl = null;
      }
      cropHost.innerHTML = '';
      result.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });
  </script>
</Layout>
