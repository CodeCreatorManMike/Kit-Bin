---
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Why convert to WebP?',
    a: 'WebP is typically smaller than PNG at similar visual quality, which matters for website load times. Actual savings depend heavily on image content. Flat-color graphics and screenshots often shrink a lot; photographic PNGs shrink the most.',
  },
  {
    q: 'Is the conversion lossy or lossless?',
    a: 'This tool encodes WebP at a lossy quality setting by default, trading a small amount of visual detail for a smaller file. If your PNG needs to stay pixel-perfect, keep it as PNG instead.',
  },
  {
    q: 'Will WebP work everywhere I need it to?',
    a: "All modern browsers support WebP, but some older software, email clients, and design tools still don't. If broad compatibility matters more than file size, keep a PNG or JPG fallback available.",
  },
];
---

<Layout
  title="PNG to WebP Converter for Smaller Web Images | Kit-Bin"
  description="Convert a PNG image to WebP in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert PNG to WebP"
    description="Convert a PNG image to WebP in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Convert PNG Images to WebP" />

  <ToolWidget accept="image/png" dropLabel="Drop a PNG image here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Convert a PNG image to WebP for a smaller website asset. This is a lossy conversion by
      default. It trades a bit of visual detail for a meaningfully smaller file, which is the
      right trade for most web images but not for source files you'll keep editing.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">Not sure which format you actually need? <a href="/guides/webp-vs-png-jpg" class="text-primary dark:text-blue-400 hover:underline">Read the comparison</a></p>
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/png',
      validate: (files) => (files[0]?.type !== 'image/png' ? 'This tool needs a PNG file.' : null),
      run: async (files) => {
        const blob = await convertImageFormat(files[0], 'image/webp');
        return { blob, filename: files[0].name.replace(/\.png$/i, '.webp') };
      },
    });
  </script>
</Layout>
