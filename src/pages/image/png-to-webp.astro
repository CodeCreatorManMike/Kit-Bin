---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Convert PNG to WebP Online — Free & No Upload Required | ToolKit"
  description="Convert a PNG image to WebP in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold">Convert PNG to WebP — Free</h1>
    <p class="mt-2 text-slate-600">Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="image/png" dropLabel="Drop a PNG image here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 space-y-4">
    <p>This tool converts a PNG image into a smaller WebP file.</p>
    <p>Drop your PNG image above. The WebP file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Why convert to WebP?</p>
      <p class="text-slate-600">WebP is typically 25-35% smaller than PNG at similar visual quality.</p>
    </div>
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/png',
      validate: (files) => (files[0]?.type !== 'image/png' ? 'This tool needs a PNG file.' : null),
      run: async (files) => {
        const blob = await convertImageFormat(files[0], 'image/webp');
        return { blob, filename: files[0].name.replace(/\.png$/i, '.webp') };
      },
    });
  </script>
</Layout>
