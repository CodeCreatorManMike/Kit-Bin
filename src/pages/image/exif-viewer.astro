---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is my photo uploaded anywhere to read this?',
    a: 'No. The file is read entirely in this browser tab using a JavaScript library that parses the file structure locally. Kit-Bin never receives the file, and nothing about it is sent anywhere.',
  },
  {
    q: 'Why does my photo show no GPS data?',
    a: "Most likely one of two things: the app that saved or shared the file already stripped its metadata (very common for photos re-saved from social media, messaging apps, or screenshots), or location services were off for the camera app when the photo was taken. Either way, no GPS data means none was found in this file, not that the tool failed to look.",
  },
  {
    q: 'Can I remove this data instead of just viewing it?',
    a: 'Yes. <a href="/image/remove-metadata/" class="text-primary dark:text-blue-400 hover:underline">Remove Image Metadata</a> strips EXIF, GPS, XMP, and comment data from a JPEG or PNG without re-encoding it, so the pixels are unchanged.',
  },
  {
    q: 'Does this work on HEIC or iPhone photos?',
    a: "Yes, HEIC files carry EXIF and GPS data the same way JPEGs do, and this tool reads it directly from the HEIC file. If you want a JPEG copy afterward, use <a href=\"/image/heic-to-jpg\" class=\"text-primary dark:text-blue-400 hover:underline\">HEIC to JPG</a>.",
  },
  {
    q: 'What if the file has no metadata at all?',
    a: "That's a normal result, not an error. Many web-downloaded, re-saved, or social-media images have had their metadata stripped already, and some formats never carry it in the first place.",
  },
];
---

<Layout
  title="View Photo EXIF & GPS Data Online, Free & Private | Kit-Bin"
  description="See the camera, exposure, timestamp, and GPS location hidden inside a photo file. Runs entirely in your browser — your photo is never uploaded to a server."
>
  <ToolSchema
    name="EXIF & GPS Metadata Viewer"
    description="See the camera, exposure, timestamp, and GPS location hidden inside a photo file. Runs entirely in your browser."
    faqs={faqs}
  />

  <ToolHeader title="View EXIF and GPS Data in a Photo" />

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 hover:shadow-[0_10px_30px_rgba(16,24,47,0.08)] data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60 data-[dragging=true]:scale-[1.01] dark:data-[dragging=true]:bg-blue-950/30"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.06] via-transparent to-violet-500/[0.06] opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-data-[dragging=true]:opacity-100"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span
            class="absolute inset-0 rounded-full bg-primary/20 opacity-0 group-data-[dragging=true]:opacity-100 group-data-[dragging=true]:animate-pulse-ring"
            aria-hidden="true"></span>
          <span
            class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25 transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-3 group-data-[dragging=true]:scale-110"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <circle cx="9" cy="11" r="2.2" />
              <path d="M3 17l5-4 4 3 3-2 6 5" />
            </svg>
          </span>
        </span>

        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop a photo here or click to browse</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <p id="file-info" class="mt-2 text-sm font-medium text-primary dark:text-blue-400"></p>
        <input id="file-input" type="file" accept="image/*" class="hidden" />
      </div>
    </div>

    <div id="status" class="hidden mt-4" role="status" aria-live="polite">
      <div class="rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-4 py-3">
        <p data-status-text class="text-center text-sm font-medium text-ink dark:text-slate-200"></p>
        <div data-status-bar class="mt-2.5 h-1 overflow-hidden rounded-full bg-app-bg dark:bg-slate-800">
          <div class="h-full w-full animate-shimmer rounded-full" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div id="result-panel" class="hidden mt-4 space-y-4">
      <p id="result-heading" class="font-semibold text-ink dark:text-slate-100"></p>

      <div id="empty-note" class="hidden rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-5 py-6 text-center">
        <p class="font-medium text-ink dark:text-slate-100">No hidden metadata found in this file.</p>
        <p class="mt-1 text-sm text-muted dark:text-slate-400">Either it was stripped already, or this file's format doesn't carry EXIF data. That's a good sign, not a broken result.</p>
      </div>

      <div id="section-gps" class="hidden rounded-xl border border-amber-400/60 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-500/40 px-5 py-4">
        <p class="font-medium text-amber-900 dark:text-amber-200">Location</p>
        <p id="gps-coords" class="mt-1 text-sm text-amber-900 dark:text-amber-200 font-mono"></p>
        <a id="gps-link" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-primary dark:text-blue-400 hover:underline">
          Open this location in Google Maps
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
        <p class="mt-2 text-xs text-amber-800/80 dark:text-amber-300/70">This link opens in a new tab only if you click it — nothing is loaded automatically.</p>
      </div>

      <div id="section-camera" class="hidden rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-5 py-4">
        <p class="font-medium text-ink dark:text-slate-100">Camera</p>
        <dl id="camera-list" class="mt-2 space-y-1 text-sm text-muted dark:text-slate-400"></dl>
      </div>

      <div id="section-timestamps" class="hidden rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-5 py-4">
        <p class="font-medium text-ink dark:text-slate-100">Timestamps</p>
        <dl id="timestamps-list" class="mt-2 space-y-1 text-sm text-muted dark:text-slate-400"></dl>
      </div>

      <div id="section-dimensions" class="hidden rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-5 py-4">
        <p class="font-medium text-ink dark:text-slate-100">Image</p>
        <dl id="dimensions-list" class="mt-2 space-y-1 text-sm text-muted dark:text-slate-400"></dl>
      </div>

      <div id="section-other" class="hidden rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-5 py-4">
        <p class="font-medium text-ink dark:text-slate-100">Other data</p>
        <dl id="other-list" class="mt-2 space-y-1 text-sm text-muted dark:text-slate-400 max-h-64 overflow-y-auto pr-1"></dl>
      </div>

      <div class="rounded-xl border border-primary/30 bg-primary-tint/40 dark:border-blue-500/30 dark:bg-blue-950/30 px-5 py-4 flex flex-col sm:flex-row sm:items-center gap-3">
        <p class="text-sm text-ink dark:text-slate-200 flex-1">Want to strip this before sharing?</p>
        <a href="/image/remove-metadata/" class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-2.5 text-sm font-medium text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 whitespace-nowrap">
          Use Remove Image Metadata
        </a>
      </div>

      <button id="reset-button" class="block w-full text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 transition-colors hover:text-ink dark:hover:text-slate-200">
        Check another photo
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Drop a photo above and this tool reads its EXIF metadata: the hidden block of data most
      image files carry alongside the actual pixels. That can include the camera or phone make
      and model, the lens and exposure settings used, the exact date and time the photo was
      taken, and, if location services were on, the GPS coordinates of where it was shot. None of
      it is visible when you just look at the picture, but it is readable by plenty of software
      the moment someone opens the file. Read more about what this means for privacy in{' '}
      <a href="/guides/exif-gps-photo-privacy/" class="text-primary dark:text-blue-400 hover:underline">what your photos are telling people</a>.
    </p>
    <p>
      This is a read-only viewer, not an editor. It parses the file's structure locally in this
      browser tab and shows you what it finds; it never modifies, re-encodes, or uploads the
      file. If you'd rather strip this data out before sharing the photo, use{' '}
      <a href="/image/remove-metadata/" class="text-primary dark:text-blue-400 hover:underline">Remove Image Metadata</a>{' '}
      instead — that tool rebuilds the file without its metadata, byte for byte, with no quality
      loss.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Related tools:{' '}
      <a href="/image/remove-metadata/" class="text-primary dark:text-blue-400 hover:underline">Remove Image Metadata</a>,{' '}
      <a href="/image/heic-to-jpg/" class="text-primary dark:text-blue-400 hover:underline">HEIC to JPG</a>,{' '}
      <a href="/image/compress/" class="text-primary dark:text-blue-400 hover:underline">Compress Image</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:image/exif-viewer" />
  </div>

  <script>
    import { readMetadata, type ExifResult } from '../../lib/image/exifViewer';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const statusText = status.querySelector<HTMLElement>('[data-status-text]')!;
    const statusBar = status.querySelector<HTMLElement>('[data-status-bar]')!;

    const resultPanel = document.querySelector<HTMLElement>('#result-panel')!;
    const resultHeading = document.querySelector<HTMLElement>('#result-heading')!;
    const emptyNote = document.querySelector<HTMLElement>('#empty-note')!;

    const sectionGps = document.querySelector<HTMLElement>('#section-gps')!;
    const gpsCoords = document.querySelector<HTMLElement>('#gps-coords')!;
    const gpsLink = document.querySelector<HTMLAnchorElement>('#gps-link')!;

    const sectionCamera = document.querySelector<HTMLElement>('#section-camera')!;
    const cameraList = document.querySelector<HTMLElement>('#camera-list')!;

    const sectionTimestamps = document.querySelector<HTMLElement>('#section-timestamps')!;
    const timestampsList = document.querySelector<HTMLElement>('#timestamps-list')!;

    const sectionDimensions = document.querySelector<HTMLElement>('#section-dimensions')!;
    const dimensionsList = document.querySelector<HTMLElement>('#dimensions-list')!;

    const sectionOther = document.querySelector<HTMLElement>('#section-other')!;
    const otherList = document.querySelector<HTMLElement>('#other-list')!;

    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    function setStatus(message: string | null, isError = false) {
      statusText.textContent = message ?? '';
      status.classList.toggle('hidden', !message);
      statusBar.classList.toggle('hidden', isError);
      statusText.classList.toggle('text-red-600', isError);
      statusText.classList.toggle('dark:text-red-400', isError);
    }

    function renderList(container: HTMLElement, pairs: [string, string][]) {
      container.innerHTML = '';
      for (const [label, value] of pairs) {
        const row = document.createElement('div');
        row.className = 'flex gap-2';
        const dt = document.createElement('dt');
        dt.className = 'shrink-0 font-medium text-ink dark:text-slate-200';
        dt.textContent = `${label}:`;
        const dd = document.createElement('dd');
        dd.className = 'break-words';
        dd.textContent = value;
        row.append(dt, dd);
        container.appendChild(row);
      }
    }

    function renderResult(file: File, data: ExifResult) {
      resultHeading.textContent = data.hasData
        ? `${file.name}: metadata found`
        : `${file.name}: no metadata found`;

      emptyNote.classList.toggle('hidden', data.hasData);

      if (data.gps) {
        gpsCoords.textContent = `${data.gps.latitude.toFixed(6)}, ${data.gps.longitude.toFixed(6)}`;
        gpsLink.href = data.gps.mapUrl;
        sectionGps.classList.remove('hidden');
      } else {
        sectionGps.classList.add('hidden');
      }

      if (data.camera) {
        const pairs: [string, string][] = [];
        if (data.camera.make) pairs.push(['Make', data.camera.make]);
        if (data.camera.model) pairs.push(['Model', data.camera.model]);
        if (data.camera.lens) pairs.push(['Lens', data.camera.lens]);
        if (data.camera.aperture) pairs.push(['Aperture', data.camera.aperture]);
        if (data.camera.shutterSpeed) pairs.push(['Shutter speed', data.camera.shutterSpeed]);
        if (data.camera.iso) pairs.push(['ISO', data.camera.iso]);
        if (data.camera.focalLength) pairs.push(['Focal length', data.camera.focalLength]);
        renderList(cameraList, pairs);
        sectionCamera.classList.remove('hidden');
      } else {
        sectionCamera.classList.add('hidden');
      }

      if (data.timestamps) {
        const pairs: [string, string][] = [];
        if (data.timestamps.dateTaken) pairs.push(['Date taken', data.timestamps.dateTaken]);
        if (data.timestamps.dateModified) pairs.push(['Date modified', data.timestamps.dateModified]);
        renderList(timestampsList, pairs);
        sectionTimestamps.classList.remove('hidden');
      } else {
        sectionTimestamps.classList.add('hidden');
      }

      if (data.dimensions || data.software) {
        const pairs: [string, string][] = [];
        if (data.dimensions?.width && data.dimensions?.height) {
          pairs.push(['Dimensions', `${data.dimensions.width} × ${data.dimensions.height}px`]);
        }
        if (data.dimensions?.orientation) pairs.push(['Orientation', data.dimensions.orientation]);
        if (data.software) pairs.push(['Software', data.software]);
        renderList(dimensionsList, pairs);
        sectionDimensions.classList.remove('hidden');
      } else {
        sectionDimensions.classList.add('hidden');
      }

      const otherEntries = Object.entries(data.other);
      if (otherEntries.length) {
        renderList(otherList, otherEntries);
        sectionOther.classList.remove('hidden');
      } else {
        sectionOther.classList.add('hidden');
      }

      fileInfo.textContent = `${file.name} (${formatBytes(file.size)})`;
      resultPanel.classList.remove('hidden');
      dropzone.classList.add('hidden');
    }

    async function handleFile(file: File) {
      if (!file.type.startsWith('image/')) {
        setStatus('This tool needs an image file.', true);
        return;
      }
      setStatus('Reading metadata…');
      try {
        const data = await readMetadata(file);
        setStatus(null);
        renderResult(file, data);
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'This file could not be read.', true);
      }
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.dataset.dragging = 'false';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    resetButton.addEventListener('click', () => {
      resultPanel.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });
  </script>
</Layout>
