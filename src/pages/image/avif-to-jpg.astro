---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: "Why can't I open my AVIF file?",
    a: "Browsers all display AVIF, but plenty of desktop software still doesn't read it — older Windows builds without the AV1 Image Extension, most email clients, and a lot of photo editors and print services. Files saved from a website are the usual way people end up with one they can't open.",
  },
  {
    q: 'Will the JPG look worse than the AVIF?',
    a: "It's a fresh lossy encode of an already-lossy image, so a second generation of compression artifacts is added on top of whatever the AVIF already had. At normal viewing sizes that's rarely visible, but don't repeat the round trip more than you have to.",
  },
  {
    q: 'What happens to transparency?',
    a: "AVIF supports an alpha channel and JPG doesn't. Transparent areas are flattened onto black. If your image has transparency you want to keep, convert to PNG instead — the Compress Image tool accepts AVIF and will keep it lossless if you re-encode as PNG.",
  },
  {
    q: 'Why is the JPG so much bigger?',
    a: "That's expected. AVIF is roughly a generation ahead of JPEG on compression efficiency, so the same picture typically needs several times more bytes as a JPG. You're trading file size for the ability to open it anywhere.",
  },
];
---

<Layout
  title="AVIF to JPG Converter, Open AVIF Files | Kit-Bin"
  description="Convert AVIF images to JPG in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert AVIF to JPG"
    description="Convert AVIF images to JPG in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Convert AVIF Images to JPG" />

  <ToolWidget accept=".avif,image/avif" multiple dropLabel="Drop AVIF images here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      AVIF is what a lot of sites now serve images as, which means it's what you get when you save
      a picture from one. It opens fine in any browser and then refuses to open in half the
      software on your machine. Converting to JPG trades the file size back for compatibility.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">Decoding happens on your device</h2>
      <p class="text-muted dark:text-slate-400">
        The AVIF decoder is a WebAssembly build of libavif, downloaded once on your first
        conversion and then cached by the browser. It's a couple of megabytes, so the first file
        takes a moment longer than the rest. Nothing about your image is sent anywhere.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Going the other way, for a website? Try{' '}
      <a href="/image/jpg-to-avif/" class="text-primary dark:text-blue-400 hover:underline">JPG to AVIF</a>.
    </p>
    <p class="text-sm">
      Need the JPG smaller, or a specific size? Try{' '}
      <a href="/image/compress/" class="text-primary dark:text-blue-400 hover:underline">Compress Image</a>{' '}
      or <a href="/image/resize/" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a> next.
    </p>
    <p class="text-sm">
      Curious what makes AVIF different from JPG? Read{' '}
      <a href="/guides/avif-explained/" class="text-primary dark:text-blue-400 hover:underline">AVIF explained</a>.
      Wondering why an AVIF file won't open somewhere? Read{' '}
      <a href="/guides/avif-wont-open/" class="text-primary dark:text-blue-400 hover:underline">where AVIF is and isn't safe to use</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:image/avif-to-jpg" />
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { sniffMime } from '../../lib/image/codec';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: '.avif,image/avif',
      multiple: true,
      batchZipName: 'kit-bin-avif-to-jpg.zip',
      validate: (files) =>
        files.some((f) => sniffMime(f) !== 'image/avif') ? 'This tool only accepts AVIF files.' : null,
      runEach: async (file) => {
        const blob = await convertImageFormat(file, 'image/jpeg');
        return { blob, filename: file.name.replace(/\.avif$/i, '.jpg') };
      },
    });
  </script>
</Layout>
