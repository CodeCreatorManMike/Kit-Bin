---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Compress Image Online — Free & No Upload Required | Kit-Bin"
  description="Shrink an image's file size in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Compress Image"
    description="Shrink an image's file size in seconds. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={[
    {
      "q": "Will this affect quality?",
      "a": "Some quality loss is expected — that's how compression reduces file size. The tool targets a good size/quality balance automatically."
    },
    {
      "q": "Which formats are supported?",
      "a": "JPG, PNG, and WebP."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Compress Image — Free</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="image/*" dropLabel="Drop an image here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-4">
    <p>This tool shrinks an image's file size while keeping it visually close to the original.</p>
    <p>Drop your image above. The compressed file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Will this affect quality?</p>
      <p class="text-slate-600 dark:text-slate-400">Some quality loss is expected — that's how compression reduces file size. The tool targets a good size/quality balance automatically.</p>
    </div>
    <div>
      <p class="font-medium">Which formats are supported?</p>
      <p class="text-slate-600 dark:text-slate-400">JPG, PNG, and WebP.</p>
    </div>
    <p class="text-sm">Not sure which format you actually need? <a href="/guides/webp-vs-png-jpg" class="text-blue-600 dark:text-blue-400 hover:underline">Read the comparison</a></p>
  </div>

  <script>
    import { compressImage } from '../../lib/image/compress';
    import { getToolElements, wireTool } from '../../lib/ui';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/*',
      validate: (files) => (!files[0]?.type.startsWith('image/') ? 'This tool needs an image file.' : null),
      run: async (files) => {
        const { blob, originalSize, compressedSize } = await compressImage(files[0]);
        const pct = Math.round((1 - compressedSize / originalSize) * 100);
        const note = `${formatBytes(originalSize)} → ${formatBytes(compressedSize)}${pct > 0 ? ` (${pct}% smaller)` : ''}`;
        return { blob, filename: files[0].name, note };
      },
    });
  </script>
</Layout>
