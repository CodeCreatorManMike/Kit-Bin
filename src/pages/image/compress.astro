---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Will this affect quality?',
    a: 'For JPG and WebP, yes, some quality loss is expected, since that\'s how lossy compression reduces file size. For PNG, the compression is lossless (no visible quality change), but the size reduction is usually smaller as a result.',
  },
  {
    q: 'Which formats are supported?',
    a: 'JPG, PNG, and WebP. The output stays in the same format as the input. This tool doesn\'t convert between formats.',
  },
  {
    q: 'Why did my PNG barely shrink?',
    a: 'PNG compression here is lossless. It can only remove redundancy the original encoder left behind, not throw away visible detail. If your PNG was already efficiently encoded, there may be very little left to save. Converting to JPG or WebP will shrink it further, but changes the format and (for JPG) removes transparency.',
  },
  {
    q: 'Why is the result bigger than my original in some cases?',
    a: "It isn't. If re-encoding wouldn't actually make the file smaller, this tool keeps your original file instead of returning a larger one.",
  },
];
---

<Layout
  title="Compress Images Online in Your Browser | Kit-Bin"
  description="Reduce a JPG, PNG, or WebP image's file size without changing its format. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Compress Image"
    description="Reduce a JPG, PNG, or WebP image's file size without changing its format. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Compress an Image and Reduce Its File Size" />

  <ToolWidget accept="image/*" multiple dropLabel="Drop images here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Drop a JPG, PNG, or WebP image above. This tool re-encodes it using the same codec family
      the format already uses, so a JPG stays a JPG and a PNG stays a PNG. It's useful when an
      email attachment limit, a website upload cap, or an app's storage quota rejects a file that's
      otherwise fine.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">JPG and WebP vs. PNG, different trade-offs</h2>
      <p class="text-muted dark:text-slate-400">
        JPG and WebP compression here is lossy: the tool trades a small, usually invisible amount
        of visual detail for a meaningfully smaller file. PNG compression is lossless. It
        re-encodes the same exact pixels more efficiently, which is safer for screenshots and
        interface graphics but typically saves less space than converting to a lossy format
        would.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">When compressing won't get you far</h2>
      <p class="text-muted dark:text-slate-400">
        A PNG that's already tightly encoded, or a JPG that's already been through heavy
        compression once, has little redundancy left to remove. If you need a much smaller file
        and format doesn't matter, converting to WebP with{' '}
        <a href="/image/png-to-webp" class="text-primary dark:text-blue-400 hover:underline">PNG to WebP</a>{' '}
        usually goes further than re-compressing in the original format.
      </p>
    </div>

    <p class="text-sm">Not sure which format you actually need? <a href="/guides/webp-vs-png-jpg" class="text-primary dark:text-blue-400 hover:underline">Read: WebP vs PNG vs JPG</a></p>
    <p class="text-sm">Trying to shrink a file that's much larger than it needs to display? <a href="/guides/compression-vs-resizing" class="text-primary dark:text-blue-400 hover:underline">Read: Compression vs Resizing</a></p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Need to change the pixel dimensions instead of just the file size? Try{' '}
      <a href="/image/resize" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:image/compress" />
  </div>

  <script>
    import { compressImage } from '../../lib/image/compress';
    import { renameToMime } from '../../lib/image/codec';
    import { getToolElements, wireTool } from '../../lib/ui';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/*',
      multiple: true,
      batchZipName: 'kit-bin-compressed-images.zip',
      validate: (files) =>
        files.some((f) => !f.type.startsWith('image/')) ? 'This tool only accepts image files.' : null,
      runEach: async (file) => {
        const { blob, originalSize, compressedSize, mimeType } = await compressImage(file);
        const pct = Math.round((1 - compressedSize / originalSize) * 100);
        // Only meaningful for a single file; wireTool replaces the note with a
        // file count when the batch produces a zip.
        const note = `${formatBytes(originalSize)} → ${formatBytes(compressedSize)}${pct > 0 ? ` (${pct}% smaller)` : ''}`;
        return { blob, filename: renameToMime(file.name, mimeType), note };
      },
    });
  </script>
</Layout>
