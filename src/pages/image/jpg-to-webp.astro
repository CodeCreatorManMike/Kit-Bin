---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Why convert JPG to WebP?',
    a: "WebP typically produces a smaller file than JPG at a similar visual quality, which is the whole reason it exists. For a website, that's faster page loads and less bandwidth. Actual savings vary by image, but a meaningful reduction on photographic content is the norm.",
  },
  {
    q: 'Am I losing quality on top of what the JPG already has?',
    a: "A little, yes. This re-encodes the image with WebP's own lossy compression, and the JPG's existing compression artifacts are already baked into the pixels it starts from. Two lossy passes are never as clean as one, but at web viewing sizes the difference is rarely visible. For the best result, convert from the original source rather than a JPG that's already been compressed hard.",
  },
  {
    q: 'Will WebP work everywhere I need it to?',
    a: "Every modern browser displays WebP natively, so for a website it's safe. Where it can still cause friction is outside the browser: some older desktop software, certain email clients, and some upload forms (print services, older CMS platforms) don't accept it. Keep a JPG on hand if you need to hand the file to something other than a browser.",
  },
  {
    q: 'Does this affect transparency or EXIF data?',
    a: 'A source JPG has no alpha channel, so there is nothing to preserve on that front. Camera EXIF metadata (orientation, camera model, GPS if present) is not carried over to the WebP output — the image itself is unaffected, only the metadata is dropped.',
  },
];
---

<Layout
  title="JPG to WebP Converter for Smaller Web Images | Kit-Bin"
  description="Convert JPG images to WebP in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert JPG to WebP"
    description="Convert JPG images to WebP in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Convert JPG Images to WebP" />

  <ToolWidget accept=".jpg,.jpeg,image/jpeg" multiple dropLabel="Drop JPG images here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Convert a JPG to WebP for a smaller website asset. This is a lossy re-encode by default,
      trading a bit of additional visual detail for a meaningfully smaller file — the right trade
      for images going onto a page, not for a source file you'll keep editing or printing.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">Encoding happens on your device</h2>
      <p class="text-muted dark:text-slate-400">
        The WebP encoder runs as WebAssembly directly in your browser. Nothing about the image is
        sent to a server — the JPG is decoded, re-encoded, and handed back to you locally.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Need it back as a JPG for something that won't take WebP? Try{' '}
      <a href="/image/webp-to-jpg/" class="text-primary dark:text-blue-400 hover:underline">WebP to JPG</a>.
    </p>
    <p class="text-sm">
      Want it smaller still, or a specific size? Try{' '}
      <a href="/image/compress/" class="text-primary dark:text-blue-400 hover:underline">Compress Image</a>{' '}
      or <a href="/image/resize/" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a> next.
    </p>
    <p class="text-sm">
      Not sure which format you actually need? Read{' '}
      <a href="/guides/webp-vs-png-jpg/" class="text-primary dark:text-blue-400 hover:underline">the comparison</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdBanner placement="tool-page:image/jpg-to-webp" />
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { sniffMime } from '../../lib/image/codec';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: '.jpg,.jpeg,image/jpeg',
      multiple: true,
      batchZipName: 'kit-bin-jpg-to-webp.zip',
      validate: (files) =>
        files.some((f) => sniffMime(f) !== 'image/jpeg') ? 'This tool only accepts JPG files.' : null,
      runEach: async (file) => {
        const blob = await convertImageFormat(file, 'image/webp');
        return { blob, filename: file.name.replace(/\.jpe?g$/i, '.webp') };
      },
    });
  </script>
</Layout>
