---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Convert WebP to PNG Online — Free & No Upload Required | Kit-Bin"
  description="Convert a WebP image to PNG in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert WebP to PNG"
    description="Convert a WebP image to PNG in seconds. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={[
    {
      "q": "Does this lose quality?",
      "a": "No — PNG is lossless, so the pixel data is preserved exactly."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Convert WebP to PNG — Free</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="image/webp" dropLabel="Drop a WebP image here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-4">
    <p>This tool converts a WebP image into a standard PNG file.</p>
    <p>Drop your WebP image above. The PNG downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Does this lose quality?</p>
      <p class="text-slate-600 dark:text-slate-400">No — PNG is lossless, so the pixel data is preserved exactly.</p>
    </div>
    <p class="text-sm">Not sure which format you actually need? <a href="/guides/webp-vs-png-jpg" class="text-blue-600 dark:text-blue-400 hover:underline">Read the comparison</a></p>
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/webp',
      validate: (files) => (files[0]?.type !== 'image/webp' ? 'This tool needs a WebP file.' : null),
      run: async (files) => {
        const blob = await convertImageFormat(files[0], 'image/png');
        return { blob, filename: files[0].name.replace(/\.webp$/i, '.png') };
      },
    });
  </script>
</Layout>
