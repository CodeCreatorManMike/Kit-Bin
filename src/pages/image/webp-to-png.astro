---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does this lose quality?',
    a: 'No, PNG is lossless, so the pixel data is preserved exactly. The output file will typically be larger than the WebP source, since PNG doesn\'t compress as efficiently.',
  },
  {
    q: 'Why would I convert to PNG instead of keeping WebP?',
    a: "PNG is broadly compatible with older software, image editors, and any application that doesn't accept WebP. Some design tools and older CMS platforms still reject .webp uploads outright.",
  },
  {
    q: 'Does this support animated WebP?',
    a: "No, only the first frame of an animated WebP is converted, since PNG doesn't support animation. If you need to keep the animation, keep the file as WebP or convert to GIF instead.",
  },
];
---

<Layout
  title="WebP to PNG Converter, Preserve Transparency | Kit-Bin"
  description="Convert a WebP image to PNG in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert WebP to PNG"
    description="Convert a WebP image to PNG in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Convert WebP Images to PNG</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="image/webp" dropLabel="Drop a WebP image here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      PNG is usually the better output when you need broad compatibility, transparency, or sharp
      interface graphics preserved exactly. Converting a photograph from WebP to PNG may make the
      file substantially larger without improving its visible quality. PNG isn't "better," it's
      just more universally accepted and lossless.
    </p>

    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-muted dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>

    <p class="text-sm">Not sure which format you actually need? <a href="/guides/webp-vs-png-jpg" class="text-primary dark:text-blue-400 hover:underline">Read the comparison</a></p>
    <p class="text-sm">
      PNG output too big? Try <a href="/image/compress" class="text-primary dark:text-blue-400 hover:underline">Compress Image</a>
      afterward.
    </p>
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/webp',
      validate: (files) => (files[0]?.type !== 'image/webp' ? 'This tool needs a WebP file.' : null),
      run: async (files) => {
        const blob = await convertImageFormat(files[0], 'image/png');
        return { blob, filename: files[0].name.replace(/\.webp$/i, '.png') };
      },
    });
  </script>
</Layout>
