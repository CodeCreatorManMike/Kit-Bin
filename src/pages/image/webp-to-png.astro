---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
---

<Layout
  title="Convert WebP to PNG Online — Free & No Upload Required | ToolKit"
  description="Convert a WebP image to PNG in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold">Convert WebP to PNG — Free</h1>
    <p class="mt-2 text-slate-600">Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="image/webp" dropLabel="Drop a WebP image here or click to browse" />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 space-y-4">
    <p>This tool converts a WebP image into a standard PNG file.</p>
    <p>Drop your WebP image above. The PNG downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Does this lose quality?</p>
      <p class="text-slate-600">No — PNG is lossless, so the pixel data is preserved exactly.</p>
    </div>
  </div>

  <script>
    import { convertImageFormat } from '../../lib/image/convertFormat';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'image/webp',
      validate: (files) => (files[0]?.type !== 'image/webp' ? 'This tool needs a WebP file.' : null),
      run: async (files) => {
        const blob = await convertImageFormat(files[0], 'image/png');
        return { blob, filename: files[0].name.replace(/\.webp$/i, '.png') };
      },
    });
  </script>
</Layout>
