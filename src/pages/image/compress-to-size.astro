---
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'How does it hit an exact size limit?',
    a: 'It binary-searches the encoder quality, up to 8 encode passes between quality 10 and 95, and keeps the highest quality whose output still fits under your target. If even quality 10 is too large, it then reduces the pixel dimensions in steps and searches quality again at each size.',
  },
  {
    q: 'What if my target is impossible?',
    a: 'It gives you the smallest file it managed to produce and says the target was not reached, rather than failing silently or returning something over the limit. Very small targets on very large images are the usual cause.',
  },
  {
    q: 'Will my PNG stay a PNG?',
    a: 'No. PNG has no quality dial to search, so a PNG input is encoded as WebP, which does have one and also supports transparency. A JPG input stays a JPG. The output format is shown in the results panel.',
  },
  {
    q: 'Does transparency survive?',
    a: 'Yes. If the image has any transparent or semi-transparent pixels, the output is WebP, which keeps the alpha channel. This tool never converts a transparent image to JPG.',
  },
  {
    q: 'What does "1 MB" mean here?',
    a: '1 MB means 1,048,576 bytes and 1 KB means 1,024 bytes. If the system you are uploading to counts megabytes as 1,000,000 bytes, a file that fits this tool\'s 1 MB target also fits that limit.',
  },
];
---

<Layout
  title="Compress an Image to a Target File Size (100 KB, 1 MB) | Kit-Bin"
  description="Compress a JPG, PNG, or WebP down to a specific file size such as 100 KB or 1 MB. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Compress Image to Target Size"
    description="Compress a JPG, PNG, or WebP down to a specific file size such as 100 KB or 1 MB. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Compress an Image to a Target File Size" />

  <div class="max-w-2xl mx-auto px-4 pb-4">
    <p class="text-sm font-medium text-ink dark:text-slate-200">Target size</p>
    <div class="mt-2 flex flex-wrap gap-2" id="preset-row">
      <button type="button" data-bytes="102400" class="preset rounded-lg border border-border-soft dark:border-slate-700 px-4 py-2 text-sm font-medium hover:border-primary/50 dark:hover:border-slate-500">100 KB</button>
      <button type="button" data-bytes="256000" class="preset rounded-lg border border-border-soft dark:border-slate-700 px-4 py-2 text-sm font-medium hover:border-primary/50 dark:hover:border-slate-500">250 KB</button>
      <button type="button" data-bytes="512000" class="preset rounded-lg border border-border-soft dark:border-slate-700 px-4 py-2 text-sm font-medium hover:border-primary/50 dark:hover:border-slate-500">500 KB</button>
      <button type="button" data-bytes="1048576" class="preset rounded-lg border border-border-soft dark:border-slate-700 px-4 py-2 text-sm font-medium hover:border-primary/50 dark:hover:border-slate-500">1 MB</button>
    </div>
    <label class="mt-3 flex items-center gap-2 text-sm text-muted dark:text-slate-400">
      <span>Or a custom target, in KB:</span>
      <input
        id="custom-kb"
        type="number"
        min="1"
        step="1"
        placeholder="e.g. 750"
        class="w-28 rounded-lg border border-border-soft dark:border-slate-700 bg-transparent px-3 py-1.5 text-ink dark:text-slate-100"
      />
    </label>
    <p id="target-label" class="mt-2 text-sm text-muted dark:text-slate-400">Current target: 500 KB</p>
  </div>

  <ToolWidget accept="image/jpeg,image/png,image/webp" dropLabel="Drop a JPG, PNG, or WebP here or click to browse" />

  <div id="size-details" class="hidden max-w-2xl mx-auto px-4 mt-4">
    <div class="rounded-xl border border-border-soft dark:border-slate-700 p-5">
      <p id="verdict" class="font-semibold text-ink dark:text-slate-100"></p>
      <dl class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-muted dark:text-slate-400">File size</dt><dd id="d-size" class="text-ink dark:text-slate-200 text-right"></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted dark:text-slate-400">Dimensions</dt><dd id="d-dims" class="text-ink dark:text-slate-200 text-right"></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted dark:text-slate-400">Output format</dt><dd id="d-format" class="text-ink dark:text-slate-200 text-right"></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted dark:text-slate-400">Quality used</dt><dd id="d-quality" class="text-ink dark:text-slate-200 text-right"></dd></div>
      </dl>
      <p id="d-notes" class="mt-3 text-sm text-muted dark:text-slate-400"></p>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      This tool compresses a JPG, PNG, or WebP until it fits a file size you choose. Pick a target
      above, drop the image, and it works out the encoder settings for you instead of asking you to
      guess at a quality slider.
    </p>
    <p>
      Use it when something has rejected your file for being too big: a job application portal
      capped at 500 KB, a forum avatar capped at 100 KB, a visa or passport photo upload, or an
      email attachment limit.
    </p>

    <div>
      <h2 class="font-semibold text-lg">How it decides</h2>
      <p class="text-muted dark:text-slate-400">
        First it checks whether the file already fits. If it does, you get your original bytes back
        with no re-encoding at all. Otherwise it binary-searches encoder quality between 10 and 95,
        up to 8 passes, and keeps the highest quality that still lands under the target. Only if
        quality 10 is still too large does it start reducing the pixel dimensions, in steps, running
        the quality search again at each smaller size. That order matters: dropping resolution is
        the more visible change, so it is the last resort, not the first move.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-lg">Formats and transparency</h2>
      <p class="text-muted dark:text-slate-400">
        A JPG stays a JPG. A PNG or WebP is encoded as WebP, because PNG has no quality setting to
        search against. If the image contains transparent pixels, the output is WebP, which keeps
        the alpha channel. Transparency is never dropped by converting to JPG behind your back. The
        results panel always names the output format so there is no guessing.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-lg">When the target cannot be met</h2>
      <p class="text-muted dark:text-slate-400">
        Some combinations are not achievable, for example a 50-megapixel photo squeezed into 20 KB
        at full resolution. In that case you still get a file: the smallest one the tool produced,
        clearly marked as over target. Raising the target or accepting a smaller pixel size is
        usually the fix.
      </p>
    </div>

    <p class="text-sm">
      Want a plain quality-based squeeze with no size target? Use{' '}
      <a href="/image/compress" class="text-primary dark:text-blue-400 hover:underline">Compress Image</a>.
      To set exact pixel dimensions instead, use{' '}
      <a href="/image/resize" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a>.
    </p>
    <p class="text-sm">
      Not sure whether you need a smaller file or a smaller image?{' '}
      <a href="/guides/compression-vs-resizing" class="text-primary dark:text-blue-400 hover:underline">Read: Compression vs Resizing</a>.
    </p>

    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </div>

  <script>
    import { compressToSize } from '../../lib/image/compressToSize';
    import { getToolElements, wireTool } from '../../lib/ui';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const FORMAT_NAMES: Record<string, string> = {
      'image/jpeg': 'JPG',
      'image/png': 'PNG',
      'image/webp': 'WebP',
    };

    const presets = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset'));
    const customInput = document.querySelector<HTMLInputElement>('#custom-kb')!;
    const targetLabel = document.querySelector<HTMLElement>('#target-label')!;
    const details = document.querySelector<HTMLElement>('#size-details')!;

    const ACTIVE = ['border-primary', 'dark:border-blue-400', 'text-primary', 'dark:text-blue-400'];
    let targetBytes = 512000;

    function markActive(active: HTMLButtonElement | null) {
      for (const button of presets) button.classList.remove(...ACTIVE);
      if (active) active.classList.add(...ACTIVE);
    }

    function setTarget(bytes: number, active: HTMLButtonElement | null) {
      targetBytes = bytes;
      markActive(active);
      targetLabel.textContent = `Current target: ${formatBytes(bytes)}`;
    }

    for (const button of presets) {
      button.addEventListener('click', () => {
        customInput.value = '';
        setTarget(Number(button.dataset.bytes), button);
      });
    }

    customInput.addEventListener('input', () => {
      const kb = Number(customInput.value);
      if (Number.isFinite(kb) && kb > 0) setTarget(Math.round(kb * 1024), null);
    });

    setTarget(targetBytes, presets.find((b) => b.dataset.bytes === '512000') ?? null);

    const els = getToolElements();
    els.resetButton.addEventListener('click', () => details.classList.add('hidden'));

    wireTool(els, {
      accept: 'image/jpeg,image/png,image/webp',
      validate: (files) => {
        const file = files[0];
        if (!file) return 'Choose an image file.';
        if (!['image/jpeg', 'image/jpg', 'image/png', 'image/webp'].includes(file.type)) {
          return 'This tool needs a JPG, PNG, or WebP file.';
        }
        if (targetBytes <= 0) return 'Enter a target size larger than zero.';
        return null;
      },
      run: async (files, reportProgress) => {
        const file = files[0];
        const result = await compressToSize(file, targetBytes, reportProgress);

        const verdict = document.querySelector<HTMLElement>('#verdict')!;
        verdict.textContent = result.targetReached
          ? `Target met: ${formatBytes(result.outputSize)}, under ${formatBytes(targetBytes)}.`
          : `Target not reached. The smallest result was ${formatBytes(result.outputSize)}, over the ${formatBytes(targetBytes)} target.`;
        verdict.className = result.targetReached
          ? 'font-semibold text-ink dark:text-slate-100'
          : 'font-semibold text-amber-700 dark:text-amber-400';

        const pct = Math.round((1 - result.outputSize / result.originalSize) * 100);
        document.querySelector<HTMLElement>('#d-size')!.textContent =
          `${formatBytes(result.originalSize)} → ${formatBytes(result.outputSize)}${pct > 0 ? ` (${pct}% smaller)` : ''}`;

        const from = `${result.originalDimensions.width}×${result.originalDimensions.height}`;
        const to = `${result.outputDimensions.width}×${result.outputDimensions.height}`;
        document.querySelector<HTMLElement>('#d-dims')!.textContent = from === to ? `${from} (unchanged)` : `${from} → ${to}`;

        document.querySelector<HTMLElement>('#d-format')!.textContent =
          (FORMAT_NAMES[result.format] ?? result.format) + (result.formatChanged ? ' (changed)' : ' (unchanged)');

        document.querySelector<HTMLElement>('#d-quality')!.textContent =
          result.qualityUsed === null ? 'Not re-encoded' : String(result.qualityUsed);

        const notes: string[] = [];
        if (result.qualityUsed === null) notes.push('Your file already met the target, so the original bytes were returned without re-encoding.');
        if (result.resized) notes.push('Encoder quality alone could not reach the target, so the pixel dimensions were reduced as well.');
        if (result.hasTransparency) notes.push('This image has transparency, so it was encoded as WebP to keep the alpha channel.');
        else if (result.formatChanged) notes.push('PNG has no quality setting to search, so the output was encoded as WebP.');
        if (!result.targetReached) notes.push('Try a larger target if this file needs to stay at this resolution.');
        document.querySelector<HTMLElement>('#d-notes')!.textContent = notes.join(' ');

        details.classList.remove('hidden');
        return { blob: result.blob, filename: result.filename, note: `${formatBytes(result.originalSize)} → ${formatBytes(result.outputSize)}` };
      },
    });
  </script>
</Layout>
