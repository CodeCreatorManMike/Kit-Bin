---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  { q: 'Is my photo uploaded to extract the colors?', a: 'No. The image is analyzed in this browser tab using the same color-quantization approach a GIF encoder uses to pick its palette — Kit-Bin never receives the file.' },
  { q: 'How are the colors chosen?', a: "Not just the most frequent pixels — that tends to pick near-duplicate shades from a large area of one color. The algorithm groups similar colors together first, so the result better represents the image's actual range of color rather than just its biggest block." },
  { q: 'Why does a mostly-one-color photo still show several swatches?', a: "The tool always returns up to 8 colors, even from a fairly uniform image — some will be close variations of each other in that case. That's expected, not a bug." },
  { q: 'What can I do with the hex codes?', a: 'Paste them directly into CSS, a design tool, or a style guide. Each swatch copies its own hex code, and there\'s a "copy all" button for grabbing the whole palette at once.' },
  { q: 'Does it work on any image format?', a: 'Any format your browser can decode into an image — JPG, PNG, WebP, GIF, and HEIC photos straight from an iPhone. If a file won\'t load, it\'s not a supported image format rather than a size or color issue.' },
  { q: 'Is there a limit on image size?', a: "No hard limit, since nothing leaves your browser. Large photos are automatically downscaled before the color analysis runs, so a 40-megapixel photo takes about the same time to process as a small one and returns the same palette." },
];
---

<Layout title="Color Palette Extractor, Get Hex Codes from a Photo | Kit-Bin" description="Pull the dominant colors out of a photo as hex codes, entirely in your browser. Nothing you upload is sent to a server.">
  <ToolSchema name="Color Palette from Image" description="Extract the dominant colors from an image entirely in your browser, with no uploads." faqs={faqs} />
  <ToolHeader title="Color Palette from an Image" subtitle="Pull the dominant colors out of a photo as hex codes. Analyzed locally, nothing is uploaded." />

  <div class="max-w-2xl mx-auto px-4">
    <div id="drop-target" class="rounded-2xl border border-dashed border-border-soft bg-surface p-6 text-center shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900">
      <input id="file" type="file" accept="image/*" class="hidden" />
      <label for="file" class="inline-flex cursor-pointer items-center rounded-xl bg-gradient-to-r from-primary to-violet-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5">Choose an image</label>
      <p class="mt-3 text-sm text-muted dark:text-slate-400">Or drop a photo here.</p>
      <img id="preview" class="mx-auto mt-4 hidden max-h-48 rounded-xl border border-border-soft dark:border-slate-700" alt="" />
      <p id="message" role="status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm"></p>
      <div id="palette" class="mt-5 hidden grid grid-cols-2 gap-3 text-left sm:grid-cols-4"></div>
      <button id="copy-all" class="mt-4 hidden rounded-lg border border-border-soft px-4 py-2 text-sm font-medium dark:border-slate-700">Copy all hex codes</button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto space-y-6 px-4 py-12 text-ink dark:text-slate-300">
    <p>
      Drop a photo above and this tool pulls out its dominant colors as a small palette of hex
      codes — useful for matching a design to a photo, building a brand or website color scheme,
      or just knowing what's actually in an image without eyedropper-picking pixels one at a time.
      It's not a simple "most common pixel" count: a photo can contain millions of near-identical
      shades of the same color, so counting raw frequency would just return eight near-duplicate
      variations of whatever color takes up the most space in the frame. Instead the tool groups
      similar colors together first (the same clustering approach a GIF encoder uses to pick its
      256-color palette), then reports each group's representative color — which is why the result
      reads as a handful of visually distinct swatches instead of a wash of near-identical grays
      or blues.
    </p>
    <p>
      Each swatch shows its hex code and copies individually on click; the "copy all" button grabs
      the whole palette at once, ready to paste into CSS, a design tool, or a style guide. Works on
      any photo format your browser can decode — JPG, PNG, WebP, HEIC from an iPhone — and nothing
      you drop here is uploaded anywhere.
    </p>
    <div><h2 class="tool-h2 text-lg font-semibold">FAQ</h2><div class="mt-3"><FaqAccordion faqs={faqs} /></div></div>
    <p class="text-sm">
      Want to know how the clustering actually works? Read{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/how-color-palette-extraction-works/">how color palette extraction works</a>.
      Converting between hex, RGB, and HSL for the colors you find? See{' '}
      <a class="text-primary hover:underline dark:text-blue-400" href="/guides/hex-rgb-hsl-same-color/">hex vs RGB vs HSL</a>.
    </p>
    <p class="text-sm">
      Related tools:{' '}
      <a href="/image/remove-background/" class="text-primary dark:text-blue-400 hover:underline">Remove Background</a>,{' '}
      <a href="/image/crop/" class="text-primary dark:text-blue-400 hover:underline">Crop Image</a>,{' '}
      <a href="/image/resize/" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:image/color-palette" />
  </div>

  <script>
    import { quantize } from 'gifenc';

    const fileInput = document.querySelector<HTMLInputElement>('#file')!;
    const dropTarget = document.querySelector<HTMLElement>('#drop-target')!;
    const preview = document.querySelector<HTMLImageElement>('#preview')!;
    const message = document.querySelector<HTMLElement>('#message')!;
    const palette = document.querySelector<HTMLElement>('#palette')!;
    const copyAllButton = document.querySelector<HTMLButtonElement>('#copy-all')!;
    const successClasses = ['bg-emerald-50', 'text-emerald-800', 'dark:bg-emerald-950/40', 'dark:text-emerald-300'];
    const errorClasses = ['bg-red-50', 'text-red-800', 'dark:bg-red-950/40', 'dark:text-red-300'];

    function showMessage(text: string, valid: boolean) {
      message.textContent = text;
      message.classList.remove('hidden', ...successClasses, ...errorClasses);
      message.classList.add(...(valid ? successClasses : errorClasses));
    }

    function toHex([r, g, b]: number[]): string {
      return '#' + [r, g, b].map((c) => c.toString(16).padStart(2, '0')).join('');
    }

    function luminance([r, g, b]: number[]): number {
      return 0.299 * r + 0.587 * g + 0.114 * b;
    }

    async function extract(file: File) {
      palette.classList.add('hidden');
      palette.replaceChildren();
      copyAllButton.classList.add('hidden');
      if (!file.type.startsWith('image/')) { showMessage('That file is not an image.', false); return; }

      const url = URL.createObjectURL(file);
      preview.src = url;
      preview.classList.remove('hidden');
      showMessage('Analyzing colors…', true);

      try {
        const bitmap = await createImageBitmap(file);
        // Downscale before sampling — quantizing every pixel of a large photo
        // is wasted work when a few thousand samples already represent the
        // color distribution just as well.
        const maxEdge = 200;
        const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
        const w = Math.max(1, Math.round(bitmap.width * scale));
        const h = Math.max(1, Math.round(bitmap.height * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(bitmap, 0, 0, w, h);
        const imageData = ctx.getImageData(0, 0, w, h);
        bitmap.close();

        const colors = quantize(imageData.data, 8) as number[][];
        colors.sort((a, b) => luminance(b) - luminance(a));

        for (const rgb of colors) {
          const hex = toHex(rgb);
          const swatch = document.createElement('button');
          swatch.type = 'button';
          swatch.className = 'group flex items-center gap-3 rounded-xl border border-border-soft p-2 text-left transition hover:-translate-y-0.5 dark:border-slate-700';
          swatch.innerHTML = `
            <span class="h-10 w-10 shrink-0 rounded-lg border border-black/10 dark:border-white/10" style="background:${hex}"></span>
            <span class="font-mono text-sm">${hex}</span>
          `;
          swatch.title = 'Click to copy';
          swatch.addEventListener('click', async () => {
            try { await navigator.clipboard.writeText(hex); showMessage(`Copied ${hex}.`, true); }
            catch { showMessage('Clipboard access was blocked.', false); }
          });
          palette.append(swatch);
        }
        palette.classList.remove('hidden');
        copyAllButton.classList.remove('hidden');
        copyAllButton.dataset.hexes = colors.map(toHex).join(', ');
        showMessage(`Found ${colors.length} colors.`, true);
      } catch (error) {
        showMessage(`Could not analyze this image: ${error instanceof Error ? error.message : 'unknown error'}`, false);
      }
    }

    fileInput.addEventListener('change', () => { const file = fileInput.files?.[0]; if (file) extract(file); fileInput.value = ''; });
    dropTarget.addEventListener('dragover', (event) => { event.preventDefault(); dropTarget.classList.add('border-primary'); });
    dropTarget.addEventListener('dragleave', () => dropTarget.classList.remove('border-primary'));
    dropTarget.addEventListener('drop', (event) => { event.preventDefault(); dropTarget.classList.remove('border-primary'); const file = event.dataTransfer?.files?.[0]; if (file) extract(file); });
    copyAllButton.addEventListener('click', async () => {
      const hexes = copyAllButton.dataset.hexes;
      if (!hexes) return;
      try { await navigator.clipboard.writeText(hexes); showMessage('All hex codes copied.', true); }
      catch { showMessage('Clipboard access was blocked.', false); }
    });
  </script>
</Layout>
