---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does it keep the aspect ratio?',
    a: 'Yes, height is calculated from your target width automatically.',
  },
  {
    q: 'Can I set an exact height, or only width?',
    a: 'Only width, currently. Height always scales proportionally to keep the image from distorting.',
  },
  {
    q: 'Can resizing make a small image bigger without losing quality?',
    a: 'It can make the file dimensions bigger, but it cannot add detail that was never captured. Enlarging a low-resolution image just makes the existing pixels bigger and softer, not sharper.',
  },
];
---

<Layout
  title="Resize Image Online, Free & No Upload Required | Kit-Bin"
  description="Resize an image to a target width in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Resize Image"
    description="Resize an image to a target width in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Resize Image, Free" />

  <div class="max-w-2xl mx-auto px-4 mb-4 flex items-center justify-center gap-2 text-sm">
    <label for="target-width">Target width (px):</label>
    <input
      id="target-width"
      type="number"
      value="800"
      min="1"
      class="w-24 rounded border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-2 py-1"
    />
    <span class="text-muted dark:text-slate-400">Height scales automatically.</span>
  </div>

  <ToolWidget accept="image/*" multiple dropLabel="Drop images here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-4">
    <p>This tool resizes an image to a target width, scaling the height to match automatically so the image never distorts.</p>
    <p>Set your target width, then drop your image above. The resized file downloads automatically once ready.</p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
    <p class="text-sm">
      Trying to shrink a file rather than change its dimensions? Read{' '}
      <a href="/guides/compression-vs-resizing/" class="text-primary dark:text-blue-400 hover:underline">Compression vs Resizing</a>{' '}
      to see which one you actually need.
    </p>
    <p class="text-sm">
      Photo coming out stretched or squashed? Read{' '}
      <a href="/guides/resize-without-distorting/" class="text-primary dark:text-blue-400 hover:underline">how to resize without distorting</a>.
    </p>
    <p class="text-sm">
      Not sure what pixel size you need for print? Read{' '}
      <a href="/guides/dpi-ppi-print-size-explained/" class="text-primary dark:text-blue-400 hover:underline">DPI, PPI, and print size explained</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:image/resize" />
  </div>

  <script>
    import { resizeImage } from '../../lib/image/resize';
    import { getToolElements, wireTool } from '../../lib/ui';

    const widthInput = document.querySelector<HTMLInputElement>('#target-width')!;
    const els = getToolElements();
    wireTool(els, {
      accept: 'image/*',
      multiple: true,
      batchZipName: 'kit-bin-resized-images.zip',
      validate: (files) =>
        files.some((f) => !f.type.startsWith('image/')) ? 'This tool only accepts image files.' : null,
      runEach: async (file) => {
        const width = Math.max(1, parseInt(widthInput.value, 10) || 800);
        const { blob, mimeType } = await resizeImage(file, width);
        // Formats Canvas can't re-encode (GIF, BMP, ...) silently become PNG —
        // rename the output so the extension matches what's actually inside.
        const filename =
          mimeType === file.type ? file.name : file.name.replace(/\.[^.]+$/, '') + '.png';
        return { blob, filename };
      },
    });
  </script>
</Layout>
