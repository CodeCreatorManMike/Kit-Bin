---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does rotating lose quality?',
    a: 'A PNG output is lossless, so there is no change at all. A JPG or WebP output is re-encoded at quality 92, which is a small, generally invisible quality change. This tool does not do a true lossless JPEG transform, so if you rotate the same JPG repeatedly you will slowly lose detail.',
  },
  {
    q: 'What is the difference between rotating and flipping?',
    a: 'Rotating turns the whole image around its centre in 90 degree steps. Flipping mirrors it, horizontally (left becomes right) or vertically (top becomes bottom). A mirrored image is not the same as a rotated one: text in a flipped image reads backwards.',
  },
  {
    q: 'Can I combine a rotation and a flip?',
    a: 'Yes. The rotation is applied first, then the mirroring. The preview shows the exact combination before you apply it.',
  },
  {
    q: 'My phone photo looks rotated already, why?',
    a: 'Phone cameras often store the picture in one orientation and add an EXIF orientation tag telling viewers to turn it. This tool works on the decoded pixels and writes no orientation tag, so the output is upright as shown in the preview rather than relying on a tag some apps ignore.',
  },
  {
    q: 'Which formats are supported?',
    a: 'JPG, PNG, and WebP keep their format. Any other image the browser can decode is written out as PNG, which is lossless.',
  },
];
---

<Layout
  title="Rotate and Flip an Image Online, Free & No Upload | Kit-Bin"
  description="Rotate a JPG, PNG, or WebP by 90, 180, or 270 degrees, or mirror it horizontally or vertically. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Rotate and Flip Image"
    description="Rotate a JPG, PNG, or WebP by 90, 180, or 270 degrees, or mirror it horizontally or vertically. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Rotate and Flip an Image" />

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 hover:shadow-[0_10px_30px_rgba(16,24,47,0.08)] data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60 data-[dragging=true]:scale-[1.01] dark:data-[dragging=true]:bg-blue-950/30"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.06] via-transparent to-violet-500/[0.06] opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-data-[dragging=true]:opacity-100"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span
            class="absolute inset-0 rounded-full bg-primary/20 opacity-0 group-data-[dragging=true]:opacity-100 group-data-[dragging=true]:animate-pulse-ring"
            aria-hidden="true"></span>
          <span
            class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25 transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-3 group-data-[dragging=true]:scale-110"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4" />
              <path d="M8 8l4-4 4 4" />
              <path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" />
            </svg>
          </span>
        </span>

        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop an image here or click to browse</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <p id="file-info" class="mt-2 text-sm font-medium text-primary dark:text-blue-400"></p>
        <input id="file-input" type="file" accept="image/*" class="hidden" />
      </div>
    </div>

    <div id="edit-panel" class="hidden mt-4 rounded-2xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 p-5">
      <div class="flex aspect-square items-center justify-center overflow-hidden rounded-xl border border-border-soft dark:border-slate-700 bg-slate-50 dark:bg-slate-900">
        <img id="preview" alt="Preview of the rotated image" class="max-h-[70%] max-w-[70%] transition-transform duration-200" />
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" id="rotate-left" class="rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-4 py-2 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:bg-slate-800">Rotate left 90°</button>
        <button type="button" id="rotate-right" class="rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-4 py-2 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:bg-slate-800">Rotate right 90°</button>
        <button type="button" id="rotate-180" class="rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-4 py-2 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:bg-slate-800">Rotate 180°</button>
        <button type="button" id="flip-h" class="rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-4 py-2 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:bg-slate-800">Flip horizontal</button>
        <button type="button" id="flip-v" class="rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-4 py-2 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:bg-slate-800">Flip vertical</button>
        <button type="button" id="clear-transform" class="rounded-lg px-4 py-2 text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 transition-colors hover:text-ink dark:hover:text-slate-200">Reset</button>
      </div>

      <p id="transform-label" class="mt-3 text-sm text-muted dark:text-slate-400"></p>

      <button id="apply-button" class="mt-4 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]">
        Apply and download
      </button>
    </div>

    <div id="status" class="hidden mt-4" role="status" aria-live="polite">
      <div class="rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-4 py-3">
        <p data-status-text class="text-center text-sm font-medium text-ink dark:text-slate-200"></p>
        <div data-status-bar class="mt-2.5 h-1 overflow-hidden rounded-full bg-app-bg dark:bg-slate-800">
          <div class="h-full w-full animate-shimmer rounded-full" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div
      id="result"
      class="hidden mt-4 overflow-hidden rounded-2xl border border-emerald-300/70 dark:border-emerald-500/25 bg-gradient-to-br from-emerald-50 to-surface dark:from-emerald-950/25 dark:to-slate-900 p-6 text-center"
    >
      <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path class="animate-draw-check" d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <p class="mt-2.5 font-semibold text-ink dark:text-slate-100">Done</p>
      <p data-result-note class="mt-0.5 text-sm text-muted dark:text-slate-400"></p>

      <a
        id="download-link"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v12" />
          <path d="M8 12l4 4 4-4" />
          <path d="M4 20h16" />
        </svg>
        Download result
      </a>

      <button id="reset-button" class="mt-4 block w-full text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 transition-colors hover:text-ink dark:hover:text-slate-200">
        Process another file
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      This tool rotates an image in 90 degree steps and mirrors it horizontally or vertically. Drop
      an image above, click the rotate and flip buttons until the preview looks right, then apply
      and download.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">Rotation and mirroring are different operations</h2>
      <p class="text-muted dark:text-slate-400">
        Rotating turns the image around its centre, so a 90 or 270 degree rotation swaps its width
        and height. Flipping mirrors it in place and keeps the dimensions the same. You can combine
        them: the rotation is applied first, then the mirroring, which is exactly what the preview
        shows.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">What happens to quality</h2>
      <p class="text-muted dark:text-slate-400">
        The pixel movement itself is exact. A 90 degree rotation maps every pixel to one new
        position with no resampling and no blurring. The one place quality can change is the
        re-encode: PNG output is lossless, while JPG and WebP output is re-encoded at quality 92, a
        small change you are unlikely to see once. Rotating the same JPG back and forth many times
        will accumulate loss, so it is better to get the orientation right in one pass.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">EXIF orientation tags</h2>
      <p class="text-muted dark:text-slate-400">
        Photos from phones often sit in the file one way with an EXIF orientation tag telling apps to
        display them another way, which is why the same photo can look upright in one program and
        sideways in another. This tool rotates the actual pixels and writes no orientation tag, so
        what you see in the preview is what every viewer will show.
      </p>
    </div>

    <p class="text-sm">
      Need to cut part of the image away instead? Use{' '}
      <a href="/image/crop" class="text-primary dark:text-blue-400 hover:underline">Crop Image</a>.
      To change the pixel dimensions, use{' '}
      <a href="/image/resize" class="text-primary dark:text-blue-400 hover:underline">Resize Image</a>.
      To make the file smaller, use{' '}
      <a href="/image/compress" class="text-primary dark:text-blue-400 hover:underline">Compress Image</a>.
    </p>
    <p class="text-sm">
      Rotating a PDF rather than an image? Try{' '}
      <a href="/pdf/rotate" class="text-primary dark:text-blue-400 hover:underline">Rotate PDF</a>.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:image/rotate" />
  </div>

  <script>
    import { rotateImage, isNoOp, outputMimeFor, type RotateAngle, type RotateOptions } from '../../lib/image/rotate';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const EXTENSIONS: Record<string, string> = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' };

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const editPanel = document.querySelector<HTMLElement>('#edit-panel')!;
    const preview = document.querySelector<HTMLImageElement>('#preview')!;
    const transformLabel = document.querySelector<HTMLElement>('#transform-label')!;
    const applyButton = document.querySelector<HTMLButtonElement>('#apply-button')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const resultNote = document.querySelector<HTMLElement>('[data-result-note]')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

    let currentFile: File | null = null;
    let previewUrl: string | null = null;
    let outputUrl: string | null = null;
    const state: RotateOptions = { rotate: 0, flipH: false, flipV: false };

    const statusText = status.querySelector<HTMLElement>('[data-status-text]')!;
    const statusBar = status.querySelector<HTMLElement>('[data-status-bar]')!;

    function setStatus(message: string | null, isError = false) {
      statusText.textContent = message ?? '';
      status.classList.toggle('hidden', !message);
      statusBar.classList.toggle('hidden', isError);
      statusText.classList.toggle('text-red-600', isError);
      statusText.classList.toggle('dark:text-red-400', isError);
    }

    function render() {
      // Same order as the canvas transform in lib/image/rotate.ts: rotate, then mirror.
      preview.style.transform = `rotate(${state.rotate}deg) scale(${state.flipH ? -1 : 1}, ${state.flipV ? -1 : 1})`;

      const parts: string[] = [];
      if (state.rotate !== 0) parts.push(`rotated ${state.rotate}°`);
      if (state.flipH) parts.push('flipped horizontally');
      if (state.flipV) parts.push('flipped vertically');
      const mime = currentFile ? outputMimeFor(currentFile.type) : 'image/png';
      const formatNote = mime === 'image/png' ? 'Output: PNG, lossless.' : `Output: ${EXTENSIONS[mime].toUpperCase()}, re-encoded at quality 92.`;
      transformLabel.textContent = parts.length ? `Will be ${parts.join(' and ')}. ${formatNote}` : `No change selected yet. ${formatNote}`;

      applyButton.disabled = isNoOp(state);
      applyButton.classList.toggle('opacity-50', applyButton.disabled);
    }

    function turn(degrees: number) {
      state.rotate = (((state.rotate + degrees) % 360 + 360) % 360) as RotateAngle;
      render();
    }

    function handleFile(file: File) {
      if (!file.type.startsWith('image/')) {
        setStatus('This tool needs an image file.', true);
        return;
      }
      currentFile = file;
      state.rotate = 0;
      state.flipH = false;
      state.flipV = false;
      fileInfo.textContent = `${file.name} (${formatBytes(file.size)})`;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(file);
      preview.src = previewUrl;
      editPanel.classList.remove('hidden');
      dropzone.classList.add('hidden');
      setStatus(null);
      render();
    }

    document.querySelector('#rotate-left')!.addEventListener('click', () => turn(-90));
    document.querySelector('#rotate-right')!.addEventListener('click', () => turn(90));
    document.querySelector('#rotate-180')!.addEventListener('click', () => turn(180));
    document.querySelector('#flip-h')!.addEventListener('click', () => {
      state.flipH = !state.flipH;
      render();
    });
    document.querySelector('#flip-v')!.addEventListener('click', () => {
      state.flipV = !state.flipV;
      render();
    });
    document.querySelector('#clear-transform')!.addEventListener('click', () => {
      state.rotate = 0;
      state.flipH = false;
      state.flipV = false;
      render();
    });

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.dataset.dragging = 'false';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    applyButton.addEventListener('click', async () => {
      if (!currentFile || isNoOp(state)) return;
      setStatus('Applying…');
      try {
        const blob = await rotateImage(currentFile, state);
        const mime = outputMimeFor(currentFile.type);
        const stem = currentFile.name.replace(/\.[^./\\]+$/, '') || 'image';
        setStatus(null);
        if (outputUrl) URL.revokeObjectURL(outputUrl);
        outputUrl = URL.createObjectURL(blob);
        downloadLink.href = outputUrl;
        downloadLink.download = `${stem}-rotated.${EXTENSIONS[mime]}`;
        resultNote.textContent = `${formatBytes(currentFile.size)} → ${formatBytes(blob.size)}`;
        result.classList.remove('hidden');
        result.classList.remove('animate-pop-in');
        void result.offsetWidth;
        result.classList.add('animate-pop-in');
        editPanel.classList.add('hidden');
      } catch (err) {
        console.error(err);
        setStatus(`Something went wrong: ${err instanceof Error ? err.message : 'unknown error'}. Try a different file.`, true);
      }
    });

    resetButton.addEventListener('click', () => {
      currentFile = null;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      if (outputUrl) URL.revokeObjectURL(outputUrl);
      previewUrl = null;
      outputUrl = null;
      preview.removeAttribute('src');
      result.classList.add('hidden');
      editPanel.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });
  </script>
</Layout>
