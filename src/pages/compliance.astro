---
import Layout from '../layouts/Layout.astro';
import ComplianceIcon from '../components/ComplianceIcon.astro';
import { frameworks } from '../data/compliance';
import { CONTACT_EMAIL, SITE_URL, PUBLISHER_NAME } from '../data/site-config';

const title = 'Data Privacy and Compliance | Kit-Bin';
const description =
  'How Kit-Bin relates to GDPR, CCPA/CPRA, and HIPAA. Files are processed in your browser and never uploaded, so there is no server copy to retain, disclose, or erase.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Data Privacy and Compliance',
  description,
  url: `${SITE_URL}/compliance`,
  publisher: { '@type': 'Organization', name: PUBLISHER_NAME, url: SITE_URL },
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <div class="max-w-3xl mx-auto px-6 pt-10 pb-16 text-ink dark:text-slate-300 space-y-12">
    <header>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink dark:text-slate-100">
        Data Privacy and Compliance
      </h1>
      <p class="mt-3 text-lg text-muted dark:text-slate-400">
        Kit-Bin processes every file inside your browser. Nothing you convert is transmitted to a
        server, which changes what these frameworks actually have to say about it.
      </p>
    </header>

    <section class="rounded-2xl border border-border-soft dark:border-slate-800 bg-gradient-to-br from-primary-tint to-transparent dark:from-slate-900 dark:to-slate-900/40 p-6">
      <h2 class="text-lg font-semibold text-ink dark:text-slate-100">The short version</h2>
      <p class="mt-2 text-sm leading-relaxed">
        Most privacy questions about an online file tool come down to one thing: does my file leave
        my device? Here it does not. There is no upload step, no account, no server-side copy, and
        no database of user files. That removes most of the risk surface the rules below exist to
        manage, and it is verifiable rather than promised, using your own browser's Network panel.
      </p>
      <p class="mt-3 text-sm">
        <a href="/guides/how-kit-bin-works" class="font-medium text-primary dark:text-blue-400 hover:underline">Read how to verify it yourself</a>
      </p>
    </section>

    <section class="rounded-xl border-l-4 border-amber-400 bg-amber-50 dark:bg-amber-950/25 p-5">
      <h2 class="text-sm font-semibold text-ink dark:text-amber-200">
        What this page is, and what it is not
      </h2>
      <p class="mt-2 text-sm text-muted dark:text-amber-100/80 leading-relaxed">
        This is an explanation of how the site is built and how that maps onto each framework. It is
        not a certification, an audit result, or a seal issued by any regulator. Kit-Bin does not
        display compliance badges, because for these three laws no official badge exists: GDPR has
        no certification mark, the CCPA has no compliance logo, and there is no such thing as HIPAA
        certification. Any site showing you one of those badges made it up.
      </p>
    </section>

    {frameworks.map((fw) => (
      <section id={fw.id} class="scroll-mt-8">
        <div class="flex items-start gap-4">
          <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br ${fw.accent} text-white shadow-lg shadow-black/10`}>
            <ComplianceIcon icon={fw.icon} class="h-6 w-6" />
          </span>
          <div>
            <h2 class="text-xl font-bold text-ink dark:text-slate-100">{fw.short}</h2>
            <p class="text-sm text-muted dark:text-slate-400">{fw.name}</p>
            <p class="text-xs text-muted dark:text-slate-500 mt-0.5">{fw.region}</p>
          </div>
        </div>

        <p class="mt-4 font-medium text-ink dark:text-slate-200">{fw.summary}</p>

        <ul class="mt-4 space-y-2.5">
          {fw.points.map((p) => (
            <li class="flex gap-3 text-sm leading-relaxed">
              <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-primary dark:text-blue-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12.5l4 4L19 7" />
              </svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>

        <div class="mt-4 rounded-lg border border-border-soft dark:border-slate-800 bg-app-bg dark:bg-slate-900/60 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-500">
            Important limitation
          </p>
          <p class="mt-1.5 text-sm text-muted dark:text-slate-400 leading-relaxed">{fw.limitation}</p>
        </div>
      </section>
    ))}

    <section>
      <h2 class="text-xl font-bold text-ink dark:text-slate-100">What data does exist</h2>
      <p class="mt-2 text-sm leading-relaxed">
        Being precise matters more than claiming zero. Visiting any website creates some data, and
        pretending otherwise would undermine the part that is genuinely true.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-border-soft dark:border-slate-800 text-left">
              <th class="py-2 pr-4 font-semibold text-ink dark:text-slate-200">Data</th>
              <th class="py-2 pr-4 font-semibold text-ink dark:text-slate-200">Status</th>
            </tr>
          </thead>
          <tbody class="text-muted dark:text-slate-400">
            <tr class="border-b border-border-soft/60 dark:border-slate-800/60">
              <td class="py-2.5 pr-4">Contents of files you process</td>
              <td class="py-2.5 pr-4">Never transmitted. Stays in your browser's memory.</td>
            </tr>
            <tr class="border-b border-border-soft/60 dark:border-slate-800/60">
              <td class="py-2.5 pr-4">File names</td>
              <td class="py-2.5 pr-4">Never transmitted or logged.</td>
            </tr>
            <tr class="border-b border-border-soft/60 dark:border-slate-800/60">
              <td class="py-2.5 pr-4">Account details</td>
              <td class="py-2.5 pr-4">None exist. There is no sign-up.</td>
            </tr>
            <tr class="border-b border-border-soft/60 dark:border-slate-800/60">
              <td class="py-2.5 pr-4">Analytics and tracking</td>
              <td class="py-2.5 pr-4">None currently running.</td>
            </tr>
            <tr class="border-b border-border-soft/60 dark:border-slate-800/60">
              <td class="py-2.5 pr-4">Advertising cookies</td>
              <td class="py-2.5 pr-4">None currently set. No ads are live.</td>
            </tr>
            <tr class="border-b border-border-soft/60 dark:border-slate-800/60">
              <td class="py-2.5 pr-4">Favourites and theme choice</td>
              <td class="py-2.5 pr-4">Stored in your browser's own localStorage. Never sent anywhere.</td>
            </tr>
            <tr>
              <td class="py-2.5 pr-4">Server request logs</td>
              <td class="py-2.5 pr-4">Held by the hosting provider, as with any website. Includes IP address and user agent.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold text-ink dark:text-slate-100">Questions or corrections</h2>
      <p class="mt-2 text-sm leading-relaxed">
        If something on this page is wrong, or your organisation needs a detail clarified before
        approving the site for use, get in touch at{' '}
        <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary dark:text-blue-400 hover:underline">{CONTACT_EMAIL}</a>.
        The full{' '}
        <a href="/privacy" class="text-primary dark:text-blue-400 hover:underline">privacy policy</a>{' '}
        and{' '}
        <a href="/terms" class="text-primary dark:text-blue-400 hover:underline">terms</a>{' '}
        cover the rest.
      </p>
      <p class="mt-4 text-xs text-muted dark:text-slate-500">
        This page describes technical architecture. It is not legal advice. If you handle regulated
        data, confirm your intended use with your own privacy officer or counsel.
      </p>
    </section>
  </div>
</Layout>
