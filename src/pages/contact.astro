---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../data/site-config';
---

<Layout title="Contact | Kit-Bin" description="How to get in touch with Kit-Bin.">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6 text-slate-900 dark:text-slate-100">Contact</h1>
    <p class="text-slate-700 dark:text-slate-300">
      For questions, bug reports, or anything else: <a href={`mailto:${CONTACT_EMAIL}`} class="underline">{CONTACT_EMAIL}</a>
    </p>
  </div>
</Layout>
