---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../data/site-config';
---

<Layout
  title="Contact Kit-Bin | Free Browser-Based File Tools"
  description="Questions, bug reports, or feedback about Kit-Bin's file tools — get in touch by email."
>
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6 text-slate-900 dark:text-slate-100">Contact</h1>
    <p class="text-slate-700 dark:text-slate-300">
      For questions, bug reports, or anything else:
      <a href={`mailto:${CONTACT_EMAIL}`} class="text-blue-600 dark:text-blue-400 hover:underline">{CONTACT_EMAIL}</a>
    </p>
    <p class="mt-4 text-slate-700 dark:text-slate-300">
      If a tool produced an unexpected result, it helps to mention which tool, your browser, and
      roughly how large the file was — that's usually enough to reproduce the issue.
    </p>
  </div>
</Layout>
