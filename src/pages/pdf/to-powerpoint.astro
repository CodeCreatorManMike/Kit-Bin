---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is my PDF uploaded to a server?',
    a: 'No. Every page is rendered and packaged into a .pptx file entirely in your browser. Nothing is uploaded to Kit-Bin or anywhere else.',
  },
  {
    q: 'Will it actually look the same as the PDF?',
    a: "Yes — each PDF page becomes a picture of that exact page, filling its own slide. There's no text/layout reconstruction involved, so there's no formatting to lose: what the page looks like is what the slide looks like.",
  },
  {
    q: "What's the catch, then?",
    a: "Each slide is a picture, not editable text, shapes, or a real background. You can't click into it in PowerPoint and edit a sentence the way you could in a document made from scratch. This trades editability for exact visual fidelity — for the reverse tradeoff (editable text, not a visual copy), use PDF to Word instead.",
  },
  {
    q: 'What if my PDF has pages of different sizes?',
    a: "The presentation uses one slide size, taken from the first page. Any page with a different aspect ratio is scaled down to fit within that slide size and centered — never stretched out of its own proportions — so it may show up smaller with space around it rather than filling the slide edge to edge.",
  },
  {
    q: 'How sharp will the images be?',
    a: 'Each page is rendered at 2x resolution before being placed on its slide, the same rendering Kit-Bin uses for PDF to PNG — sharp enough for on-screen presentation and reasonable print quality, not a blurry screenshot.',
  },
  {
    q: 'What file do I get?',
    a: 'A standard .pptx file that opens in Microsoft PowerPoint, Google Slides, LibreOffice Impress, and Apple Keynote.',
  },
];
---

<Layout
  title="PDF to PowerPoint Converter, Keep the Exact Look | Kit-Bin"
  description="Convert a PDF into a PowerPoint (.pptx) presentation, one slide per page, pixel-identical to the original. Private, free, and no account required."
>
  <ToolSchema
    name="PDF to PowerPoint"
    description="Convert a PDF into a PowerPoint (.pptx) presentation, one slide per page, pixel-identical to the original. Private, free, and no account required."
    faqs={faqs}
  />

  <ToolHeader title="Convert PDF to PowerPoint, Pixel for Pixel" />
  <ToolWidget accept="application/pdf" multiple dropLabel="Drop PDF files here or click to browse" />
  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Turn a PDF into a .pptx presentation without uploading it anywhere, one slide per page,
      looking exactly like the original. Rather than trying to reconstruct fonts, colors, and
      layout as editable shapes — the kind of conversion that always loses something — each page
      is rendered as a picture and placed full-size on its own slide. There's nothing to
      approximate, because the slide simply is the page.
    </p>
    <div>
      <h2 class="tool-h2 font-semibold text-lg">The tradeoff, up front</h2>
      <p class="mt-2 text-muted dark:text-slate-400">
        Exact visual fidelity means each slide is a picture, not editable text or shapes — you get
        a presentation that looks right immediately, at the cost of not being able to click in and
        edit a sentence the way you could with a deck built from scratch. If you need the words
        editable more than you need pixel-identical pages, convert to{' '}
        <a href="/pdf/to-word/" class="text-primary dark:text-blue-400 hover:underline">Word</a>{' '}
        instead, which reconstructs the text but not the exact layout.
      </p>
    </div>
    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3"><FaqAccordion faqs={faqs} /></div>
    </div>
    <p class="text-sm">
      Just want images of each page, not a presentation file? Try{' '}
      <a href="/pdf/to-images/" class="text-primary dark:text-blue-400 hover:underline">PDF to PNG</a>.
      Going the other direction from a deck? Try{' '}
      <a href="/data/ppt-to-word/" class="text-primary dark:text-blue-400 hover:underline">PowerPoint to Word</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdBanner placement="tool-page:pdf/to-powerpoint" />
  </div>

  <script>
    import { pdfToPowerpoint } from '../../lib/pdf/toPowerpoint';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      multiple: true,
      batchZipName: 'kit-bin-pdf-to-powerpoint.zip',
      validate: (files) =>
        files.some((f) => f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf'))
          ? 'This tool only accepts PDF files.'
          : null,
      runEach: async (file, reportProgress) => {
        const result = await pdfToPowerpoint(file, reportProgress);
        return {
          blob: result.blob,
          filename: result.filename,
          note: `Converted ${result.pageCount} page${result.pageCount === 1 ? '' : 's'} to a PowerPoint presentation.`,
        };
      },
    });
  </script>
</Layout>
