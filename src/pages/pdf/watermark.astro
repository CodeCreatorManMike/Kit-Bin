---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Can I remove the watermark later?',
    a: 'Not with this tool. The watermark becomes a permanent part of the page content, drawn directly onto each page.',
  },
  {
    q: 'Is this the same as password protection?',
    a: "No. A visible watermark discourages casual reuse and marks a document as a draft, confidential, or otherwise, but it doesn't restrict who can open, copy, or edit the file. It's not access control or encryption.",
  },
  {
    q: 'Is the watermark added to every page?',
    a: 'Yes, at the same position, size, and opacity on every page in the document.',
  },
];
---

<Layout
  title="Add a Text Watermark to PDF Pages | Kit-Bin"
  description="Stamp a text watermark on every page of a PDF. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Watermark PDF"
    description="Stamp a text watermark on every page of a PDF. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Watermark a PDF Online" />

  <div class="max-w-2xl mx-auto px-4 mb-4 flex items-center justify-center gap-2 text-sm">
    <label for="watermark-text">Watermark text:</label>
    <input id="watermark-text" type="text" value="CONFIDENTIAL" class="rounded border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-2 py-1" />
  </div>

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Set your watermark text, "DRAFT," "CONFIDENTIAL," a name, a date, and drop your PDF above.
      A semi-transparent stamp is drawn diagonally across every page, then the file downloads
      automatically once ready.
    </p>
    <p class="text-muted dark:text-slate-400">
      A visible watermark is a signal, not a lock: it makes a document's status obvious at a
      glance and discourages someone from passing it off as final, but it doesn't stop anyone from
      opening, copying, or printing the file.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:pdf/watermark" />
  </div>

  <script>
    import { watermarkPdf } from '../../lib/pdf/watermark';
    import { getToolElements, wireTool } from '../../lib/ui';

    const textInput = document.querySelector<HTMLInputElement>('#watermark-text')!;
    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files) => {
        const blob = await watermarkPdf(files[0], textInput.value || 'CONFIDENTIAL');
        return { blob, filename: files[0].name.replace(/\.pdf$/i, '-watermarked.pdf') };
      },
    });
  </script>
</Layout>
