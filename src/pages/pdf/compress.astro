---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Will this affect quality?',
    a: 'Embedded JPEG photos are recompressed at a lower quality setting; text, vector graphics, and fonts are untouched.',
  },
  {
    q: 'How much smaller will my file be?',
    a: 'Depends entirely on what the PDF contains. A scanned document or photo-heavy PDF can shrink significantly; a text-only PDF with no embedded images will barely change, since there are no images to recompress.',
  },
  {
    q: 'Why did my file barely shrink at all?',
    a: "This tool only recompresses embedded JPEG images — it doesn't touch PNG-encoded images, fonts, or document structure. If your PDF is mostly text, or its images are already heavily compressed, there's little left to reduce.",
  },
  {
    q: 'Can I compress a PDF that already went through this tool once?',
    a: "Yes, but expect close to zero further reduction — you're re-compressing already-lossy JPEG data, which loses more visible quality for very little size benefit each additional pass.",
  },
];
---

<Layout
  title="Compress PDF Online — Reduce PDF File Size | Kit-Bin"
  description="Shrink a PDF by recompressing its embedded photos. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Compress PDF"
    description="Shrink a PDF by recompressing its embedded photos. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Compress a PDF Without Uploading It</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Drop a PDF above and it downloads a smaller version automatically once ready — no settings
      to configure. Under the hood, this tool finds every embedded JPEG image in the document,
      decodes it, and re-encodes it at a lower quality setting.
    </p>

    <div>
      <h2 class="font-semibold text-lg">What this changes, specifically</h2>
      <p class="text-muted dark:text-slate-400">
        Embedded JPEG photos are recompressed. Text stays as real, selectable text — it is never
        rasterized. Vector graphics, fonts, and document structure are left exactly as they were.
        PNG-encoded images inside the PDF are also left untouched, since they're typically
        interface graphics or diagrams where visible artifacts would be more noticeable relative
        to the size saved.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-lg">When this won't help much</h2>
      <p class="text-muted dark:text-slate-400">
        A text-only contract, invoice, or report has no embedded photos to recompress, so
        compression will do close to nothing — that's expected, not a bug. A PDF that's already
        been compressed once (by this tool, or another one using similar JPEG re-encoding) will
        also show diminishing returns on a second pass.
      </p>
    </div>

    <p class="text-sm">
      Curious what's actually making your file large in the first place?
      <a href="/guides/why-pdfs-get-large" class="text-primary dark:text-blue-400 hover:underline">Read: Why Is My PDF So Big?</a>
    </p>

    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-muted dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>

    <p class="text-sm">
      Need to change page order or remove pages first? Try
      <a href="/pdf/reorder-pages" class="text-primary dark:text-blue-400 hover:underline">Reorder PDF Pages</a>
      or <a href="/pdf/split" class="text-primary dark:text-blue-400 hover:underline">Split PDF</a>.
    </p>
  </div>

  <script>
    import { compressPdf } from '../../lib/pdf/compress';
    import { getToolElements, wireTool } from '../../lib/ui';

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files, reportProgress) => {
        const { blob, originalSize, compressedSize } = await compressPdf(files[0], 60, reportProgress);
        const pct = Math.round((1 - compressedSize / originalSize) * 100);
        const note = `${formatBytes(originalSize)} → ${formatBytes(compressedSize)}${pct > 0 ? ` (${pct}% smaller)` : ''}`;
        return { blob, filename: files[0].name.replace(/\.pdf$/i, '-compressed.pdf'), note };
      },
    });
  </script>
</Layout>
