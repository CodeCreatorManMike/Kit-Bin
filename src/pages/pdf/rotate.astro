---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Rotate PDF Online — Free & No Upload Required | Kit-Bin"
  description="Rotate every page in a PDF in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Rotate PDF"
    description="Rotate every page in a PDF in seconds. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={[
    {
      "q": "Does it rotate every page the same way?",
      "a": "Yes — all pages rotate by the same amount you select."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Rotate PDF — Free</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <div class="max-w-2xl mx-auto px-4 mb-4 flex items-center justify-center gap-2 text-sm">
    <label for="rotate-amount">Rotate:</label>
    <select id="rotate-amount" class="rounded border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-2 py-1">
      <option value="90">90° clockwise</option>
      <option value="180">180°</option>
      <option value="270">270° clockwise</option>
    </select>
  </div>

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-4">
    <p>This tool rotates every page in a PDF by a fixed amount.</p>
    <p>Choose a rotation, then drop your PDF above. The rotated file downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Does it rotate every page the same way?</p>
      <p class="text-muted dark:text-slate-400">Yes — all pages rotate by the same amount you select.</p>
    </div>
  </div>

  <script>
    import { rotatePdf } from '../../lib/pdf/rotate';
    import { getToolElements, wireTool } from '../../lib/ui';

    const select = document.querySelector<HTMLSelectElement>('#rotate-amount')!;
    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files) => {
        const amount = parseInt(select.value, 10) as 90 | 180 | 270;
        const blob = await rotatePdf(files[0], amount);
        return { blob, filename: files[0].name.replace(/\.pdf$/i, '-rotated.pdf') };
      },
    });
  </script>
</Layout>
