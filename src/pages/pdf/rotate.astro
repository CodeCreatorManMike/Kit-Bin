---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Does it rotate every page the same way?',
    a: 'Yes, all pages rotate by the same amount you select. Rotating individual pages to different orientations isn\'t supported yet.',
  },
  {
    q: 'Is this permanent, or just how my viewer displays it?',
    a: "Permanent. The rotation is written into the saved PDF's page data, so it opens rotated correctly in any PDF viewer, not just the one you used to check it.",
  },
  {
    q: 'Does rotating affect quality?',
    a: "No, this changes the page's rotation metadata, not its content. Text and images are untouched.",
  },
];
---

<Layout
  title="Rotate PDF Pages Online and Save Them | Kit-Bin"
  description="Rotate every page in a PDF and save the new orientation permanently. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Rotate PDF"
    description="Rotate every page in a PDF and save the new orientation permanently. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-ink dark:text-slate-100">Rotate PDF Pages Permanently</h1>
    <p class="mt-2 text-muted dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <div class="max-w-2xl mx-auto px-4 mb-4 flex items-center justify-center gap-2 text-sm">
    <label for="rotate-amount">Rotate:</label>
    <select id="rotate-amount" class="rounded border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-2 py-1">
      <option value="90">90° clockwise</option>
      <option value="180">180°</option>
      <option value="270">270° clockwise</option>
    </select>
  </div>

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Choose a rotation, drop your PDF above, and every page rotates by the same amount,
      permanently, not just in whatever viewer you happen to open it in next. This is different
      from rotating the view in a PDF reader, which resets the next time someone else opens the
      file; this tool changes what's actually saved.
    </p>
    <p class="text-muted dark:text-slate-400">
      This tool rotates the whole document by one amount. If only some pages are sideways, a
      common case with scanned documents, you'll need to accept rotating every page and check
      the result, since selecting individual pages for different rotations isn't supported yet.
    </p>

    <div>
      <h2 class="font-semibold text-lg pt-2">FAQ</h2>
      <div class="space-y-4 mt-2">
        {faqs.map((f) => (
          <div>
            <p class="font-medium">{f.q}</p>
            <p class="text-muted dark:text-slate-400">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    import { rotatePdf } from '../../lib/pdf/rotate';
    import { getToolElements, wireTool } from '../../lib/ui';

    const select = document.querySelector<HTMLSelectElement>('#rotate-amount')!;
    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files) => {
        const amount = parseInt(select.value, 10) as 90 | 180 | 270;
        const blob = await rotatePdf(files[0], amount);
        return { blob, filename: files[0].name.replace(/\.pdf$/i, '-rotated.pdf') };
      },
    });
  </script>
</Layout>
