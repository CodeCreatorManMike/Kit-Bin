---
import Layout from '../../layouts/Layout.astro';
import CategorySchema from '../../components/CategorySchema.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { categoryColors, categoryIconPaths } from '../../data/toolIcons';

const pdfTools = tools.filter((t) => t.category === 'pdf');
const meta = categoryColors.pdf;
---

<Layout title="Free PDF Tools | Kit-Bin" description="Merge, split, compress, rotate, watermark, and reorganize PDF files entirely in your browser.">
  <CategorySchema categoryName="PDF Tools" />
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div class="flex items-center gap-3">
      <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${meta.gradient} text-white shadow-lg shadow-black/10`}>
        <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d={categoryIconPaths.pdf} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-slate-100">Free PDF Tools</h1>
    </div>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Combine, separate, reorganize, compress, watermark, rotate, and convert PDF documents
      without installing a full PDF editor for a single task. Every tool below runs entirely in
      your browser. The PDF you select is never uploaded anywhere.
    </p>
    <p class="mt-3 text-muted dark:text-slate-400 max-w-2xl">
      Not sure why a PDF is larger than it should be, or what compression actually changes inside
      it? Read <a href="/guides/why-pdfs-get-large" class="text-primary dark:text-blue-400 hover:underline">Why Is My PDF So Big?</a> for a breakdown of what makes PDFs grow and shrink.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {pdfTools.map((t) => <ToolCard tool={t} />)}
    </div>
  </div>
</Layout>
