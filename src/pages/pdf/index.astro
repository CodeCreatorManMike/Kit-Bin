---
import Layout from '../../layouts/Layout.astro';
import { tools } from '../../data/tools';

const pdfTools = tools.filter((t) => t.category === 'pdf');
---

<Layout title="Free PDF Tools | ToolKit" description="Merge, split, and compress PDF files entirely in your browser.">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold">Free PDF Tools</h1>
    <p class="mt-2 text-slate-600">All PDF tools run entirely in your browser. Files are never uploaded.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {pdfTools.map((t) => (
        <a href={t.slug} class="block rounded-xl border border-slate-200 p-5 hover:border-slate-400">
          <p class="font-semibold">{t.name}</p>
          <p class="mt-1 text-sm text-slate-600">{t.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
