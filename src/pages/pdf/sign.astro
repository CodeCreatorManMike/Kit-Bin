---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is this a legally-binding e-signature?',
    a: 'No. This adds a visual signature image to the page, the same as printing a document and signing it by hand, then scanning it back in. It is not a cryptographic e-signature like DocuSign or Adobe Sign, and it does not create an audit trail, identity verification, or legal certification. For contracts that require a certified e-signature, use a dedicated e-signature service instead.',
  },
  {
    q: 'Can I draw my signature with a mouse?',
    a: "Yes, though a trackpad, touchscreen, or stylus usually gives a smoother result. If drawing feels imprecise, switch to \"Type\" mode and enter your name in a cursive font instead — many people find that reads more cleanly than a mouse-drawn signature anyway.",
  },
  {
    q: 'Does the signature apply to every page?',
    a: 'You choose: all pages, only the first page, or only the last page. Most signature use cases (title pages, final signature blocks) need just one of the last two.',
  },
  {
    q: 'Is my file uploaded anywhere?',
    a: 'No. The PDF, your drawn or typed signature, and the signed result all stay in your browser. Nothing is sent to a server.',
  },
  {
    q: 'Can I remove or edit the signature after signing?',
    a: 'Not with this tool. The signature is drawn directly onto the page as part of the PDF content, the same as the watermark tool. Keep your original unsigned file if you might need to re-sign or adjust placement later.',
  },
];
---

<Layout
  title="Sign a PDF Online, Free & No Upload Required | Kit-Bin"
  description="Draw or type a signature and place it on a PDF page. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Sign PDF"
    description="Draw or type a signature and place it on a PDF page. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Sign a PDF Online" />

  <div class="max-w-2xl mx-auto px-4">
    <div
      id="dropzone"
      role="button"
      tabindex="0"
      class="group relative cursor-pointer overflow-hidden rounded-2xl border-2 border-dashed border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900/60 px-6 py-12 text-center transition-all duration-200 hover:border-primary/50 hover:bg-primary-tint/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-900 hover:shadow-[0_10px_30px_rgba(16,24,47,0.08)] data-[dragging=true]:border-primary data-[dragging=true]:bg-primary-tint/60 data-[dragging=true]:scale-[1.01] dark:data-[dragging=true]:bg-blue-950/30"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.06] via-transparent to-violet-500/[0.06] opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-data-[dragging=true]:opacity-100"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <span class="relative mx-auto grid h-14 w-14 place-items-center">
          <span
            class="absolute inset-0 rounded-full bg-primary/20 opacity-0 group-data-[dragging=true]:opacity-100 group-data-[dragging=true]:animate-pulse-ring"
            aria-hidden="true"></span>
          <span
            class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet-500 text-white shadow-lg shadow-primary/25 transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-3 group-data-[dragging=true]:scale-110"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4" />
              <path d="M8 8l4-4 4 4" />
              <path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" />
            </svg>
          </span>
        </span>

        <p class="mt-4 text-lg font-semibold text-ink dark:text-slate-100">Drop a PDF file here or click to browse</p>
        <p class="mt-1 text-xs text-muted dark:text-slate-500">Processed entirely in your browser. Never uploaded to a server.</p>
        <p id="file-info" class="mt-2 text-sm font-medium text-primary dark:text-blue-400"></p>
        <input id="file-input" type="file" accept="application/pdf" class="hidden" />
      </div>
    </div>

    <div id="sign-panel" class="hidden mt-4 rounded-2xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 p-5 space-y-5">
      <div>
        <div class="flex items-center gap-2 text-sm font-medium text-ink dark:text-slate-100">
          <button id="mode-draw" type="button" class="rounded-lg px-3 py-1.5 border border-primary bg-primary-tint/60 dark:bg-blue-950/40 text-primary dark:text-blue-400" aria-pressed="true">Draw</button>
          <button id="mode-type" type="button" class="rounded-lg px-3 py-1.5 border border-border-soft dark:border-slate-700 text-muted dark:text-slate-400" aria-pressed="false">Type</button>
        </div>

        <div id="draw-mode" class="mt-3">
          <p class="text-xs text-muted dark:text-slate-500 mb-1.5">Draw your signature with a mouse, trackpad, or touch.</p>
          <canvas
            id="sig-canvas"
            width="400"
            height="150"
            class="w-full max-w-sm touch-none rounded-lg border border-border-soft dark:border-slate-700 bg-[repeating-linear-gradient(45deg,theme(colors.slate.100)_0,theme(colors.slate.100)_10px,transparent_10px,transparent_20px)] dark:bg-[repeating-linear-gradient(45deg,theme(colors.slate.800)_0,theme(colors.slate.800)_10px,transparent_10px,transparent_20px)]"
          ></canvas>
          <button id="clear-canvas" type="button" class="mt-2 text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 hover:text-ink dark:hover:text-slate-200">Clear</button>
        </div>

        <div id="type-mode" class="hidden mt-3">
          <p class="text-xs text-muted dark:text-slate-500 mb-1.5">Type your name — it's rendered in a cursive font as your signature.</p>
          <input id="type-input" type="text" placeholder="Your name" class="w-full max-w-sm rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 px-3 py-2" />
          <canvas id="type-preview-canvas" width="400" height="150" class="mt-2 w-full max-w-sm rounded-lg border border-border-soft dark:border-slate-700 bg-[repeating-linear-gradient(45deg,theme(colors.slate.100)_0,theme(colors.slate.100)_10px,transparent_10px,transparent_20px)] dark:bg-[repeating-linear-gradient(45deg,theme(colors.slate.800)_0,theme(colors.slate.800)_10px,transparent_10px,transparent_20px)]"></canvas>
        </div>
      </div>

      <div>
        <p class="text-sm font-medium text-ink dark:text-slate-100 mb-1.5">Apply to</p>
        <div class="flex flex-wrap gap-3 text-sm text-ink dark:text-slate-200">
          <label class="flex items-center gap-1.5"><input type="radio" name="page-target" value="all" checked /> All pages</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="page-target" value="first" /> First page only</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="page-target" value="last" /> Last page only</label>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-ink dark:text-slate-100 mb-1.5">Position</p>
          <select id="position-select" class="rounded-lg border border-border-soft dark:border-slate-700 bg-surface dark:bg-slate-900 text-ink dark:text-slate-100 text-sm px-2 py-1">
            <option value="top-left">Top left</option>
            <option value="top-right">Top right</option>
            <option value="bottom-left">Bottom left</option>
            <option value="bottom-right" selected>Bottom right</option>
            <option value="custom">Custom (drag)</option>
          </select>
        </div>
        <label class="mt-2 flex items-center gap-2 text-sm text-ink dark:text-slate-200">
          Size
          <input id="size-range" type="range" min="10" max="50" value="28" class="flex-1" />
        </label>

        <p class="mt-2 text-xs text-muted dark:text-slate-500">Drag the signature on the preview below to fine-tune its position.</p>
        <div id="page-preview" class="relative mt-2 border border-border-soft dark:border-slate-700 bg-white mx-auto" style="width: 240px;">
          <img id="preview-sig" alt="" class="absolute cursor-move select-none" draggable="false" style="left:0; top:0;" />
        </div>
      </div>

      <button id="apply-button" class="rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed">
        Sign PDF
      </button>
    </div>

    <div id="status" class="hidden mt-4" role="status" aria-live="polite">
      <div class="rounded-xl border border-border-soft dark:border-slate-800 bg-surface dark:bg-slate-900 px-4 py-3">
        <p data-status-text class="text-center text-sm font-medium text-ink dark:text-slate-200"></p>
        <div data-status-bar class="mt-2.5 h-1 overflow-hidden rounded-full bg-app-bg dark:bg-slate-800">
          <div class="h-full w-full animate-shimmer rounded-full" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div
      id="result"
      class="hidden mt-4 overflow-hidden rounded-2xl border border-emerald-300/70 dark:border-emerald-500/25 bg-gradient-to-br from-emerald-50 to-surface dark:from-emerald-950/25 dark:to-slate-900 p-6 text-center"
    >
      <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path class="animate-draw-check" d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <p class="mt-2.5 font-semibold text-ink dark:text-slate-100">Done</p>
      <p data-result-note class="mt-0.5 text-sm text-muted dark:text-slate-400"></p>

      <a
        id="download-link"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-violet-500 px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v12" />
          <path d="M8 12l4 4 4-4" />
          <path d="M4 20h16" />
        </svg>
        Download result
      </a>

      <button id="reset-button" class="mt-4 block w-full text-sm text-muted dark:text-slate-400 underline decoration-dotted underline-offset-2 transition-colors hover:text-ink dark:hover:text-slate-200">
        Sign another file
      </button>
    </div>
  </div>

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      This tool adds a visual signature to a PDF — draw it with your mouse or finger, or type your
      name in a cursive font, then place it on the page and download the signed file.
    </p>
    <p>
      Drop your PDF above, draw or type your signature, choose which page(s) it goes on and where,
      then click "Sign PDF." The result downloads as a new file — your original is left untouched.
    </p>
    <p class="text-muted dark:text-slate-400">
      This is a visual stamp, not a cryptographic e-signature. It doesn't provide identity
      verification, an audit trail, or legal certification the way a dedicated e-signature service
      (DocuSign, Adobe Sign) does — it's the digital equivalent of printing, signing by hand, and
      scanning a document back in.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Related tools:
      <a href="/pdf/watermark" class="text-primary dark:text-blue-400 hover:underline">Watermark PDF</a>,
      <a href="/pdf/merge" class="text-primary dark:text-blue-400 hover:underline">Merge PDF</a>,
      <a href="/pdf/page-numbers" class="text-primary dark:text-blue-400 hover:underline">Add Page Numbers</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:pdf/sign" />
  </div>

  <script>
    import { signPdf, getPdfPreviewInfo, type SignPageTarget } from '../../lib/pdf/sign';

    const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
    const fileInput = document.querySelector<HTMLInputElement>('#file-input')!;
    const fileInfo = document.querySelector<HTMLElement>('#file-info')!;
    const signPanel = document.querySelector<HTMLElement>('#sign-panel')!;
    const status = document.querySelector<HTMLElement>('#status')!;
    const result = document.querySelector<HTMLElement>('#result')!;
    const downloadLink = document.querySelector<HTMLAnchorElement>('#download-link')!;
    const resultNote = result.querySelector<HTMLElement>('[data-result-note]')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;
    const applyButton = document.querySelector<HTMLButtonElement>('#apply-button')!;

    const modeDrawBtn = document.querySelector<HTMLButtonElement>('#mode-draw')!;
    const modeTypeBtn = document.querySelector<HTMLButtonElement>('#mode-type')!;
    const drawModeEl = document.querySelector<HTMLElement>('#draw-mode')!;
    const typeModeEl = document.querySelector<HTMLElement>('#type-mode')!;
    const sigCanvas = document.querySelector<HTMLCanvasElement>('#sig-canvas')!;
    const clearCanvasBtn = document.querySelector<HTMLButtonElement>('#clear-canvas')!;
    const typeInput = document.querySelector<HTMLInputElement>('#type-input')!;
    const typePreviewCanvas = document.querySelector<HTMLCanvasElement>('#type-preview-canvas')!;

    const positionSelect = document.querySelector<HTMLSelectElement>('#position-select')!;
    const sizeRange = document.querySelector<HTMLInputElement>('#size-range')!;
    const pagePreview = document.querySelector<HTMLElement>('#page-preview')!;
    const previewSig = document.querySelector<HTMLImageElement>('#preview-sig')!;

    const statusText = status.querySelector<HTMLElement>('[data-status-text]')!;
    const statusBar = status.querySelector<HTMLElement>('[data-status-bar]')!;

    let currentFile: File | null = null;
    let activeObjectUrl: string | null = null;
    let pageAspect = 1; // pageWidth / pageHeight
    let mode: 'draw' | 'type' = 'draw';
    let hasSignature = false;

    // Normalized (0-1, top-left origin) position of the signature box's top-left corner.
    let posX = 0.62;
    let posY = 0.8;

    function setStatus(msg: string | null, isError = false) {
      statusText.textContent = msg ?? '';
      status.classList.toggle('hidden', !msg);
      statusBar.classList.toggle('hidden', isError);
      statusText.classList.toggle('text-red-600', isError);
      statusText.classList.toggle('dark:text-red-400', isError);
    }

    // ---------- Draw mode (pointer events cover mouse + touch + pen) ----------
    const ctx = sigCanvas.getContext('2d')!;
    let drawing = false;
    let lastX = 0;
    let lastY = 0;

    function canvasHasInk(): boolean {
      const data = ctx.getImageData(0, 0, sigCanvas.width, sigCanvas.height).data;
      for (let i = 3; i < data.length; i += 4) {
        if (data[i] !== 0) return true;
      }
      return false;
    }

    function canvasPoint(e: PointerEvent): { x: number; y: number } {
      const rect = sigCanvas.getBoundingClientRect();
      const scaleX = sigCanvas.width / rect.width;
      const scaleY = sigCanvas.height / rect.height;
      return { x: (e.clientX - rect.left) * scaleX, y: (e.clientY - rect.top) * scaleY };
    }

    sigCanvas.addEventListener('pointerdown', (e) => {
      drawing = true;
      sigCanvas.setPointerCapture(e.pointerId);
      const p = canvasPoint(e);
      lastX = p.x;
      lastY = p.y;
    });
    sigCanvas.addEventListener('pointermove', (e) => {
      if (!drawing) return;
      const p = canvasPoint(e);
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(lastX, lastY);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      lastX = p.x;
      lastY = p.y;
    });
    function stopDrawing() {
      if (!drawing) return;
      drawing = false;
      updateSignaturePreview();
    }
    sigCanvas.addEventListener('pointerup', stopDrawing);
    sigCanvas.addEventListener('pointercancel', stopDrawing);
    sigCanvas.addEventListener('pointerleave', () => {
      if (drawing) stopDrawing();
    });

    clearCanvasBtn.addEventListener('click', () => {
      ctx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
      updateSignaturePreview();
    });

    // ---------- Type mode ----------
    const typeCtx = typePreviewCanvas.getContext('2d')!;
    function renderTypedSignature() {
      typeCtx.clearRect(0, 0, typePreviewCanvas.width, typePreviewCanvas.height);
      const text = typeInput.value.trim();
      if (!text) {
        updateSignaturePreview();
        return;
      }
      typeCtx.fillStyle = '#1e293b';
      typeCtx.textBaseline = 'middle';
      typeCtx.textAlign = 'center';
      let fontSize = 64;
      typeCtx.font = `${fontSize}px cursive`;
      while (typeCtx.measureText(text).width > typePreviewCanvas.width - 30 && fontSize > 16) {
        fontSize -= 2;
        typeCtx.font = `${fontSize}px cursive`;
      }
      typeCtx.fillText(text, typePreviewCanvas.width / 2, typePreviewCanvas.height / 2);
      updateSignaturePreview();
    }
    typeInput.addEventListener('input', renderTypedSignature);

    // ---------- Mode toggle ----------
    function setMode(next: 'draw' | 'type') {
      mode = next;
      drawModeEl.classList.toggle('hidden', next !== 'draw');
      typeModeEl.classList.toggle('hidden', next !== 'type');
      modeDrawBtn.setAttribute('aria-pressed', String(next === 'draw'));
      modeTypeBtn.setAttribute('aria-pressed', String(next === 'type'));
      modeDrawBtn.classList.toggle('border-primary', next === 'draw');
      modeDrawBtn.classList.toggle('text-primary', next === 'draw');
      modeDrawBtn.classList.toggle('dark:text-blue-400', next === 'draw');
      modeDrawBtn.classList.toggle('bg-primary-tint/60', next === 'draw');
      modeDrawBtn.classList.toggle('dark:bg-blue-950/40', next === 'draw');
      modeTypeBtn.classList.toggle('border-primary', next === 'type');
      modeTypeBtn.classList.toggle('text-primary', next === 'type');
      modeTypeBtn.classList.toggle('dark:text-blue-400', next === 'type');
      modeTypeBtn.classList.toggle('bg-primary-tint/60', next === 'type');
      modeTypeBtn.classList.toggle('dark:bg-blue-950/40', next === 'type');
      updateSignaturePreview();
    }
    modeDrawBtn.addEventListener('click', () => setMode('draw'));
    modeTypeBtn.addEventListener('click', () => setMode('type'));

    // ---------- Live signature preview + drag-to-position ----------
    function updateSignaturePreview() {
      const sourceCanvas = mode === 'draw' ? sigCanvas : typePreviewCanvas;
      hasSignature = mode === 'draw' ? canvasHasInk() : typeInput.value.trim().length > 0;
      applyButton.disabled = !hasSignature || !currentFile;

      if (!hasSignature) {
        previewSig.removeAttribute('src');
        previewSig.style.display = 'none';
        return;
      }
      const dataUrl = sourceCanvas.toDataURL('image/png');
      previewSig.src = dataUrl;
      previewSig.style.display = '';
      layoutPreview();
    }

    function widthNorm(): number {
      return parseInt(sizeRange.value, 10) / 100;
    }

    function heightNorm(): number {
      // Signature canvases are always 400x150 (aspect 0.375), scaled to the page.
      const imgAspect = 150 / 400;
      return widthNorm() * pageAspect * imgAspect;
    }

    function layoutPreview() {
      const wN = widthNorm();
      const hN = heightNorm();
      previewSig.style.width = `${wN * 100}%`;
      previewSig.style.height = `${hN * 100}%`;
      previewSig.style.left = `${posX * 100}%`;
      previewSig.style.top = `${posY * 100}%`;
    }

    function applyPreset(preset: string) {
      const wN = widthNorm();
      const hN = heightNorm();
      const margin = 0.04;
      switch (preset) {
        case 'top-left':
          posX = margin;
          posY = margin;
          break;
        case 'top-right':
          posX = 1 - margin - wN;
          posY = margin;
          break;
        case 'bottom-left':
          posX = margin;
          posY = 1 - margin - hN;
          break;
        case 'bottom-right':
          posX = 1 - margin - wN;
          posY = 1 - margin - hN;
          break;
        default:
          // custom — keep current position
          break;
      }
      layoutPreview();
    }

    positionSelect.addEventListener('change', () => applyPreset(positionSelect.value));
    sizeRange.addEventListener('input', () => {
      if (positionSelect.value !== 'custom') applyPreset(positionSelect.value);
      else layoutPreview();
    });

    // Drag the signature within the page-preview box.
    let dragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;

    previewSig.addEventListener('pointerdown', (e) => {
      if (!hasSignature) return;
      dragging = true;
      previewSig.setPointerCapture(e.pointerId);
      const rect = pagePreview.getBoundingClientRect();
      const curLeftPx = (posX * rect.width);
      const curTopPx = (posY * rect.height);
      dragOffsetX = e.clientX - rect.left - curLeftPx;
      dragOffsetY = e.clientY - rect.top - curTopPx;
    });
    previewSig.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const rect = pagePreview.getBoundingClientRect();
      const wN = widthNorm();
      const hN = heightNorm();
      let nx = (e.clientX - rect.left - dragOffsetX) / rect.width;
      let ny = (e.clientY - rect.top - dragOffsetY) / rect.height;
      nx = Math.max(0, Math.min(1 - wN, nx));
      ny = Math.max(0, Math.min(1 - hN, ny));
      posX = nx;
      posY = ny;
      layoutPreview();
    });
    function stopDrag() {
      if (!dragging) return;
      dragging = false;
      positionSelect.value = 'custom';
    }
    previewSig.addEventListener('pointerup', stopDrag);
    previewSig.addEventListener('pointercancel', stopDrag);

    // ---------- File handling ----------
    async function handleFile(file: File) {
      if (file.type !== 'application/pdf') {
        setStatus('This tool needs a PDF file.', true);
        return;
      }
      fileInfo.textContent = file.name;
      setStatus('Reading PDF…');
      try {
        const info = await getPdfPreviewInfo(file);
        currentFile = file;
        pageAspect = info.width / info.height;
        pagePreview.style.height = `${240 / pageAspect}px`;
        applyPreset(positionSelect.value);
        updateSignaturePreview();
        signPanel.classList.remove('hidden');
        setStatus(null);
      } catch {
        setStatus('This file could not be read as a PDF. It may be corrupted or password-protected.', true);
      }
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'true';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.dataset.dragging = 'false';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.dataset.dragging = 'false';
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });

    // ---------- Apply ----------
    applyButton.addEventListener('click', async () => {
      if (!currentFile || !hasSignature) return;
      const target = (document.querySelector<HTMLInputElement>('input[name="page-target"]:checked')?.value ??
        'all') as SignPageTarget;
      const sourceCanvas = mode === 'draw' ? sigCanvas : typePreviewCanvas;
      const signatureDataUrl = sourceCanvas.toDataURL('image/png');

      setStatus('Signing…');
      applyButton.disabled = true;
      try {
        const blob = await signPdf(currentFile, signatureDataUrl, {
          target,
          x: posX,
          y: posY,
          width: widthNorm(),
          height: heightNorm(),
        });
        setStatus(null);
        if (activeObjectUrl) URL.revokeObjectURL(activeObjectUrl);
        const url = URL.createObjectURL(blob);
        activeObjectUrl = url;
        downloadLink.href = url;
        downloadLink.download = currentFile.name.replace(/\.pdf$/i, '-signed.pdf');
        resultNote.textContent =
          target === 'all' ? 'Signature added to every page.' : target === 'first' ? 'Signature added to the first page.' : 'Signature added to the last page.';
        result.classList.remove('hidden');
        result.classList.remove('animate-pop-in');
        void result.offsetWidth;
        result.classList.add('animate-pop-in');
        dropzone.classList.add('hidden');
        signPanel.classList.add('hidden');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : 'Something went wrong.', true);
      } finally {
        applyButton.disabled = !hasSignature || !currentFile;
      }
    });

    resetButton.addEventListener('click', () => {
      currentFile = null;
      if (activeObjectUrl) {
        URL.revokeObjectURL(activeObjectUrl);
        activeObjectUrl = null;
      }
      ctx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
      typeCtx.clearRect(0, 0, typePreviewCanvas.width, typePreviewCanvas.height);
      typeInput.value = '';
      hasSignature = false;
      result.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInfo.textContent = '';
      fileInput.value = '';
      setStatus(null);
    });

    // Initialize
    setMode('draw');
    applyButton.disabled = true;
  </script>
</Layout>
