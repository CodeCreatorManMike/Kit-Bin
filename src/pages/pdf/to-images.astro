---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Convert PDF to Images Online — Free & No Upload Required | Kit-Bin"
  description="Convert every page of a PDF to a PNG image. Runs entirely in your browser — your file is never uploaded to a server."
>
  <ToolSchema
    name="Convert PDF to Images"
    description="Convert every page of a PDF to a PNG image. Runs entirely in your browser — your file is never uploaded to a server."
    faqs={[
    {
      "q": "What resolution are the images?",
      "a": "Pages render at 2x scale for sharp results, similar to a high-DPI screenshot."
    }
  ]}
  />

  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Convert PDF to Images — Free</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400"><a href="/guides/how-kit-bin-works" class="hover:underline decoration-dotted underline-offset-2">Processed entirely in your browser. Your file is never uploaded to a server.</a></p>
  </div>

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 dark:text-slate-300 space-y-4">
    <p>This tool renders every page of a PDF to a PNG image, delivered as a zip when there's more than one page.</p>
    <p>Drop your PDF above. The images download automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">What resolution are the images?</p>
      <p class="text-slate-600 dark:text-slate-400">Pages render at 2x scale for sharp results, similar to a high-DPI screenshot.</p>
    </div>
  </div>

  <script>
    import { pdfToImages } from '../../lib/pdf/toImages';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files) => {
        const { blob, filename } = await pdfToImages(files[0]);
        return { blob, filename };
      },
    });
  </script>
</Layout>
