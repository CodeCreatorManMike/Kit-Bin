---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Merge PDF Files Online — Free & No Upload Required | ToolKit"
  description="Combine multiple PDFs into one file in seconds. Runs entirely in your browser — your files are never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold">Merge PDF Files Online — Free</h1>
    <p class="mt-2 text-slate-600">Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="application/pdf" multiple dropLabel="Drop 2+ PDF files here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 space-y-4">
    <p>This tool merges multiple PDF files into a single PDF, in the order you select them.</p>
    <p>Drop your files above, then click a file to add more if needed. The merged PDF downloads automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Is my file uploaded anywhere?</p>
      <p class="text-slate-600">No. Merging happens entirely in your browser using WebAssembly — your PDFs never leave your device.</p>
    </div>
    <div>
      <p class="font-medium">Is there a file size or page limit?</p>
      <p class="text-slate-600">No hard limit, but very large PDFs (500MB+) may be slow depending on your device's memory.</p>
    </div>
    <div>
      <p class="font-medium">Does this work on mobile?</p>
      <p class="text-slate-600">Yes — merging runs the same way on mobile browsers as desktop.</p>
    </div>
  </div>

  <script>
    import { mergePdfs } from '../../lib/pdf/merge';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      multiple: true,
      validate: (files) => {
        if (files.length < 2) return 'Select at least 2 PDF files to merge.';
        if (files.some((f) => f.type !== 'application/pdf')) return 'This tool needs PDF files.';
        return null;
      },
      run: async (files) => {
        const blob = await mergePdfs(files);
        return { blob, filename: 'merged.pdf' };
      },
    });
  </script>
</Layout>
