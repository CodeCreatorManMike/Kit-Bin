---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is my file uploaded anywhere?',
    a: 'No. Merging happens entirely in your browser using WebAssembly. Your PDFs never leave your device.',
  },
  {
    q: 'Does merging reduce quality?',
    a: "No, pages are copied as-is into the new document, not re-rendered or re-encoded, so there's no quality loss from the merge itself.",
  },
  {
    q: 'Are bookmarks, forms, and annotations preserved?',
    a: "Form fields and annotations belong to the page and copy across with it. A document-level bookmark outline (the sidebar navigation some PDFs have) is not carried over. Each source file's outline is separate from its pages.",
  },
  {
    q: 'Can I merge scanned PDFs?',
    a: "Yes, a scanned PDF is just pages containing image content, which copies the same way as any other page.",
  },
  {
    q: 'Can I undo a merge?',
    a: "There's no in-tool undo, but nothing happens to your original files. They're never modified, only read. Re-run the tool with the files in a different order if you need to redo it.",
  },
  {
    q: 'Is there a file size or page limit?',
    a: "Kit-Bin does not impose an artificial upload limit, because files are not uploaded. Your practical limit depends on your browser, your device's memory, the file's structure, and the operation. Very large PDFs may be slow or run out of memory, especially on phones.",
  },
  {
    q: 'Does this work on mobile?',
    a: 'Yes, merging runs the same way on mobile browsers as desktop.',
  },
];
---

<Layout
  title="Merge PDF Online, Combine PDF Files Privately | Kit-Bin"
  description="Combine multiple PDFs into one file in seconds. Runs entirely in your browser. Your files are never uploaded to a server."
>
  <ToolSchema
    name="Merge PDF Files Online"
    description="Combine multiple PDFs into one file in seconds. Runs entirely in your browser. Your files are never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Merge PDF Files Online" />

  <ToolWidget accept="application/pdf" multiple dropLabel="Drop 2+ PDF files here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Combine multiple PDF files into one document, in the order you select them. Kit-Bin
      processes the files in your browser, so you can merge private documents, contracts,
      statements, scanned records, without uploading them anywhere.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg">What happens during a merge</h2>
      <p class="text-muted dark:text-slate-400">
        Each page is copied directly from its source file into a new document. The page content
        itself is never re-rendered or re-encoded, so there's no generation loss the way there
        would be with, say, printing to PDF and rescanning. Page order follows the order you
        select files in; drop files in the order you want them to appear.
      </p>
    </div>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Need to reorder or remove pages afterward? Try{' '}
      <a href="/pdf/reorder-pages/" class="text-primary dark:text-blue-400 hover:underline">Reorder PDF Pages</a>{' '}
      or <a href="/pdf/split/" class="text-primary dark:text-blue-400 hover:underline">Split PDF</a>,
      then <a href="/pdf/compress/" class="text-primary dark:text-blue-400 hover:underline">Compress PDF</a>{' '}
      if the combined file is large.
    </p>
    <p class="text-sm">
      Merging sensitive or confidential documents? Read{' '}
      <a href="/guides/merge-pdf-privately/" class="text-primary dark:text-blue-400 hover:underline">how to merge PDFs without uploading them</a>.
    </p>
  </div>

  <div class="pt-8 sm:pt-12 pb-6 sm:pb-8">
    <AdsterraBanner placement="tool-page:pdf/merge" />
  </div>

  <script>
    import { mergePdfs } from '../../lib/pdf/merge';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      multiple: true,
      validate: (files) => {
        if (files.length < 2) return 'Select at least 2 PDF files to merge.';
        if (files.some((f) => f.type !== 'application/pdf')) return 'This tool needs PDF files.';
        return null;
      },
      run: async (files, reportProgress) => {
        const blob = await mergePdfs(files, reportProgress);
        return { blob, filename: 'merged.pdf' };
      },
    });
  </script>
</Layout>
