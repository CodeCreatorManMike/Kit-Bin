---
import Layout from '../../layouts/Layout.astro';
import ToolWidget from '../../components/ToolWidget.astro';
---

<Layout
  title="Split PDF Files Online — Free & No Upload Required | ToolKit"
  description="Split a PDF into individual pages in seconds. Runs entirely in your browser — your file is never uploaded to a server."
>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-4 text-center">
    <h1 class="text-3xl font-bold">Split PDF Into Pages — Free</h1>
    <p class="mt-2 text-slate-600">🔒 Processed entirely in your browser. Your file is never uploaded to a server.</p>
  </div>

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <div class="max-w-2xl mx-auto px-4 py-12 text-slate-700 space-y-4">
    <p>This tool splits a PDF into one file per page, delivered as a zip when there's more than one page.</p>
    <p>Drop your PDF above. The split files download automatically once ready.</p>
    <h2 class="font-semibold text-lg pt-2">FAQ</h2>
    <div>
      <p class="font-medium">Is my file uploaded anywhere?</p>
      <p class="text-slate-600">No. Splitting happens entirely in your browser — your PDF never leaves your device.</p>
    </div>
    <div>
      <p class="font-medium">What do I get for a multi-page PDF?</p>
      <p class="text-slate-600">A zip file containing one single-page PDF per original page.</p>
    </div>
  </div>

  <script>
    import { splitPdf } from '../../lib/pdf/split';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files) => {
        const { blob, filename } = await splitPdf(files[0]);
        return { blob, filename };
      },
    });
  </script>
</Layout>
