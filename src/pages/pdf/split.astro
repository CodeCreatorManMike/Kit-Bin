---
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import ToolWidget from '../../components/ToolWidget.astro';
import AdUnit from '../../components/AdUnit.astro';

const faqs = [
  {
    q: 'Is my file uploaded anywhere?',
    a: 'No. Splitting happens entirely in your browser. Your PDF never leaves your device.',
  },
  {
    q: 'What do I get for a multi-page PDF?',
    a: 'A zip file containing one single-page PDF per original page, numbered in order.',
  },
  {
    q: 'Can I choose a page range instead of every page separately?',
    a: "Not with this tool. It always splits into one file per page. If you only need specific pages kept together (like removing a cover page), use Reorder PDF Pages instead, or split and re-merge the pages you want.",
  },
  {
    q: 'Does splitting reduce quality?',
    a: "No, each page is copied as-is into its own file, not re-rendered or re-encoded.",
  },
];
---

<Layout
  title="Split PDF Online, Extract PDF Pages | Kit-Bin"
  description="Split a PDF into individual pages in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
>
  <ToolSchema
    name="Split PDF Into Pages"
    description="Split a PDF into individual pages in seconds. Runs entirely in your browser. Your file is never uploaded to a server."
    faqs={faqs}
  />

  <ToolHeader title="Split a PDF into Separate Pages" />

  <ToolWidget accept="application/pdf" dropLabel="Drop a PDF file here or click to browse" />

  <AdUnit />

  <div class="max-w-2xl mx-auto px-4 py-12 text-ink dark:text-slate-300 space-y-6">
    <p>
      Drop a PDF above and every page becomes its own single-page PDF. A one-page source file
      downloads directly, more than one page downloads as a zip. This splits by page, not by a
      page range: if you need pages 1–3 kept together as one file, split first, then{' '}
      <a href="/pdf/merge" class="text-primary dark:text-blue-400 hover:underline">merge</a> the
      pages you want back into a single document.
    </p>

    <div>
      <h2 class="tool-h2 font-semibold text-lg pt-2">FAQ</h2>
      <div class="mt-3">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <p class="text-sm">
      Only want to remove or reorder pages, not split every page out? Try{' '}
      <a href="/pdf/reorder-pages" class="text-primary dark:text-blue-400 hover:underline">Reorder PDF Pages</a>.
    </p>
    <p class="text-sm">
      Not sure if split or extract is what you actually need? Read{' '}
      <a href="/guides/split-vs-extract-pdf" class="text-primary dark:text-blue-400 hover:underline">Split vs Extract PDF Pages</a>.
    </p>
  </div>

  <script>
    import { splitPdf } from '../../lib/pdf/split';
    import { getToolElements, wireTool } from '../../lib/ui';

    const els = getToolElements();
    wireTool(els, {
      accept: 'application/pdf',
      validate: (files) => (files[0]?.type !== 'application/pdf' ? 'This tool needs a PDF file.' : null),
      run: async (files, reportProgress) => {
        const { blob, filename } = await splitPdf(files[0], reportProgress);
        return { blob, filename };
      },
    });
  </script>
</Layout>
