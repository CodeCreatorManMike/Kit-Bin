{
  // Deploys Kit-Bin's plain `astro build` output (dist/) as a Cloudflare
  // Worker that serves static assets directly. No Astro adapter, no SSR
  // runtime, no bindings: this site is 100% client-side by design (see
  // docs/ARCHITECTURE.md), so there is nothing here for `@astrojs/cloudflare`
  // to adapt.
  //
  // The dashboard's "Build command" is set to None, so nothing else runs
  // `npm run build` before `npx wrangler deploy`. The `build.command` below
  // makes wrangler itself run it first, every time, regardless of dashboard
  // settings, so this doesn't silently break again if that setting changes.
  "name": "toolkit",
  "compatibility_date": "2026-08-07",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // Explicit, not just relying on the (matching) default: every tool/guide
    // page builds as a folder + index.html, so a request without the
    // trailing slash 307-redirects to the canonical trailing-slash URL.
    // This is what keeps Google indexing one URL per page instead of two —
    // see docs/SEO.md and the Aug 2026 GSC audit that flagged the split.
    "html_handling": "auto-trailing-slash"
  }
}
