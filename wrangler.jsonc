{
  // Deploys Kit-Bin's plain `astro build` output (dist/) as a Cloudflare
  // Worker that serves static assets directly. No Astro adapter, no SSR
  // runtime, no bindings: this site is 100% client-side by design (see
  // docs/ARCHITECTURE.md), so there is nothing here for `@astrojs/cloudflare`
  // to adapt. Deploy command stays `npx wrangler deploy`; it just uploads
  // whatever `npm run build` already produced in dist/.
  "name": "toolkit",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist"
  }
}
